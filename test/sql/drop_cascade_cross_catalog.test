statement ok
PRAGMA refresh('tx_local');

query I
SELECT count(*) FROM ((SELECT * FROM tx_parent EXCEPT ALL SELECT k, v FROM tx_src) UNION ALL (SELECT k, v FROM tx_src EXCEPT ALL SELECT * FROM tx_parent));
----
