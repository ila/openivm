CREATE TABLE tb_src(k INTEGER, v INTEGER);

statement ok
INSERT INTO tb_src VALUES (1,10),(2,20),(2,20);

statement ok
CREATE MATERIALIZED VIEW tb_parent AS SELECT k, v FROM tb_src;

statement ok
CREATE MATERIALIZED VIEW peer.main.tb_child AS SELECT k, v FROM memory.main.tb_parent;

statement ok
