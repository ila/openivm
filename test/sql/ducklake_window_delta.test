# name: test/sql/ducklake_window_delta.test
# description: DuckLake window refresh should preserve unchanged partition rows
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake;

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_window_delta.db' AS dl (TYPE ducklake);

statement ok
SET openivm_cascade_refresh = 'off';

statement ok
CREATE TABLE dl.market(symbol VARCHAR, d INT, price INT);

statement ok
CREATE TABLE dl.security(symbol VARCHAR, sector VARCHAR);

statement ok
INSERT INTO dl.market VALUES
  ('A', 1, 10), ('A', 2, 20), ('A', 3, 30),
  ('B', 1, 11), ('B', 2, 21), ('B', 3, 31);

statement ok
INSERT INTO dl.security VALUES ('A', 'tech'), ('B', 'bank');

statement ok
CREATE MATERIALIZED VIEW dl.mv_market AS
SELECT
  symbol,
  d,
  price,
  max(price) OVER (
    PARTITION BY symbol
    ORDER BY d
    ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
  ) AS roll_max
FROM dl.market;

statement ok
CREATE MATERIALIZED VIEW dl.mv_market_join AS
SELECT m.symbol, m.d, m.roll_max, s.sector
FROM dl.mv_market m
JOIN dl.security s USING (symbol);

statement ok
INSERT INTO dl.market VALUES ('A', 4, 25);

statement ok
PRAGMA refresh('mv_market');

query I
SELECT count(*) FROM (
  SELECT symbol, d, price,
         max(price) OVER (
           PARTITION BY symbol
           ORDER BY d
           ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
         ) AS roll_max
  FROM dl.market
  EXCEPT ALL
  SELECT symbol, d, price, roll_max FROM dl.mv_market
);
----
0

query I
SELECT count(*) FROM (
  SELECT symbol, d, price, roll_max FROM dl.mv_market
  EXCEPT ALL
  SELECT symbol, d, price,
         max(price) OVER (
           PARTITION BY symbol
           ORDER BY d
           ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
         ) AS roll_max
  FROM dl.market
);
----
0

statement ok
PRAGMA refresh('mv_market_join');

query I
SELECT count(*) FROM (
  SELECT symbol, d, roll_max, sector FROM dl.mv_market_join
  EXCEPT ALL
  SELECT m.symbol, m.d, m.roll_max, s.sector
  FROM dl.mv_market m
  JOIN dl.security s USING (symbol)
);
----
0

query I
SELECT count(*) FROM (
  SELECT m.symbol, m.d, m.roll_max, s.sector
  FROM dl.mv_market m
  JOIN dl.security s USING (symbol)
  EXCEPT ALL
  SELECT symbol, d, roll_max, sector FROM dl.mv_market_join
);
----
0


# Publication must retain old keys for removed rows, NULL keys, and moved rows.
statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
CREATE TABLE dl.scope_market(symbol VARCHAR, d INT, price INT);

statement ok
INSERT INTO dl.scope_market VALUES ('A',1,10),('A',1,10),('A',2,20),('B',1,30),(NULL,NULL,40),(NULL,2,50);

statement ok
CREATE MATERIALIZED VIEW dl.scope_window AS
SELECT *, max(price) OVER (PARTITION BY symbol ORDER BY d RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_max FROM dl.scope_market;

statement ok
CREATE VIEW dl.scope_expected AS
SELECT *, max(price) OVER (PARTITION BY symbol ORDER BY d RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_max FROM dl.scope_market;

statement ok
CREATE MATERIALIZED VIEW dl.scope_child AS SELECT * FROM dl.scope_window;

statement ok
INSERT INTO dl.scope_market VALUES ('A',1,10),('C',3,60);

statement ok
DELETE FROM dl.scope_market WHERE symbol IS NULL AND d IS NULL;

statement ok
UPDATE dl.scope_market SET symbol='C',d=4 WHERE symbol='B';

statement ok
PRAGMA refresh('scope_window');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.scope_window EXCEPT ALL SELECT * FROM dl.scope_expected)),
       (SELECT count(*) FROM (SELECT * FROM dl.scope_expected EXCEPT ALL SELECT * FROM dl.scope_window));
----
0	0

statement ok
INSERT INTO dl.scope_market VALUES (NULL,NULL,15),('A',2,20);

statement ok
DELETE FROM dl.scope_market WHERE symbol='C';

statement ok
UPDATE dl.scope_market SET d=NULL,price=5 WHERE symbol='A' AND d=1;

statement ok
PRAGMA refresh('scope_window');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.scope_window EXCEPT ALL SELECT * FROM dl.scope_expected)),
       (SELECT count(*) FROM (SELECT * FROM dl.scope_expected EXCEPT ALL SELECT * FROM dl.scope_window));
----
0	0

# A lagging child must consume both preceding refreshes.

statement ok
PRAGMA refresh('scope_child');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.scope_child EXCEPT ALL SELECT * FROM dl.scope_expected)),
       (SELECT count(*) FROM (SELECT * FROM dl.scope_expected EXCEPT ALL SELECT * FROM dl.scope_child));
----
0	0

statement ok
DELETE FROM dl.scope_market;

statement ok
PRAGMA refresh('scope_window');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.scope_window EXCEPT ALL SELECT * FROM dl.scope_expected)),
       (SELECT count(*) FROM (SELECT * FROM dl.scope_expected EXCEPT ALL SELECT * FROM dl.scope_window));
----
0	0

# Deleting the final partition must also reach the child.
statement ok
PRAGMA refresh('scope_child');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.scope_child EXCEPT ALL SELECT * FROM dl.scope_expected)),
       (SELECT count(*) FROM (SELECT * FROM dl.scope_expected EXCEPT ALL SELECT * FROM dl.scope_child));
----
0	0

query I
SELECT contains(content, 'COALESCE(symbol, openivm_old_key_0)')
   AND contains(content, 'FROM openivm_window_changed_scope_window) d WHERE')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_scope_window.sql');
----
1
