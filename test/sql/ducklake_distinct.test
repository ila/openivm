# name: test/sql/ducklake_distinct.test
# description: Test IVM with SELECT DISTINCT on DuckLake base tables
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake FROM '{BUILD_DIRECTORY}/repository';

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_distinct.db' AS dl (TYPE ducklake);

# ==========================================
# Basic DISTINCT
# ==========================================

statement ok
CREATE TABLE dl.tags (id INTEGER, tag VARCHAR);

statement ok
INSERT INTO dl.tags VALUES (1, 'red'), (2, 'blue'), (3, 'red'), (4, 'green');

statement ok
CREATE MATERIALIZED VIEW dl.mv_tags AS SELECT DISTINCT tag FROM dl.tags;

query I rowsort
SELECT * FROM dl.mv_tags ORDER BY tag;
----
blue
green
red

# Insert duplicate — should not change MV
statement ok
INSERT INTO dl.tags VALUES (5, 'red');

statement ok
PRAGMA refresh('mv_tags');

query I rowsort
SELECT * FROM dl.mv_tags ORDER BY tag;
----
blue
green
red

# Insert new distinct value
statement ok
INSERT INTO dl.tags VALUES (6, 'yellow');

statement ok
PRAGMA refresh('mv_tags');

query I rowsort
SELECT * FROM dl.mv_tags ORDER BY tag;
----
blue
green
red
yellow

# EXCEPT ALL
query I
SELECT count(*) FROM (SELECT DISTINCT tag FROM dl.tags EXCEPT ALL SELECT tag FROM dl.mv_tags);
----
0

query I
SELECT count(*) FROM (SELECT tag FROM dl.mv_tags EXCEPT ALL SELECT DISTINCT tag FROM dl.tags);
----
0

# Regression: a pushed-down filter can keep a physical scan column that is not
# part of the join's projected output. The DuckLake change scan must preserve
# projection_ids so output columns retain their logical positions.
statement ok
CREATE TABLE dl.filtered_join_left (id INTEGER, label VARCHAR);

statement ok
CREATE TABLE dl.filtered_join_right (id INTEGER, filter_value INTEGER, out_a INTEGER, out_b INTEGER);

statement ok
INSERT INTO dl.filtered_join_left VALUES (1, 'one'), (2, 'two'), (3, 'three');

statement ok
INSERT INTO dl.filtered_join_right VALUES (1, 60, 1, 1), (3, 70, 3, 3);

statement ok
CREATE MATERIALIZED VIEW dl.filtered_join_distinct AS
SELECT DISTINCT r.out_a, r.out_b, l.label
FROM dl.filtered_join_left l
JOIN dl.filtered_join_right r ON l.id = r.id
WHERE r.filter_value > 50;

query I
SELECT type FROM openivm_views WHERE view_sql_name = 'filtered_join_distinct';
----
0

# One refresh sees conflicting INSERT + UPDATE + DELETE changes.
statement ok
INSERT INTO dl.filtered_join_right VALUES (2, 777, 1, 4);

statement ok
UPDATE dl.filtered_join_right SET filter_value = 80, out_a = 9 WHERE id = 1;

statement ok
DELETE FROM dl.filtered_join_right WHERE id = 3;

statement ok
PRAGMA refresh('filtered_join_distinct');

query I
SELECT count(*) FROM (
    SELECT * FROM dl.filtered_join_distinct
    EXCEPT ALL
    SELECT DISTINCT r.out_a, r.out_b, l.label
    FROM dl.filtered_join_left l
    JOIN dl.filtered_join_right r ON l.id = r.id
    WHERE r.filter_value > 50
);
----
0

query I
SELECT count(*) FROM (
    SELECT DISTINCT r.out_a, r.out_b, l.label
    FROM dl.filtered_join_left l
    JOIN dl.filtered_join_right r ON l.id = r.id
    WHERE r.filter_value > 50
    EXCEPT ALL
    SELECT * FROM dl.filtered_join_distinct
);
----
0

# ==========================================
# Stress: batch INSERT + DELETE
# ==========================================

# Delete all 'red' entries, insert 'purple', add another 'blue'
statement ok
DELETE FROM dl.tags WHERE tag = 'red';

statement ok
INSERT INTO dl.tags VALUES (7, 'purple');

statement ok
INSERT INTO dl.tags VALUES (8, 'blue');

statement ok
PRAGMA refresh('mv_tags');

# EXCEPT ALL
query I
SELECT count(*) FROM (SELECT DISTINCT tag FROM dl.tags EXCEPT ALL SELECT tag FROM dl.mv_tags);
----
0

query I
SELECT count(*) FROM (SELECT tag FROM dl.mv_tags EXCEPT ALL SELECT DISTINCT tag FROM dl.tags);
----
0
