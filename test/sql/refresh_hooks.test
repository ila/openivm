# name: test/sql/refresh_hooks.test
# description: Test refresh hooks (custom SQL on MV refresh)
# group: [sql]

require openivm

# ============================================================
# Setup
# ============================================================

statement ok
CREATE TABLE t (id INT, val INT);

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT SUM(val) AS total FROM t;

statement ok
INSERT INTO t VALUES (1, 100);

statement ok
PRAGMA refresh('mv');

query I
SELECT total FROM mv;
----
100

# ============================================================
# Test 1: After-hook (runs after IVM refresh)
# ============================================================

# Create a log table to verify hooks run
statement ok
CREATE TABLE hook_log (msg VARCHAR);

statement ok
INSERT INTO openivm_refresh_hooks VALUES ('mv', 'INSERT INTO hook_log VALUES(''after-hook ran'')', 'after');

statement ok
INSERT INTO t VALUES (2, 200);

statement ok
PRAGMA refresh('mv');

# MV should be updated
query I
SELECT total FROM mv;
----
300

# Hook should have run
query I
SELECT msg FROM hook_log;
----
after-hook ran

# ============================================================
# Test 2: Before-hook
# ============================================================

statement ok
DELETE FROM hook_log;

statement ok
UPDATE openivm_refresh_hooks SET hook_sql = 'INSERT INTO hook_log VALUES(''before-hook ran'')', mode = 'before' WHERE view_name = 'mv';

statement ok
INSERT INTO t VALUES (3, 300);

statement ok
PRAGMA refresh('mv');

# MV updated (IVM still runs)
query I
SELECT total FROM mv;
----
600

# Hook ran
query I
SELECT msg FROM hook_log;
----
before-hook ran

# ============================================================
# Test 3: Replace-hook (runs INSTEAD of IVM)
# ============================================================

statement ok
DELETE FROM hook_log;

statement ok
UPDATE openivm_refresh_hooks SET hook_sql = 'INSERT INTO hook_log VALUES(''replace-hook ran'')', mode = 'replace' WHERE view_name = 'mv';

statement ok
INSERT INTO t VALUES (4, 400);

statement ok
PRAGMA refresh('mv');

# MV should NOT be updated (IVM was replaced)
query I
SELECT total FROM mv;
----
600

# Hook ran instead
query I
SELECT msg FROM hook_log;
----
replace-hook ran

# ============================================================
# Test 4: No hook (default behavior)
# ============================================================

statement ok
DELETE FROM openivm_refresh_hooks WHERE view_name = 'mv';

statement ok
DELETE FROM hook_log;

statement ok
PRAGMA refresh('mv');

# MV should now be updated (hook removed, IVM runs normally)
query I
SELECT total FROM mv;
----
1000

# No hook logged
query I
SELECT COUNT(*) FROM hook_log;
----
0

# ============================================================
# Test 5: An empty hook-bearing node does not stop its cascade
# ============================================================

statement ok
SET openivm_cascade_refresh = 'downstream';

statement ok
CREATE TABLE hook_cascade_root_src (id INT, amount INT);

statement ok
CREATE TABLE hook_cascade_side_src (id INT, bonus INT);

statement ok
INSERT INTO hook_cascade_root_src VALUES (1, 10), (2, 20), (3, 30);

statement ok
INSERT INTO hook_cascade_side_src VALUES (1, 1), (2, 2);

statement ok
CREATE MATERIALIZED VIEW hook_cascade_parent AS
    SELECT id, SUM(amount) AS total
    FROM hook_cascade_root_src
    GROUP BY id;

statement ok
CREATE MATERIALIZED VIEW hook_cascade_child AS
    SELECT p.id, SUM(p.total + s.bonus) AS score, COUNT(*) AS cnt
    FROM hook_cascade_parent p
    JOIN hook_cascade_side_src s USING (id)
    GROUP BY p.id;

statement ok
INSERT INTO openivm_refresh_hooks VALUES (
    'hook_cascade_parent',
    'INSERT INTO hook_log VALUES(''empty-parent hook ran'')',
    'before'
);

# Only the child's independent source changes. The parent's pre-hook empty
# semantics still skip its hook, but traversal must refresh the child.
statement ok
INSERT INTO hook_cascade_side_src VALUES (3, 3), (4, 4);

statement ok
UPDATE hook_cascade_side_src SET bonus = bonus + 10 WHERE id IN (1, 3);

statement ok
DELETE FROM hook_cascade_side_src WHERE id IN (2, 4);

statement ok
PRAGMA refresh('hook_cascade_parent');

query I
SELECT COUNT(*) FROM (
    SELECT id, SUM(amount) AS total
    FROM hook_cascade_root_src
    GROUP BY id
    EXCEPT ALL
    SELECT id, total FROM hook_cascade_parent
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, total FROM hook_cascade_parent
    EXCEPT ALL
    SELECT id, SUM(amount) AS total
    FROM hook_cascade_root_src
    GROUP BY id
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT p.id, SUM(p.total + s.bonus) AS score, COUNT(*) AS cnt
    FROM (
        SELECT id, SUM(amount) AS total
        FROM hook_cascade_root_src
        GROUP BY id
    ) p
    JOIN hook_cascade_side_src s USING (id)
    GROUP BY p.id
    EXCEPT ALL
    SELECT id, score, cnt FROM hook_cascade_child
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, score, cnt FROM hook_cascade_child
    EXCEPT ALL
    SELECT p.id, SUM(p.total + s.bonus) AS score, COUNT(*) AS cnt
    FROM (
        SELECT id, SUM(amount) AS total
        FROM hook_cascade_root_src
        GROUP BY id
    ) p
    JOIN hook_cascade_side_src s USING (id)
    GROUP BY p.id
);
----
0

query I
SELECT COUNT(*) FROM hook_log;
----
0
