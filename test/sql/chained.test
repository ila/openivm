# name: test/sql/chained.test
# description: Test chained materialized view IVM (table -> MV1 -> MV2 -> ...)
# group: [sql]

require openivm

# Explicit ordering — tests manage refresh order manually
statement ok
SET openivm_cascade_refresh = 'off';

# ============================================================
# Two-level chain: table -> MV1 -> MV2
# ============================================================

statement ok
CREATE TABLE sales (region VARCHAR, product VARCHAR, amount INTEGER);

statement ok
CREATE MATERIALIZED VIEW sales_by_region AS
    SELECT region, SUM(amount) AS total FROM sales GROUP BY region;

statement ok
CREATE MATERIALIZED VIEW grand_total AS
    SELECT SUM(total) AS grand_total FROM sales_by_region;

statement ok
INSERT INTO sales VALUES ('US', 'A', 100), ('US', 'B', 200), ('EU', 'A', 300);

statement ok
pragma refresh('sales_by_region');

statement ok
pragma refresh('grand_total');

query II
SELECT region, total FROM sales_by_region ORDER BY region;
----
EU	300
US	300

query I
SELECT grand_total FROM grand_total;
----
600

# Cross-check
query I
SELECT SUM(total) FROM (SELECT region, SUM(amount) AS total FROM sales GROUP BY region);
----
600

# Second batch of inserts
statement ok
INSERT INTO sales VALUES ('EU', 'B', 400), ('US', 'C', 500);

statement ok
pragma refresh('sales_by_region');

statement ok
pragma refresh('grand_total');

query II
SELECT region, total FROM sales_by_region ORDER BY region;
----
EU	700
US	800

query I
SELECT grand_total FROM grand_total;
----
1500

query I
SELECT SUM(total) FROM (SELECT region, SUM(amount) AS total FROM sales GROUP BY region);
----
1500

# Downstream delta compaction: a tiny upstream projection change should not
# produce a full old/new MV snapshot for dependent views.
statement ok
CREATE TABLE compact_src (id INT, k INT, v INT);

statement ok
CREATE TABLE compact_dim (k INT, label VARCHAR);

statement ok
INSERT INTO compact_src VALUES (1, 10, 100), (2, 20, 200), (3, 30, 300);

statement ok
INSERT INTO compact_dim VALUES (10, 'a'), (20, 'b'), (30, 'c'), (40, 'd');

statement ok
CREATE MATERIALIZED VIEW compact_proj AS
    SELECT id, k, v FROM compact_src;

statement ok
CREATE MATERIALIZED VIEW compact_join AS
    SELECT p.id, p.k, d.label
    FROM compact_proj p
    JOIN compact_dim d USING (k);

statement ok
INSERT INTO compact_src VALUES (4, 40, 400);

statement ok
PRAGMA refresh('compact_proj');

query I
SELECT COUNT(*) FROM openivm_delta_openivm_visible_compact_proj;
----
1

statement ok
PRAGMA refresh('compact_join');

query III
SELECT id, k, label FROM compact_join ORDER BY id;
----
1	10	a
2	20	b
3	30	c
4	40	d

# Canceling source deltas should leave no pending upstream delta for downstream.
statement ok
CREATE TABLE compact_cancel_src (id INT, k INT, v INT);

statement ok
CREATE TABLE compact_cancel_dim (k INT, label VARCHAR);

statement ok
INSERT INTO compact_cancel_src VALUES (1, 10, 100), (2, 20, 200);

statement ok
INSERT INTO compact_cancel_dim VALUES (10, 'a'), (20, 'b'), (30, 'c');

statement ok
CREATE MATERIALIZED VIEW compact_cancel_proj AS
    SELECT id, k, v FROM compact_cancel_src;

statement ok
CREATE MATERIALIZED VIEW compact_cancel_join AS
    SELECT p.id, p.k, d.label
    FROM compact_cancel_proj p
    JOIN compact_cancel_dim d USING (k);

statement ok
INSERT INTO compact_cancel_src VALUES (3, 30, 300);

statement ok
DELETE FROM compact_cancel_src WHERE id = 3;

statement ok
PRAGMA refresh('compact_cancel_proj');

query I
SELECT COUNT(*) FROM openivm_delta_openivm_visible_compact_cancel_proj;
----
0

statement ok
PRAGMA refresh('compact_cancel_join');

query III
SELECT id, k, label FROM compact_cancel_join ORDER BY id;
----
1	10	a
2	20	b

# Downstream projection over an aggregate MV must receive row-replacement
# deltas (-old/+new), not additive aggregate deltas.
statement ok
CREATE TABLE agg_proj_sales (id INT, region VARCHAR, amount INT);

statement ok
INSERT INTO agg_proj_sales VALUES (1, 'east', 10), (2, 'east', 20), (3, 'west', 5);

statement ok
CREATE MATERIALIZED VIEW agg_proj_region AS
    SELECT region, SUM(amount) AS total, COUNT(*) AS cnt
    FROM agg_proj_sales GROUP BY region;

statement ok
CREATE MATERIALIZED VIEW agg_proj_top AS
    SELECT region, total, cnt FROM agg_proj_region WHERE total > 0;

statement ok
INSERT INTO agg_proj_sales VALUES (4, 'east', 7), (5, 'west', 8), (6, 'north', 9);

statement ok
PRAGMA refresh('agg_proj_region');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_region
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_region
);
----
0

statement ok
PRAGMA refresh('agg_proj_top');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_top
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_top
);
----
0

statement ok
UPDATE agg_proj_sales SET amount = amount + 3 WHERE id IN (1, 4);

statement ok
DELETE FROM agg_proj_sales WHERE id = 5;

statement ok
INSERT INTO agg_proj_sales VALUES (7, 'west', 11), (8, 'south', 4);

statement ok
PRAGMA refresh('agg_proj_region');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_region
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_region
);
----
0

statement ok
PRAGMA refresh('agg_proj_top');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_top
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_top
);
----
0

statement ok
DELETE FROM agg_proj_sales WHERE region = 'north';

statement ok
PRAGMA refresh('agg_proj_region');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_region
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_region
);
----
0

statement ok
PRAGMA refresh('agg_proj_top');

query I
SELECT COUNT(*) FROM (
    SELECT region, total, cnt FROM agg_proj_top
    EXCEPT ALL
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT region, SUM(amount), COUNT(*) FROM agg_proj_sales GROUP BY region HAVING SUM(amount) > 0
    EXCEPT ALL
    SELECT region, total, cnt FROM agg_proj_top
);
----
0

# Downstream cascade over a diamond must refresh both fanout branches before
# the final fan-in MV.
statement ok
SET openivm_cascade_refresh = 'downstream';

statement ok
CREATE TABLE diamond_fact(region INT, product INT, amount INT);

statement ok
INSERT INTO diamond_fact VALUES (1, 1, 10), (1, 2, 20), (2, 1, 5);

statement ok
CREATE MATERIALIZED VIEW diamond_group AS
    SELECT region, product, SUM(amount) AS total, COUNT(*) AS cnt
    FROM diamond_fact GROUP BY region, product;

statement ok
CREATE MATERIALIZED VIEW diamond_a AS
    SELECT region, SUM(total) AS total FROM diamond_group GROUP BY region;

statement ok
CREATE MATERIALIZED VIEW diamond_b AS
    SELECT region, SUM(cnt) AS cnt FROM diamond_group GROUP BY region;

statement ok
CREATE MATERIALIZED VIEW diamond_final AS
    SELECT a.region, a.total, b.cnt
    FROM diamond_a a JOIN diamond_b b ON a.region = b.region;

statement ok
INSERT INTO diamond_fact VALUES (1, 3, 7), (2, 2, 11);

statement ok
PRAGMA refresh('diamond_group');

query I
WITH diffs(n) AS (
    SELECT COUNT(*) FROM (
        SELECT region, product, total, cnt FROM diamond_group
        EXCEPT ALL
        SELECT region, product, SUM(amount), COUNT(*) FROM diamond_fact GROUP BY region, product)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, product, SUM(amount), COUNT(*) FROM diamond_fact GROUP BY region, product
        EXCEPT ALL
        SELECT region, product, total, cnt FROM diamond_group)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, total FROM diamond_a
        EXCEPT ALL
        SELECT region, SUM(amount) FROM diamond_fact GROUP BY region)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, SUM(amount) FROM diamond_fact GROUP BY region
        EXCEPT ALL
        SELECT region, total FROM diamond_a)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, cnt FROM diamond_b
        EXCEPT ALL
        SELECT region, COUNT(*) FROM diamond_fact GROUP BY region)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, COUNT(*) FROM diamond_fact GROUP BY region
        EXCEPT ALL
        SELECT region, cnt FROM diamond_b)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, total, cnt FROM diamond_final
        EXCEPT ALL
        SELECT region, SUM(amount), COUNT(*) FROM diamond_fact GROUP BY region)
    UNION ALL SELECT COUNT(*) FROM (
        SELECT region, SUM(amount), COUNT(*) FROM diamond_fact GROUP BY region
        EXCEPT ALL
        SELECT region, total, cnt FROM diamond_final)
)
SELECT SUM(n) FROM diffs;
----
0

statement ok
SET openivm_cascade_refresh = 'off';

# ============================================================
# Three-level chain: table -> MV1 -> MV2 -> MV3
# ============================================================

statement ok
CREATE TABLE orders (customer VARCHAR, category VARCHAR, qty INTEGER);

statement ok
CREATE MATERIALIZED VIEW orders_by_customer AS
    SELECT customer, SUM(qty) AS total_qty FROM orders GROUP BY customer;

statement ok
CREATE MATERIALIZED VIEW orders_by_category AS
    SELECT category, SUM(qty) AS total_qty FROM orders GROUP BY category;

# SUM-based chain MV
statement ok
CREATE MATERIALIZED VIEW total_orders AS
    SELECT SUM(total_qty) AS all_orders FROM orders_by_customer;

# COUNT-based chain MV (uses virtual column fix in ivm_helpers.cpp)
statement ok
CREATE MATERIALIZED VIEW customer_count AS
    SELECT COUNT(*) AS num_customers FROM orders_by_customer;

statement ok
INSERT INTO orders VALUES ('alice', 'books', 3), ('bob', 'books', 5), ('alice', 'games', 2), ('charlie', 'books', 1);

statement ok
pragma refresh('orders_by_customer');

statement ok
pragma refresh('orders_by_category');

statement ok
pragma refresh('customer_count');

query II
SELECT customer, total_qty FROM orders_by_customer ORDER BY customer;
----
alice	5
bob	5
charlie	1

query II
SELECT category, total_qty FROM orders_by_category ORDER BY category;
----
books	9
games	2

query I
SELECT num_customers FROM customer_count;
----
3

# Cross-check all three levels
query I
SELECT COUNT(*) FROM (SELECT customer, SUM(qty) FROM orders GROUP BY customer);
----
3

# Add more data and propagate through the full chain
statement ok
INSERT INTO orders VALUES ('dave', 'games', 7), ('alice', 'books', 4);

statement ok
pragma refresh('orders_by_customer');

statement ok
pragma refresh('orders_by_category');

statement ok
pragma refresh('customer_count');

query II
SELECT customer, total_qty FROM orders_by_customer ORDER BY customer;
----
alice	9
bob	5
charlie	1
dave	7

query I
SELECT num_customers FROM customer_count;
----
4

# Cross-check
query I
SELECT COUNT(*) FROM (SELECT customer, SUM(qty) FROM orders GROUP BY customer);
----
4

