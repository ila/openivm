# Mark-style diamond: all sources change before one run with overlapping targets.
statement ok
SET openivm_cascade_refresh='both';

statement ok
CREATE TABLE mark_edges(k INT,v INT);

statement ok
INSERT INTO mark_edges VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE TABLE mark_dims(k INT,v INT);

statement ok
INSERT INTO mark_dims VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE TABLE mark_blocked(k INT,v INT);

statement ok
INSERT INTO mark_blocked VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE MATERIALIZED VIEW mark_p AS SELECT e.k,e.v,d.v AS dv FROM mark_edges e LEFT JOIN mark_dims d ON e.k=d.k;

statement ok
CREATE VIEW mark_expected_p AS SELECT e.k,e.v,d.v AS dv FROM mark_edges e LEFT JOIN mark_dims d ON e.k=d.k;

statement ok
CREATE MATERIALIZED VIEW mark_q AS SELECT k,SUM(v) AS sv,COUNT(*) AS n FROM mark_dims GROUP BY k HAVING SUM(v)>0;

statement ok
CREATE VIEW mark_expected_q AS SELECT k,SUM(v) AS sv,COUNT(*) AS n FROM mark_dims GROUP BY k HAVING SUM(v)>0;

statement ok
CREATE MATERIALIZED VIEW mark_a AS SELECT mark_p.* FROM mark_p mark_p ANTI JOIN mark_blocked b ON mark_p.k=b.k;

statement ok
CREATE VIEW mark_expected_a AS SELECT mark_p.* FROM mark_expected_p mark_p ANTI JOIN mark_blocked b ON mark_p.k=b.k;

statement ok
CREATE MATERIALIZED VIEW mark_z AS SELECT mark_p.k,mark_p.v,mark_p.dv,mark_q.sv,mark_q.n FROM mark_p mark_p LEFT JOIN mark_q mark_q ON mark_p.k=mark_q.k;

statement ok
CREATE VIEW mark_expected_z AS SELECT mark_p.k,mark_p.v,mark_p.dv,mark_q.sv,mark_q.n FROM mark_expected_p mark_p LEFT JOIN mark_expected_q mark_q ON mark_p.k=mark_q.k;

statement ok
CREATE MATERIALIZED VIEW mark_cube AS SELECT k,SUM(v) AS v,COUNT(*) AS n FROM mark_z GROUP BY k;

statement ok
CREATE VIEW mark_expected_cube AS SELECT k,SUM(v) AS v,COUNT(*) AS n FROM mark_expected_z GROUP BY k;

statement ok
CREATE MATERIALIZED VIEW mark_top AS SELECT k,v,n FROM mark_cube ORDER BY v DESC NULLS LAST,k NULLS LAST LIMIT 3;

statement ok
CREATE VIEW mark_expected_top AS SELECT k,v,n FROM mark_expected_cube ORDER BY v DESC NULLS LAST,k NULLS LAST LIMIT 3;

statement ok
CREATE MATERIALIZED VIEW mark_leaf AS SELECT * FROM mark_top;

statement ok
CREATE VIEW mark_expected_leaf AS SELECT * FROM mark_expected_top;

statement ok
