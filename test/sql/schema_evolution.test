# ==========================================
# Test 15: failed rename restores exact metadata
# ==========================================

statement ok
CREATE TABLE se_failed_rename_src (id INTEGER, old_col INTEGER, new_col INTEGER);

statement ok
INSERT INTO se_failed_rename_src VALUES (1, 10, 100), (2, 20, 200);

statement ok
CREATE MATERIALIZED VIEW se_failed_rename_mv AS
SELECT id, old_col AS old_value, new_col AS new_value
FROM se_failed_rename_src;

statement error
ALTER TABLE se_failed_rename_src RENAME COLUMN old_col TO new_col;
----
already exists

# Batch conflicting changes before one refresh. A lossy new_col -> old_col
# rollback rewrite makes the two projected values equal and fails bag equality.
statement ok
INSERT INTO se_failed_rename_src VALUES (3, 30, 300), (4, 40, 400);

statement ok
UPDATE se_failed_rename_src
SET old_col = old_col + 1, new_col = new_col + 2
WHERE id IN (1, 3);

statement ok
DELETE FROM se_failed_rename_src WHERE id IN (2, 4);

statement ok
PRAGMA refresh('se_failed_rename_mv');

query I
SELECT count(*) FROM (
    SELECT * FROM se_failed_rename_mv
    EXCEPT ALL
    SELECT id, old_col AS old_value, new_col AS new_value
    FROM se_failed_rename_src
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, old_col AS old_value, new_col AS new_value
    FROM se_failed_rename_src
    EXCEPT ALL
    SELECT * FROM se_failed_rename_mv
);
----
0

# Same-named physical sources must retain distinct delta identities.
statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE SCHEMA source_a;

statement ok
CREATE SCHEMA source_b;

statement ok
CREATE TABLE source_a.items(id INTEGER, v INTEGER);

statement ok
CREATE TABLE source_b.items(id INTEGER, v INTEGER);

statement ok
INSERT INTO source_a.items VALUES (1,10),(2,20),(3,30),(3,30), (NULL,40),(5,NULL);

statement ok
INSERT INTO source_b.items VALUES (1,100),(2,200),(3,300),(3,300), (NULL,40),(5,NULL);

statement ok
CREATE MATERIALIZED VIEW source_join AS SELECT a.id, a.v av, b.v bv FROM source_a.items a JOIN source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW source_copy AS SELECT * FROM source_a.items;

statement ok
CREATE MATERIALIZED VIEW source_self AS SELECT a.id, a.v av, x.v xv, b.v bv FROM source_a.items a JOIN source_a.items x USING(id) JOIN source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW source_left AS SELECT a.id, a.v av, b.v bv FROM source_a.items a LEFT JOIN source_b.items b USING(id);

statement ok
