# name: test/sql/metadata.test
# description: Test that IVM metadata is correctly created and cleaned up
# group: [sql]

require openivm

load __TEST_DIR__/openivm_metadata_test.db

statement ok
SET openivm_files_path='__TEST_DIR__';

# ==========================================
# Setup: Create base tables and materialized views
# ==========================================

statement ok
CREATE TABLE t1 (id INT, grp VARCHAR, val INT);

statement ok
INSERT INTO t1 VALUES (1, 'a', 10), (2, 'b', 20);

statement ok
CREATE TABLE t2 (id INT, name VARCHAR);

statement ok
INSERT INTO t2 VALUES (1, 'alice'), (2, 'bob');

statement ok
CREATE MATERIALIZED VIEW mv1 AS SELECT grp, sum(val) as total FROM t1 GROUP BY grp;

statement ok
CREATE MATERIALIZED VIEW mv2 AS SELECT id, name FROM t2;

# ==========================================
# Test 1: Metadata tables exist after first MV creation
# ==========================================

query I
SELECT count(*) FROM openivm_views;
----
2

query I
SELECT count(*) FROM openivm_delta_tables;
----
2

# ==========================================
# Test 2: openivm_views has correct entries
# ==========================================

query II
SELECT view_sql_name, type FROM openivm_views ORDER BY view_name;
----
mv1	0
mv2	2

# type 0 = AGGREGATE_GROUP, type 2 = SIMPLE_PROJECTION

# view_name is an encoded internal key; the SQL-facing name lives only in view_sql_name.
# Tooling (e.g. the rewriter benchmark) must resolve the SQL name to the key before reading metadata.
query I
SELECT count(*) FROM openivm_views WHERE view_name = 'mv1';
----
0

query I
SELECT count(*) FROM openivm_views WHERE view_name LIKE '\_\_openivm\_mv\_%' ESCAPE '\' AND view_name <> view_sql_name;
----
2

query I
SELECT type FROM openivm_views WHERE view_name = (
    SELECT view_name FROM openivm_views
    WHERE view_sql_name = 'mv1' AND view_catalog = current_database() AND view_schema = current_schema());
----
0

# Verify the stored SQL is non-empty and contains the expected table/column references
query I
SELECT sql_string IS NOT NULL AND LENGTH(sql_string) > 0 AND sql_string LIKE '%sum%' AND sql_string LIKE '%grp%' FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_';
----
true

# ==========================================
# Test 3: openivm_delta_tables has correct entries
# ==========================================

query II
SELECT v.view_sql_name, d.table_name FROM openivm_delta_tables d JOIN openivm_views v USING (view_name) ORDER BY v.view_sql_name;
----
mv1	openivm_delta_t1
mv2	openivm_delta_t2

# ==========================================
# Test 4: Delta tables exist
# ==========================================

query I
SELECT count(*) FROM openivm_delta_t1;
----
0

query I
SELECT count(*) FROM openivm_delta_t2;
----
0

query I
SELECT count(*) FROM openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_;
----
0

query I
SELECT count(*) FROM openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_;
----
0

# ==========================================
# Test 5: last_update timestamps are set
# ==========================================

query I
SELECT count(*) FROM openivm_views WHERE last_update IS NOT NULL;
----
2

query I
SELECT count(*) FROM openivm_delta_tables WHERE last_update IS NOT NULL;
----
2

# ==========================================
# Test 5b: legacy has_join migration marks self-joins
# ==========================================

# Simulate a pre-has_join metadata row for an existing single-source self-join
# MV. The migration must mark it as a join even though it has only one
# openivm_delta_tables row.
statement ok
CREATE TABLE legacy_self_join_src(id INT);

statement ok
INSERT INTO openivm_views
    (view_name, sql_string, type, has_minmax, has_left_join, has_join, last_update, refresh_in_progress, has_full_outer)
VALUES
    ('mv_legacy_self_join',
     'SELECT l.id AS left_id, r.id AS right_id FROM legacy_self_join_src l JOIN legacy_self_join_src r ON l.id = r.id',
     2, false, false, NULL, now(), false, false);

statement ok
INSERT INTO openivm_delta_tables(view_name, table_name, last_update)
VALUES ('mv_legacy_self_join', 'openivm_delta_legacy_self_join_src', now());

statement ok
CREATE MATERIALIZED VIEW mv_trigger_join_backfill AS SELECT id FROM legacy_self_join_src;

query I
SELECT has_join FROM openivm_views WHERE view_name = 'mv_legacy_self_join';
----
true

statement ok
DELETE FROM openivm_delta_tables WHERE view_name = 'mv_legacy_self_join';

statement ok
DELETE FROM openivm_views WHERE view_name = 'mv_legacy_self_join';

statement ok
DROP VIEW mv_trigger_join_backfill;

statement ok
DROP TABLE legacy_self_join_src;

# ==========================================
# Test 6: IVM works before any drops (sanity check)
# ==========================================

statement ok
INSERT INTO t1 VALUES (3, 'a', 5);

statement ok
PRAGMA refresh('mv1');

query II
SELECT grp, total FROM mv1 ORDER BY grp;
----
a	15
b	20

# ==========================================
# Test 7: DROP MATERIALIZED VIEW cleans up metadata
# ==========================================

statement ok
DROP VIEW mv1;

# Entry should be removed from openivm_views
query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_';
----
0

# Entries should be removed from openivm_delta_tables
query I
SELECT count(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_';
----
0

# Delta view for the MV should be dropped
statement error
SELECT count(*) FROM openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_;
----
does not exist

# openivm_delta_t1 should be dropped since no other MV uses t1
statement error
SELECT count(*) FROM openivm_delta_t1;
----
does not exist

# mv2 metadata should be untouched
query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_';
----
1

query I
SELECT count(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_';
----
1

# ==========================================
# Test 8: After drop, base table still works normally
# ==========================================

statement ok
INSERT INTO t1 VALUES (4, 'c', 100);

query I
SELECT count(*) FROM t1;
----
4

# ==========================================
# Test 9: Can re-create MV with same name after drop
# ==========================================

statement ok
CREATE MATERIALIZED VIEW mv1 AS SELECT grp, sum(val) as total FROM t1 GROUP BY grp;

query II
SELECT grp, total FROM mv1 ORDER BY grp;
----
a	15
b	20
c	100

query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7631_';
----
1

# ==========================================
# Test 10: DROP second MV, delta table cleanup
# ==========================================

# Drop mv2 — openivm_delta_t2 should be cleaned up since no other MV uses t2
statement ok
DROP VIEW mv2;

query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_';
----
0

query I
SELECT count(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_';
----
0

statement error
SELECT count(*) FROM openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d7632_;
----
does not exist

# openivm_delta_t2 should be dropped since no MV depends on t2 anymore
statement error
SELECT count(*) FROM openivm_delta_t2;
----
does not exist

# ==========================================
# Test 11: Shared base table — delta kept when still needed
# ==========================================

# Create two MVs on same base table
statement ok
CREATE MATERIALIZED VIEW mv_shared1 AS SELECT grp, sum(val) as s FROM t1 GROUP BY grp;

statement ok
CREATE MATERIALIZED VIEW mv_shared2 AS SELECT grp, count(val) as c FROM t1 GROUP BY grp;

query I
SELECT count(*) FROM openivm_delta_tables WHERE table_name = 'openivm_delta_t1';
----
3

# Drop one — openivm_delta_t1 should remain (mv1 and mv_shared2 still use it)
statement ok
DROP VIEW mv_shared1;

query I
SELECT count(*) FROM openivm_delta_tables WHERE table_name = 'openivm_delta_t1';
----
2

# openivm_delta_t1 still exists
query I
SELECT count(*) FROM openivm_delta_t1;
----
0

# mv_shared2 still works
statement ok
INSERT INTO t1 VALUES (5, 'a', 7);

statement ok
PRAGMA refresh('mv_shared2');

query II
SELECT grp, c FROM mv_shared2 ORDER BY grp;
----
a	3
b	1
c	1

# ==========================================
# Test 12: DROP base table with CASCADE drops dependent MVs
# ==========================================

statement ok
CREATE TABLE t3 (id INT, val INT);

statement ok
INSERT INTO t3 VALUES (1, 100);

statement ok
CREATE MATERIALIZED VIEW mv_t3 AS SELECT sum(val) as total FROM t3;

query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f7433_';
----
1

# Regular DROP should fail because mv_t3 depends on t3... or DuckDB just drops it.
# Let's test CASCADE explicitly.
statement ok
DROP TABLE t3 CASCADE;

# MV should be gone
statement error
SELECT * FROM mv_t3;
----
does not exist

# Metadata should be cleaned up
query I
SELECT count(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f7433_';
----
0

query I
SELECT count(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f7433_';
----
0

# Delta tables should be gone
statement error
SELECT count(*) FROM openivm_delta_t3;
----
does not exist

statement error
SELECT count(*) FROM openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f7433_;
----
does not exist

# ==========================================
# Test 13: PRAGMA refresh on dropped MV gives clear error
# ==========================================

statement error
PRAGMA refresh('mv_t3');
----
does not exist

# ==========================================
# Test 14: Drop all MVs — system tables still exist but are empty
# ==========================================

# Clean up remaining MVs
statement ok
DROP VIEW mv1;

statement ok
DROP VIEW mv_shared2;

query I
SELECT count(*) FROM openivm_views;
----
0

query I
SELECT count(*) FROM openivm_delta_tables;
----
0

# ==========================================
# Test 15: Create new MV after all previous were dropped
# ==========================================

statement ok
CREATE TABLE fresh (id INT, val INT);

statement ok
INSERT INTO fresh VALUES (1, 42);

statement ok
CREATE MATERIALIZED VIEW mv_fresh AS SELECT sum(val) as total FROM fresh;

query I
SELECT total FROM mv_fresh;
----
42

query I
SELECT count(*) FROM openivm_views;
----
1

statement ok
INSERT INTO fresh VALUES (2, 8);

statement ok
PRAGMA refresh('mv_fresh');

query I
SELECT total FROM mv_fresh;
----
50

# NOTE: DROP MATERIALIZED VIEW syntax is not supported because DuckDB's
# internal PG parser intercepts it before our extension gets a chance.
# Use DROP VIEW to drop materialized views (the user-facing name is a VIEW).

# ==========================================
# Re-create MV with same name after DROP (different query)
# ==========================================

statement ok
CREATE TABLE recreate_base (id INT, val INT, category VARCHAR);

statement ok
INSERT INTO recreate_base VALUES (1, 10, 'a'), (2, 20, 'b');

statement ok
CREATE MATERIALIZED VIEW mv_recreate AS SELECT id, val FROM recreate_base;

query II
SELECT id, val FROM mv_recreate ORDER BY id;
----
1	10
2	20

statement ok
DROP VIEW mv_recreate;

# Re-create with a completely different query (aggregate instead of projection)
statement ok
CREATE MATERIALIZED VIEW mv_recreate AS SELECT category, SUM(val) AS total FROM recreate_base GROUP BY category;

query II
SELECT category, total FROM mv_recreate ORDER BY category;
----
a	10
b	20

statement ok
INSERT INTO recreate_base VALUES (3, 30, 'a');

statement ok
pragma refresh('mv_recreate');

query II
SELECT category, total FROM mv_recreate ORDER BY category;
----
a	40
b	20

# Cross-check
query II
SELECT category, SUM(val) FROM recreate_base GROUP BY category ORDER BY category;
----
a	40
b	20

# ==========================================
# VIEW wrapper: SELECT * hides internal columns
# ==========================================

statement ok
CREATE TABLE view_test (id INT, val INT);

statement ok
INSERT INTO view_test VALUES (1, 10), (2, 20);

statement ok
CREATE MATERIALIZED VIEW mv_view_test AS SELECT DISTINCT val FROM view_test;

# The MV is a VIEW over openivm_data_mv_view_test. Internal columns should be hidden.
# SELECT * should return only user-facing columns (val), not openivm_distinct_count.
query I
SELECT COUNT(*) FROM (SELECT * FROM mv_view_test);
----
2

# Verify the data table exists separately
query I
SELECT COUNT(*) FROM openivm_data___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f766965775f74657374_;
----
2

# ==========================================
# DROP VIEW cleans up data table + delta + metadata
# ==========================================

statement ok
CREATE TABLE drop_test (id INT, val INT);

statement ok
INSERT INTO drop_test VALUES (1, 10);

statement ok
CREATE MATERIALIZED VIEW mv_drop_test AS SELECT val FROM drop_test;

# Verify everything exists
query I
SELECT COUNT(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
1

query I
SELECT COUNT(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
1

query I
SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 'openivm_data___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
1

# DROP VIEW should clean up everything
statement ok
DROP VIEW mv_drop_test;

query I
SELECT COUNT(*) FROM openivm_views WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
0

query I
SELECT COUNT(*) FROM openivm_delta_tables WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
0

query I
SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 'openivm_data___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
0

query I
SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 'openivm_delta___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f64726f705f74657374_';
----
0

# ==========================================
# Compiled SQL archive: one lifecycle covers controls, ordered SQL, retention, failure and rollback.

load __TEST_DIR__/archive_contract.db

statement ok
RESET openivm_archive_compiled_sql; RESET openivm_compiled_sql_retention; RESET openivm_files_path;

query II
SELECT current_setting('openivm_archive_compiled_sql'),current_setting('openivm_compiled_sql_retention');
----
false	10

foreach invalid 0 -1 NULL

statement error
SET openivm_compiled_sql_retention=${invalid};
----
must be at least 1

endloop

statement ok
CREATE TABLE arch_src(k INTEGER,v INTEGER);
INSERT INTO arch_src VALUES (1,10),(1,10),(2,20);
CREATE MATERIALIZED VIEW disabled AS SELECT * FROM arch_src;

query I
SELECT count(*) FROM openivm_compiled_programs;
----
0

statement ok
DROP VIEW disabled;
SET SESSION openivm_archive_compiled_sql=true;
SET openivm_compiled_sql_retention=2;
SET openivm_files_path='__TEST_DIR__';
CREATE MATERIALIZED VIEW mv AS SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k;

query TTI
SELECT operation,last_outcome,committed_count FROM openivm_compiled_programs;
----
create	committed	1

query II
SELECT count(*)=any_value(p.statement_count) AND max(s.stmt_order)=count(*)-1,
min(s.stmt_order) FILTER(WHERE s.sql ILIKE 'create table %openivm_data_%') <
min(s.stmt_order) FILTER(WHERE s.sql ILIKE 'create view %')
FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING(view_name,operation,version)
WHERE p.operation='create';
----
true	true

loop batch 1 4

statement ok
INSERT INTO arch_src VALUES (1,3),(3,4),(3,4),(4,5);
UPDATE arch_src SET v=v+1 WHERE k=1;
DELETE FROM arch_src WHERE k=4;

statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

endloop

query III
SELECT count(*),min(version),max(version) FROM openivm_compiled_programs WHERE operation='refresh';
----
2	2	3

query II
SELECT (SELECT count(*) FROM openivm_compiled_programs p WHERE p.statement_count<>
(SELECT count(*) FROM openivm_compiled_statements s WHERE s.view_name=p.view_name AND s.operation=p.operation AND s.version=p.version)),
(SELECT count(*) FROM openivm_compiled_statements s WHERE NOT EXISTS
(SELECT 1 FROM openivm_compiled_programs p WHERE s.view_name=p.view_name AND s.operation=p.operation AND s.version=p.version));
----
0	0

query II
WITH f AS (SELECT replace(content,chr(13)||chr(10),chr(10)) AS content FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_617263686976655f636f6e7472616374_6d61696e_6d76_.sql')),
s AS (SELECT s.stmt_order,position(s.sql IN f.content) pos
FROM openivm_compiled_statements s,f WHERE operation='refresh' AND version=3)
SELECT bool_and(pos>0),bool_and(pos>coalesce(prev,0))
FROM (SELECT pos,lag(pos) OVER(ORDER BY stmt_order) prev FROM s);
----
true	true

statement ok
CREATE TEMP TABLE exported_before AS SELECT content FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_617263686976655f636f6e7472616374_6d61696e_6d76_.sql'); RESET openivm_files_path;

# Disabled recording, an empty refresh, and compile-only calls leave the archive unchanged.

statement ok
CREATE TEMP TABLE programs_before AS SELECT * FROM openivm_compiled_programs;
CREATE TEMP TABLE statements_before AS SELECT * FROM openivm_compiled_statements;
SET openivm_archive_compiled_sql=false;
INSERT INTO arch_src VALUES(2,6);

statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

statement ok
SET openivm_archive_compiled_sql=true;

statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

query I
SELECT count(*)>0 FROM openivm_compile_with_facts('mv','{"target_dialect":"duckdb","compile_only":true}');
----
true

query I
SELECT count(*) FROM ((SELECT * FROM openivm_compiled_programs EXCEPT ALL SELECT * FROM programs_before)
UNION ALL (SELECT * FROM programs_before EXCEPT ALL SELECT * FROM openivm_compiled_programs));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM openivm_compiled_statements EXCEPT ALL SELECT * FROM statements_before)
UNION ALL (SELECT * FROM statements_before EXCEPT ALL SELECT * FROM openivm_compiled_statements));
----
0

# Identical full programs reuse a version. Lower retention prunes both archive tables.

statement ok
SET openivm_refresh_mode='full'; SET openivm_compiled_sql_retention=1;

query TI
SELECT current_setting('openivm_refresh_mode'),current_setting('openivm_compiled_sql_retention');
----
full	1

loop repetition 0 2

statement ok
INSERT INTO arch_src VALUES(1,8),(7,2),(8,3);
UPDATE arch_src SET v=v+1 WHERE k=7;
DELETE FROM arch_src WHERE k=8;

statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

endloop

query II
SELECT count(*),min(committed_count) FROM openivm_compiled_programs WHERE operation='refresh';
----
1	2

query I
SELECT content=(SELECT content FROM exported_before) FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_617263686976655f636f6e7472616374_6d61696e_6d76_.sql');
----
true

# Pruning and archive writes share the caller transaction, including rollback.

foreach outcome ROLLBACK COMMIT

statement ok
CREATE OR REPLACE TEMP TABLE programs_before AS SELECT * FROM openivm_compiled_programs;
CREATE OR REPLACE TEMP TABLE statements_before AS SELECT * FROM openivm_compiled_statements;
BEGIN;
INSERT INTO arch_src VALUES (1,7),(5,8),(5,8);
UPDATE arch_src SET v=v+1 WHERE k=5;
DELETE FROM arch_src WHERE k=2;

statement ok
PRAGMA refresh('mv');

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

statement ok
${outcome};

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k)
UNION ALL (SELECT k,SUM(v) total,COUNT(*) c FROM arch_src GROUP BY k EXCEPT ALL SELECT * FROM mv));
----
0

query I
SELECT '${outcome}'='COMMIT' OR NOT EXISTS
((SELECT * FROM openivm_compiled_programs EXCEPT ALL SELECT * FROM programs_before)
UNION ALL (SELECT * FROM programs_before EXCEPT ALL SELECT * FROM openivm_compiled_programs));
----
true

query I
SELECT '${outcome}'='COMMIT' OR NOT EXISTS
((SELECT * FROM openivm_compiled_statements EXCEPT ALL SELECT * FROM statements_before)
UNION ALL (SELECT * FROM statements_before EXCEPT ALL SELECT * FROM openivm_compiled_statements));
----
true

endloop

# Failure to archive cannot turn a rolled-back native operation into success.

statement ok
SET openivm_refresh_mode='incremental';
CREATE TEMP TABLE mv_before AS SELECT * FROM mv;
CREATE TEMP TABLE archive_saved AS SELECT * FROM openivm_compiled_statements;
DROP TABLE openivm_compiled_statements;
CREATE TABLE openivm_compiled_statements(view_name VARCHAR,operation VARCHAR,version INTEGER,stmt_order INTEGER,
sql VARCHAR CHECK(operation<>'refresh'),PRIMARY KEY(view_name,operation,version,stmt_order));
INSERT INTO arch_src VALUES(8,9),(8,9),(9,10);
UPDATE arch_src SET v=v+1 WHERE k=8;
DELETE FROM arch_src WHERE k=9;

statement error
PRAGMA refresh('mv');
----
could not archive its compiled SQL

query I
SELECT count(*) FROM ((SELECT * FROM mv EXCEPT ALL SELECT * FROM mv_before)
UNION ALL (SELECT * FROM mv_before EXCEPT ALL SELECT * FROM mv));
----
0

statement ok
DROP TABLE openivm_compiled_statements;
CREATE TABLE openivm_compiled_statements(view_name VARCHAR,operation VARCHAR,version INTEGER,stmt_order INTEGER,
sql VARCHAR CHECK(operation<>'create'),PRIMARY KEY(view_name,operation,version,stmt_order));

statement error
