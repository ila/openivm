# ==========================================
# Compiled SQL archive: CREATE and refresh programs are archived automatically in
# the metadata catalog, independently of openivm_files_path (set above).
# ==========================================

statement ok
CREATE TABLE arch_src (id INT, grp VARCHAR, val INT);

statement ok
INSERT INTO arch_src VALUES (1, 'a', 10), (2, 'b', 20);

statement ok
CREATE MATERIALIZED VIEW mv_arch AS SELECT grp, SUM(val) AS total, COUNT(*) AS cnt FROM arch_src GROUP BY grp;

# CREATE stores one committed version under the qualified MV identity.
query IIIIIIIII
SELECT view_name, view_catalog, view_schema, view_sql_name, version, last_outcome, committed_count,
       compilation_id = last_compilation_id, compilation_id LIKE view_name || '_create_%'
FROM openivm_compiled_programs WHERE view_sql_name = 'mv_arch' AND operation = 'create';
----
__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f61726368_	openivm_metadata_test	main	mv_arch	1	committed	1	true	true

# All statements are stored contiguously in execution order: the backing table is
# loaded before the user-facing view exists, and metadata is published after both.
query IIII
SELECT count(*) = any_value(p.statement_count) AND max(s.stmt_order) = count(*) - 1,
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'create table %openivm_data_%_6d765f61726368_%as %') <
           min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'create view %mv_arch%'),
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'create view %mv_arch%') <
           min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'insert or replace into openivm_delta_tables%'),
       count(*) FILTER (WHERE s.sql ILIKE 'create unique index%')
FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
WHERE p.view_sql_name = 'mv_arch' AND p.operation = 'create';
----
true	true	true	1

# Consecutive refreshes embed their own delta cutoffs. The archive compares programs
# verbatim, so each successful refresh stores a version: the programs differ only in
# those state-specific timestamp literals, which are not normalized away.
statement ok
INSERT INTO arch_src VALUES (3, 'a', 5), (4, 'c', 7);

statement ok
PRAGMA refresh('mv_arch');

statement ok
INSERT INTO arch_src VALUES (5, 'b', 1), (6, 'c', 2);

statement ok
PRAGMA refresh('mv_arch');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM mv_arch EXCEPT ALL SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp)),
       (SELECT count(*) FROM (SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp EXCEPT ALL SELECT * FROM mv_arch));
----
0	0

query IIII
SELECT version, last_outcome, committed_count, compilation_id = last_compilation_id
FROM openivm_compiled_programs WHERE view_sql_name = 'mv_arch' AND operation = 'refresh' ORDER BY version;
----
1	committed	1	true
2	committed	1	true

query III
WITH v AS (
    SELECT s.version, list(s.sql ORDER BY s.stmt_order) AS raw,
           list(regexp_replace(s.sql, '''\d{4}-\d{2}-\d{2} [0-9:.]+''::TIMESTAMP', '<cutoff>', 'g') ORDER BY s.stmt_order) AS masked
    FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
    WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' GROUP BY s.version)
SELECT (SELECT raw FROM v WHERE version = 1) <> (SELECT raw FROM v WHERE version = 2),
       (SELECT masked FROM v WHERE version = 1) = (SELECT masked FROM v WHERE version = 2),
       (SELECT len(raw) FROM v WHERE version = 2);
----
true	true	15

# File export and the archive coexist: the refresh reference file holds exactly the
# latest archived statements, in the archived order.
query II
WITH f AS (SELECT content FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f61726368_.sql')),
s AS (
    SELECT s.stmt_order, position(s.sql IN f.content) AS pos
    FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version), f
    WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' AND s.version = 2)
SELECT bool_and(pos > 0), bool_and(pos > COALESCE(prev_pos, 0))
FROM (SELECT pos, lag(pos) OVER (ORDER BY stmt_order) AS prev_pos FROM s);
----
true	true

# Unchanged incremental SQL compiled twice stores one version. A failing after-hook
# rolls the refresh back without touching the pending deltas, so the retry compiles
# exactly the same program: the first run is recorded as attempted, and the retry
# marks the same version committed.
statement ok
CREATE TABLE arch_hook_log (n INTEGER);

statement ok
INSERT INTO openivm_refresh_hooks VALUES ('__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f61726368_', 'INSERT INTO arch_hook_log SELECT CAST(''not-a-number'' AS INTEGER)', 'after');

statement ok
INSERT INTO arch_src VALUES (7, 'd', 4), (8, 'a', 6);

statement error
PRAGMA refresh('mv_arch');
----
after-hook

query II
SELECT (SELECT count(*) FROM mv_arch WHERE grp = 'd'), (SELECT total FROM mv_arch WHERE grp = 'a');
----
0	15

query IIII
SELECT version, last_outcome, committed_count, compilation_id = last_compilation_id
FROM openivm_compiled_programs WHERE view_sql_name = 'mv_arch' AND operation = 'refresh' ORDER BY version;
----
1	committed	1	true
2	committed	1	true
3	attempted	0	true

statement ok
CREATE TEMP TABLE arch_v3 AS
SELECT s.stmt_order, s.sql FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' AND s.version = 3;

statement ok
UPDATE openivm_refresh_hooks SET hook_sql = 'INSERT INTO arch_hook_log VALUES (1)' WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f61726368_';

statement ok
PRAGMA refresh('mv_arch');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM mv_arch EXCEPT ALL SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp)),
       (SELECT count(*) FROM (SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp EXCEPT ALL SELECT * FROM mv_arch));
----
0	0

query IIII
SELECT version, last_outcome, committed_count, compilation_id = last_compilation_id
FROM openivm_compiled_programs WHERE view_sql_name = 'mv_arch' AND operation = 'refresh' ORDER BY version;
----
1	committed	1	true
2	committed	1	true
3	committed	1	false

# The stored text of version 3 is untouched by the retry.
query I
SELECT count(*) FROM ((SELECT stmt_order, sql FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
                       WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' AND s.version = 3 EXCEPT ALL SELECT * FROM arch_v3)
                      UNION ALL (SELECT * FROM arch_v3 EXCEPT ALL SELECT stmt_order, sql FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
                       WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' AND s.version = 3));
----
0

statement ok
DELETE FROM openivm_refresh_hooks WHERE view_name = '__openivm_mv_6f70656e69766d5f6d657461646174615f74657374_6d61696e_6d765f61726368_';

# A batch with deletes and updates compiles a structurally different program: a new
# version whose statements, in order, mark the refresh in progress, compute the MV
# delta, merge it, delete emptied groups, and finally clear the in-progress flag.
statement ok
DELETE FROM arch_src WHERE id = 1;

statement ok
UPDATE arch_src SET val = val + 100 WHERE id = 4;

statement ok
INSERT INTO arch_src VALUES (9, 'a', 3);

statement ok
DELETE FROM arch_src WHERE id = 9;

statement ok
PRAGMA refresh('mv_arch');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM mv_arch EXCEPT ALL SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp)),
       (SELECT count(*) FROM (SELECT grp, SUM(val), COUNT(*) FROM arch_src GROUP BY grp EXCEPT ALL SELECT * FROM mv_arch));
----
0	0

query III
SELECT version, last_outcome, committed_count
FROM openivm_compiled_programs WHERE view_sql_name = 'mv_arch' AND operation = 'refresh' ORDER BY version;
----
1	committed	1
2	committed	1
3	committed	1
4	committed	1

query IIIIII
SELECT s.version, count(*),
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'update %openivm_views set refresh_in_progress = true%'),
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'with%insert into %openivm_delta___openivm_mv_%'),
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'with refresh_cte as%merge into %openivm_data_%'),
       min(s.stmt_order) FILTER (WHERE s.sql ILIKE 'delete from %openivm_data_% where coalesce(cnt, 0) = 0')
FROM openivm_compiled_statements s JOIN openivm_compiled_programs p USING (view_name, operation, version)
WHERE p.view_sql_name = 'mv_arch' AND s.operation = 'refresh' AND s.version IN (3, 4)
GROUP BY s.version ORDER BY s.version;
----
