# Archive-write failure: a native refresh rolls back with an error instead of
# reporting success without its archive record. Simulate an archive table that
# rejects every new refresh row.
statement ok
CREATE TABLE arch_statements_backup AS SELECT * FROM openivm_compiled_statements;

statement ok
DROP TABLE openivm_compiled_statements;

statement ok
CREATE TABLE openivm_compiled_statements (view_name varchar, operation varchar, version integer, stmt_order integer,
    sql varchar CHECK (operation <> 'refresh'), primary key (view_name, operation, version, stmt_order));

statement ok
INSERT INTO arch_src VALUES (14, 'a', 1000);

statement error
PRAGMA refresh('mv_arch');
----
could not archive its compiled SQL

# The refresh rolled back: the MV still lacks the new row, which stays pending.
query I
SELECT total FROM mv_arch WHERE grp = 'a';
----
11

# Recording the failed attempt hits the same broken table, so the error reports both.
statement error
PRAGMA refresh('mv_arch');
----
could not record this failed refresh in the compiled-SQL archive

# CREATE also fails atomically when its archive cannot be written.
statement ok
DROP TABLE openivm_compiled_statements;

statement ok
CREATE TABLE openivm_compiled_statements (view_name varchar, operation varchar, version integer, stmt_order integer,
    sql varchar CHECK (operation <> 'create'), primary key (view_name, operation, version, stmt_order));

statement error
