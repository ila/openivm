# A refresh that fails during execution rolls back and is recorded as attempted,
# never as committed. Fixing the row changes the pending deltas, so the successful
# retry compiles and stores a different program.
statement ok
CREATE TABLE arch_cast_src (id INT, txt VARCHAR);

statement ok
