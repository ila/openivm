# name: test/sql/metadata_schema.test
# description: openivm_metadata_schema relocates OpenIVM control metadata only; MV state, publications, deltas and indexes keep their placement
# group: [sql]

require openivm

load __TEST_DIR__/openivm_metadata_schema.db

# ---------------------------------------------------------------------------
# Existing metadata in main is discovered, then moved by the first refresh after
# openivm_metadata_schema is set. Nothing has to be moved by hand.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE legacy_src (k INTEGER, v INTEGER);

statement ok
INSERT INTO legacy_src VALUES (1, 10), (1, 20), (2, 5);

statement ok
CREATE MATERIALIZED VIEW legacy_mv AS SELECT k, SUM(v) AS s, COUNT(*) AS c FROM legacy_src GROUP BY k;

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name = 'openivm_views';
----
1

statement ok
SET openivm_metadata_schema = 'OpenIVM Meta';

# Read-only lookups use the metadata where it currently lives.
statement ok
PRAGMA refresh_status('legacy_mv');

statement ok
INSERT INTO legacy_src VALUES (2, 7), (3, 1), (3, 2);

statement ok
DELETE FROM legacy_src WHERE v = 10;

statement ok
UPDATE legacy_src SET v = v + 1 WHERE k = 2;

statement ok
PRAGMA refresh('legacy_mv');

query I
SELECT string_agg(table_name, ',' ORDER BY table_name) FROM duckdb_tables() WHERE schema_name = 'OpenIVM Meta';
----
openivm_constraints_cache,openivm_delta_tables,openivm_match_log,openivm_mv_dependencies,openivm_refresh_history,openivm_refresh_hooks,openivm_refresh_profile,openivm_views

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name IN ('openivm_views', 'openivm_delta_tables',
    'openivm_refresh_hooks', 'openivm_refresh_history', 'openivm_refresh_profile', 'openivm_mv_dependencies',
    'openivm_match_log', 'openivm_constraints_cache');
----
0

# Backing, MV-delta and publication tables, the index and the source delta stay with the MV and its source.
query III
SELECT
    (SELECT count(*) FROM duckdb_tables() t JOIN "OpenIVM Meta".openivm_views v
        ON t.table_name IN ('openivm_data_' || v.view_name, 'openivm_delta_' || v.view_name, 'openivm_visible_' || v.view_name)
     WHERE v.view_sql_name = 'legacy_mv' AND t.schema_name = 'main'),
    (SELECT count(*) FROM duckdb_indexes() i JOIN "OpenIVM Meta".openivm_views v ON i.table_name = 'openivm_data_' || v.view_name
     WHERE v.view_sql_name = 'legacy_mv' AND i.schema_name = 'main'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name = 'openivm_delta_legacy_src');
----
3	1	1

query I
SELECT count(*) FROM ((SELECT * FROM legacy_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k) UNION ALL (SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k EXCEPT ALL SELECT * FROM legacy_mv));
----
0

query III
SELECT k, s, c FROM legacy_mv ORDER BY k;
----
1	20	1
2	14	2
3	3	2

# Scheduling and profiling write to the configured schema.
statement ok
ALTER MATERIALIZED VIEW legacy_mv SET REFRESH EVERY '1 hour';

query I
SELECT refresh_interval FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'legacy_mv';
----
3600

statement ok
SET openivm_profile_refresh = true;

statement ok
INSERT INTO legacy_src VALUES (1, 1);

statement ok
PRAGMA refresh('legacy_mv');

statement ok
SET openivm_profile_refresh = false;

query I
SELECT count(*) FROM ((SELECT * FROM legacy_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k) UNION ALL (SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k EXCEPT ALL SELECT * FROM legacy_mv));
----
0

query I
SELECT count(*) > 0 FROM "OpenIVM Meta".openivm_refresh_profile p JOIN "OpenIVM Meta".openivm_views v USING (view_name)
WHERE v.view_sql_name = 'legacy_mv';
----
true

statement ok
PRAGMA refresh_history('legacy_mv');

# ---------------------------------------------------------------------------
# New MVs: metadata goes to the configured schema; the MV, its state and its
# index stay in the requested schema exactly as without the setting.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE new_src (k INTEGER, v INTEGER);

statement ok
INSERT INTO new_src VALUES (1, 1), (2, 2), (2, 3);

statement ok
CREATE MATERIALIZED VIEW new_mv AS SELECT k, SUM(v) AS s FROM new_src GROUP BY k;

query IIII
SELECT
    (SELECT count(*) FROM duckdb_views() WHERE schema_name = 'main' AND view_name = 'new_mv'),
    (SELECT count(*) FROM duckdb_tables() t JOIN "OpenIVM Meta".openivm_views v
        ON t.table_name IN ('openivm_data_' || v.view_name, 'openivm_delta_' || v.view_name, 'openivm_visible_' || v.view_name)
     WHERE v.view_sql_name = 'new_mv' AND t.schema_name = 'main'),
    (SELECT count(*) FROM duckdb_indexes() i JOIN "OpenIVM Meta".openivm_views v ON i.table_name = 'openivm_data_' || v.view_name
     WHERE v.view_sql_name = 'new_mv' AND i.schema_name = 'main'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name = 'openivm_views');
----
1	3	1	0

statement ok
INSERT INTO new_src VALUES (3, 4), (1, 5);

statement ok
DELETE FROM new_src WHERE k = 2 AND v = 2;

statement ok
UPDATE new_src SET v = v * 10 WHERE k = 3;

statement ok
PRAGMA refresh('new_mv');

query I
SELECT count(*) FROM ((SELECT * FROM new_mv EXCEPT ALL SELECT k, SUM(v) FROM new_src GROUP BY k) UNION ALL (SELECT k, SUM(v) FROM new_src GROUP BY k EXCEPT ALL SELECT * FROM new_mv));
----
0

# A CREATE that fails during its initial load must not leave the caller's
# session in the metadata schema.
statement ok
CREATE TABLE cast_src (v INTEGER);

statement ok
INSERT INTO cast_src VALUES (1000);

statement error
CREATE MATERIALIZED VIEW cast_mv AS SELECT v::TINYINT AS t FROM cast_src;
----
Conversion Error

query T
SELECT current_schema();
----
main

statement ok
CREATE TABLE after_failed_create (i INTEGER);

query II
SELECT
    (SELECT string_agg(schema_name, ',') FROM duckdb_tables() WHERE table_name = 'after_failed_create'),
    (SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'cast_mv');
----
main	0

# ---------------------------------------------------------------------------
# Same-named sources and MVs in different schemas, quoted names, and a
# non-default search path keep separate physical identities.
# ---------------------------------------------------------------------------
statement ok
CREATE SCHEMA s1;

statement ok
CREATE SCHEMA "Other Schema";

statement ok
CREATE TABLE s1.items (id INTEGER, grp VARCHAR, amount INTEGER);

statement ok
CREATE TABLE "Other Schema".items (id INTEGER, grp VARCHAR, amount INTEGER);

statement ok
INSERT INTO s1.items VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 5);

statement ok
INSERT INTO "Other Schema".items VALUES (1, 'x', 100), (2, 'y', 200);

statement ok
SET search_path = 's1,main';

statement ok
CREATE MATERIALIZED VIEW "Totals MV" AS SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM items GROUP BY grp;

statement ok
USE openivm_metadata_schema."Other Schema";

statement ok
CREATE MATERIALIZED VIEW "Totals MV" AS SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM items GROUP BY grp;

statement ok
USE openivm_metadata_schema.main;

# SQL names compare case-insensitively, as DuckDB identifiers do.
query II
SELECT view_schema, lower(view_sql_name) FROM "OpenIVM Meta".openivm_views WHERE lower(view_sql_name) = 'totals mv' ORDER BY view_schema;
----
Other Schema	totals mv
s1	totals mv

query II
SELECT d.source_schema, d.table_name FROM "OpenIVM Meta".openivm_delta_tables d JOIN "OpenIVM Meta".openivm_views v USING (view_name)
WHERE lower(v.view_sql_name) = 'totals mv' ORDER BY d.source_schema;
----
Other Schema	openivm_delta_items
s1	openivm_delta_items

# Each MV's state lives in its own schema, each source delta beside its source.
query II
SELECT
    (SELECT count(*) FROM duckdb_tables() t JOIN "OpenIVM Meta".openivm_views v
        ON t.table_name IN ('openivm_data_' || v.view_name, 'openivm_delta_' || v.view_name, 'openivm_visible_' || v.view_name)
        AND t.schema_name = v.view_schema
     WHERE lower(v.view_sql_name) = 'totals mv'),
    (SELECT count(*) FROM duckdb_tables() WHERE table_name = 'openivm_delta_items' AND schema_name IN ('s1', 'Other Schema'));
----
6	2

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'OpenIVM Meta' AND table_name NOT IN ('openivm_views',
    'openivm_delta_tables', 'openivm_refresh_hooks', 'openivm_refresh_history', 'openivm_refresh_profile',
    'openivm_mv_dependencies', 'openivm_match_log', 'openivm_constraints_cache');
----
0

# Names with spaces are quoted inside the argument, as in a qualified name.
statement error
PRAGMA refresh('"Totals MV"');
----
Ambiguous materialized view

statement ok
INSERT INTO s1.items VALUES (4, 'b', 7), (5, 'c', 1);

statement ok
DELETE FROM s1.items WHERE id = 1;

statement ok
UPDATE s1.items SET amount = amount * 2 WHERE grp = 'b';

statement ok
INSERT INTO "Other Schema".items VALUES (3, 'x', 1);

statement ok
DELETE FROM "Other Schema".items WHERE id = 2;

statement ok
UPDATE "Other Schema".items SET grp = 'z' WHERE id = 1;

statement ok
PRAGMA refresh('s1."Totals MV"');

statement ok
PRAGMA refresh('"Other Schema"."Totals MV"');

query I
SELECT count(*) FROM ((SELECT * FROM s1."Totals MV" EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM s1.items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM s1.items GROUP BY grp EXCEPT ALL SELECT * FROM s1."Totals MV"));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM "Other Schema"."Totals MV" EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM "Other Schema".items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM "Other Schema".items GROUP BY grp EXCEPT ALL SELECT * FROM "Other Schema"."Totals MV"));
----
0

# Auxiliary state reads the source the view bound, even when that source comes
# from a later schema on the search path.
statement ok
CREATE TABLE main_only_src (g INTEGER, x INTEGER);

statement ok
INSERT INTO main_only_src VALUES (1, 10), (1, 20), (1, 10), (2, 30);

statement ok
SET openivm_stateful_auxstate = true;

statement ok
SET search_path = 's1,main';

statement ok
CREATE MATERIALIZED VIEW aux_mv AS SELECT g, COUNT(DISTINCT x) AS dx FROM main_only_src GROUP BY g;

statement ok
USE openivm_metadata_schema.main;

query III
SELECT
    (SELECT view_schema FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'aux_mv'),
    (SELECT type FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'aux_mv'),
    (SELECT count(*) FROM duckdb_tables() t JOIN "OpenIVM Meta".openivm_views v
        ON t.table_name = 'openivm_aux_' || v.view_name AND t.schema_name = 's1'
     WHERE v.view_sql_name = 'aux_mv');
----
s1	11	1

statement ok
INSERT INTO main_only_src VALUES (1, 40), (2, 30), (3, 99);

statement ok
DELETE FROM main_only_src WHERE g = 1 AND x = 20;

statement ok
UPDATE main_only_src SET x = 10 WHERE g = 3;

statement ok
PRAGMA refresh('s1.aux_mv');

query I
SELECT count(*) FROM ((SELECT * FROM s1.aux_mv EXCEPT ALL SELECT g, COUNT(DISTINCT x) FROM main_only_src GROUP BY g) UNION ALL (SELECT g, COUNT(DISTINCT x) FROM main_only_src GROUP BY g EXCEPT ALL SELECT * FROM s1.aux_mv));
----
0

statement ok
SET openivm_stateful_auxstate = false;

# ---------------------------------------------------------------------------
# Replacement keeps one metadata row in the configured schema.
# ---------------------------------------------------------------------------
statement ok
CREATE OR REPLACE MATERIALIZED VIEW s1."Totals MV" AS
SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM s1.items WHERE amount > 1 GROUP BY grp;

query II
SELECT
    (SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE lower(view_sql_name) = 'totals mv' AND view_schema = 's1'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name = 'openivm_views');
----
1	0

statement ok
INSERT INTO s1.items VALUES (6, 'c', 1), (7, 'c', 9), (8, 'a', 3);

statement ok
DELETE FROM s1.items WHERE id = 3;

statement ok
UPDATE s1.items SET amount = 0 WHERE id = 8;

statement ok
PRAGMA refresh_options('openivm_metadata_schema', 's1', 'Totals MV');

query I
SELECT count(*) FROM ((SELECT * FROM s1."Totals MV" EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM s1.items WHERE amount > 1 GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM s1.items WHERE amount > 1 GROUP BY grp EXCEPT ALL SELECT * FROM s1."Totals MV"));
----
0

# ---------------------------------------------------------------------------
# DROP removes the MV's metadata from the configured schema and its internal
# objects from the MV's own schema.
# ---------------------------------------------------------------------------
statement ok
DROP VIEW "Other Schema"."Totals MV";

query III
SELECT
    (SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE view_schema = 'Other Schema'),
    (SELECT count(*) FROM "OpenIVM Meta".openivm_delta_tables WHERE source_schema = 'Other Schema'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'Other Schema' AND starts_with(table_name, 'openivm_'));
----
0	0	0

# A rolled-back DROP restores the metadata and the MV stays refreshable.
statement ok
BEGIN TRANSACTION;

statement ok
DROP VIEW s1."Totals MV";

query I
SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE lower(view_sql_name) = 'totals mv';
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE lower(view_sql_name) = 'totals mv';
----
1

# A rolled-back CREATE leaves no metadata row and no user-facing view.
statement ok
BEGIN TRANSACTION;

statement ok
CREATE MATERIALIZED VIEW s1.rolled_back AS SELECT id, amount FROM s1.items;

query I
SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'rolled_back';
----
1

statement ok
ROLLBACK;

query II
SELECT
    (SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'rolled_back'),
    (SELECT count(*) FROM duckdb_views() WHERE view_name = 'rolled_back');
----
0	0

# In a catalog without metadata, the configured schema is created inside the
# caller's transaction and disappears with its rollback.
statement ok
ATTACH '__TEST_DIR__/openivm_metadata_schema_fresh.db' AS fresh_cat;

statement ok
CREATE TABLE fresh_cat.main.fresh_src (id INTEGER);

statement ok
INSERT INTO fresh_cat.main.fresh_src VALUES (1), (1), (2);

statement ok
BEGIN TRANSACTION;

statement ok
CREATE MATERIALIZED VIEW fresh_cat.main.fresh_mv AS SELECT id FROM fresh_cat.main.fresh_src;

query I
SELECT count(*) FROM fresh_cat."OpenIVM Meta".openivm_views WHERE view_sql_name = 'fresh_mv';
----
1

statement ok
ROLLBACK;

query II
SELECT
    (SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'fresh_cat' AND schema_name = 'OpenIVM Meta'),
    (SELECT count(*) FROM duckdb_views() WHERE database_name = 'fresh_cat' AND view_name = 'fresh_mv');
----
0	0

# Outside a transaction, the first MV creates the schema in that catalog.
statement ok
CREATE MATERIALIZED VIEW fresh_cat.main.fresh_mv AS SELECT id FROM fresh_cat.main.fresh_src;

statement ok
INSERT INTO fresh_cat.main.fresh_src VALUES (3), (2);

statement ok
DELETE FROM fresh_cat.main.fresh_src WHERE id = 1;

statement ok
PRAGMA refresh('fresh_cat.main.fresh_mv');

query III
SELECT
    (SELECT count(*) FROM fresh_cat."OpenIVM Meta".openivm_views WHERE view_sql_name = 'fresh_mv'),
    (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'fresh_cat' AND schema_name = 'main' AND table_name = 'openivm_views'),
    (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'fresh_cat' AND schema_name = 'main' AND table_name = 'openivm_delta_fresh_src');
----
1	0	1

query I
SELECT count(*) FROM ((SELECT * FROM fresh_cat.main.fresh_mv EXCEPT ALL SELECT id FROM fresh_cat.main.fresh_src) UNION ALL (SELECT id FROM fresh_cat.main.fresh_src EXCEPT ALL SELECT * FROM fresh_cat.main.fresh_mv));
----
0

statement ok
DETACH fresh_cat;

# ---------------------------------------------------------------------------
# Reopen: the setting is not persisted, but the metadata location is discovered.
# ---------------------------------------------------------------------------
restart

statement ok
INSERT INTO legacy_src VALUES (4, 4), (2, 1);

statement ok
DELETE FROM legacy_src WHERE k = 3 AND v = 1;

statement ok
PRAGMA refresh('legacy_mv');

query I
SELECT count(*) FROM ((SELECT * FROM legacy_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k) UNION ALL (SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k EXCEPT ALL SELECT * FROM legacy_mv));
----
0

statement ok
INSERT INTO s1.items VALUES (9, 'd', 3);

statement ok
UPDATE s1.items SET amount = amount + 1 WHERE grp = 'a';

statement ok
PRAGMA refresh('s1."Totals MV"');

query I
SELECT count(*) FROM ((SELECT * FROM s1."Totals MV" EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM s1.items WHERE amount > 1 GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM s1.items WHERE amount > 1 GROUP BY grp EXCEPT ALL SELECT * FROM s1."Totals MV"));
----
0

# New views join the discovered schema; nothing is recreated in main.
statement ok
CREATE MATERIALIZED VIEW after_reopen AS SELECT k, v FROM legacy_src;

query II
SELECT
    (SELECT count(*) FROM "OpenIVM Meta".openivm_views WHERE view_sql_name = 'after_reopen'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name IN ('openivm_views',
        'openivm_delta_tables', 'openivm_refresh_hooks', 'openivm_refresh_history', 'openivm_refresh_profile',
        'openivm_mv_dependencies', 'openivm_match_log', 'openivm_constraints_cache'));
----
1	0

# ---------------------------------------------------------------------------
# Configuring main again moves the metadata back; MV objects never move.
# ---------------------------------------------------------------------------
statement ok
SET openivm_metadata_schema = 'main';

statement ok
INSERT INTO legacy_src VALUES (5, 5);

statement ok
PRAGMA refresh('legacy_mv');

query II
SELECT
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'OpenIVM Meta'),
    (SELECT count(*) FROM main.openivm_views WHERE lower(view_sql_name) IN ('legacy_mv', 'new_mv', 'totals mv', 'after_reopen'));
----
0	4

query I
SELECT count(*) FROM duckdb_tables() t JOIN main.openivm_views v
    ON t.table_name IN ('openivm_data_' || v.view_name, 'openivm_delta_' || v.view_name, 'openivm_visible_' || v.view_name)
    AND t.schema_name = v.view_schema
WHERE lower(v.view_sql_name) IN ('legacy_mv', 'new_mv', 'totals mv', 'after_reopen');
----
12

query I
SELECT count(*) FROM ((SELECT * FROM legacy_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k) UNION ALL (SELECT k, SUM(v), COUNT(*) FROM legacy_src GROUP BY k EXCEPT ALL SELECT * FROM legacy_mv));
----
0

statement ok
INSERT INTO legacy_src VALUES (6, 6);

statement ok
PRAGMA refresh('after_reopen');

query I
SELECT count(*) FROM ((SELECT * FROM after_reopen EXCEPT ALL SELECT k, v FROM legacy_src) UNION ALL (SELECT k, v FROM legacy_src EXCEPT ALL SELECT * FROM after_reopen));
----
0
