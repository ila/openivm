# name: test/sql/ducklake_cte.test
# description: Test LPTS CTE generation for DuckLake MVs — no AT VERSION, correct catalog refs
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake FROM '{BUILD_DIRECTORY}/repository';

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_cte.db' AS dl (TYPE ducklake);

# ==========================================
# MV definition should NOT contain AT VERSION
# ==========================================

statement ok
CREATE TABLE dl.products (id INTEGER, name VARCHAR, price DECIMAL(10,2));

statement ok
INSERT INTO dl.products VALUES (1, 'Widget', 9.99), (2, 'Gadget', 19.99);

statement ok
CREATE MATERIALIZED VIEW dl.mv_prices AS
  SELECT name, SUM(price) as total, COUNT(*) as cnt FROM dl.products GROUP BY name;

# The stored view query should reference dl.main.products without AT VERSION
query I
SELECT sql_string LIKE '%dl.main.products%' FROM openivm_views WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f707269636573_';
----
true

query I
SELECT sql_string NOT LIKE '%AT (VERSION%' FROM openivm_views WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f707269636573_';
----
true

# ==========================================
# Verify incremental refresh produces correct results
# (tests that the CTE SQL round-trips correctly)
# ==========================================

statement ok
INSERT INTO dl.products VALUES (3, 'Widget', 5.00);

statement ok
PRAGMA refresh('mv_prices');

# EXCEPT ALL
query I
SELECT count(*) FROM (
  SELECT name, total, cnt FROM dl.mv_prices
  EXCEPT ALL
  SELECT name, SUM(price), COUNT(*) FROM dl.products GROUP BY name
);
----
0

query I
SELECT count(*) FROM (
  SELECT name, SUM(price), COUNT(*) FROM dl.products GROUP BY name
  EXCEPT ALL
  SELECT name, total, cnt FROM dl.mv_prices
);
----
0

# ==========================================
# Combined operators: filter + aggregate over DuckLake
# ==========================================

statement ok
CREATE TABLE dl.orders (id INTEGER, region VARCHAR, amount INTEGER, status VARCHAR);

statement ok
INSERT INTO dl.orders VALUES (1, 'east', 100, 'active'), (2, 'west', 200, 'active'), (3, 'east', 150, 'cancelled');

statement ok
CREATE MATERIALIZED VIEW dl.mv_active AS
  SELECT region, SUM(amount) as total, COUNT(*) as cnt
  FROM dl.orders WHERE status = 'active' GROUP BY region;

query III rowsort
SELECT * FROM dl.mv_active ORDER BY region;
----
east	100	1
west	200	1

statement ok
INSERT INTO dl.orders VALUES (4, 'east', 50, 'active'), (5, 'west', 75, 'cancelled');

statement ok
PRAGMA refresh('mv_active');

# EXCEPT ALL
query I
SELECT count(*) FROM (
  SELECT region, total, cnt FROM dl.mv_active
  EXCEPT ALL
  SELECT region, SUM(amount), COUNT(*) FROM dl.orders WHERE status = 'active' GROUP BY region
);
----
0

query I
SELECT count(*) FROM (
  SELECT region, SUM(amount), COUNT(*) FROM dl.orders WHERE status = 'active' GROUP BY region
  EXCEPT ALL
  SELECT region, total, cnt FROM dl.mv_active
);
----
0

# ==========================================
# Repeated aggregate CTE under join
# ==========================================

statement ok
CREATE TABLE dl.cte_reuse (a INTEGER, b INTEGER);

statement ok
INSERT INTO dl.cte_reuse VALUES (1, 10), (1, 20), (2, 5);

statement ok
CREATE MATERIALIZED VIEW dl.mv_cte_reuse AS
  WITH s AS (
    SELECT a, SUM(b) AS sb
    FROM dl.cte_reuse
    GROUP BY a
  )
  SELECT s.a, s.sb, g.av
  FROM s
  CROSS JOIN (SELECT AVG(sb) AS av FROM s) g;

query I
SELECT type FROM openivm_views WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f6374655f7265757365_';
----
6

query I
SELECT group_columns FROM openivm_views WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f6374655f7265757365_';
----
a

statement ok
INSERT INTO dl.cte_reuse VALUES (2, 15);

statement ok
PRAGMA refresh('mv_cte_reuse');

query I
SELECT count(*) FROM (
  SELECT a, sb, av FROM dl.mv_cte_reuse
  EXCEPT ALL
  SELECT * FROM (
    WITH s AS (
      SELECT a, SUM(b) AS sb
      FROM dl.cte_reuse
      GROUP BY a
    )
    SELECT s.a, s.sb, g.av
    FROM s
    CROSS JOIN (SELECT AVG(sb) AS av FROM s) g
  ) expected
);
----
0

query I
SELECT count(*) FROM (
  SELECT * FROM (
    WITH s AS (
      SELECT a, SUM(b) AS sb
      FROM dl.cte_reuse
      GROUP BY a
    )
    SELECT s.a, s.sb, g.av
    FROM s
    CROSS JOIN (SELECT AVG(sb) AS av FROM s) g
  ) expected
  EXCEPT ALL
  SELECT a, sb, av FROM dl.mv_cte_reuse
);
----
0

# ==========================================
# Filtered CTE join: sparse scan bindings
# ==========================================

statement ok
CREATE TABLE dl.cte_customers (w INTEGER, d INTEGER, id INTEGER, payment_count INTEGER);

statement ok
CREATE TABLE dl.cte_orders (w INTEGER, d INTEGER, customer_id INTEGER, order_id INTEGER);

statement ok
INSERT INTO dl.cte_customers VALUES (1, 1, 1, 0), (1, 1, 2, 0), (1, 1, 3, 1);

statement ok
INSERT INTO dl.cte_orders VALUES (1, 1, 1, 101), (1, 1, 2, 102), (1, 1, 3, 103), (1, 1, 4, 104);

statement ok
CREATE MATERIALIZED VIEW dl.mv_active_customers AS
  WITH active AS (
    SELECT w, d, id FROM dl.cte_customers WHERE payment_count > 0
  )
  SELECT a.w, a.d, COUNT(o.order_id) AS orders
  FROM active a
  JOIN dl.cte_orders o
    ON a.w = o.w AND a.d = o.d AND a.id = o.customer_id
  GROUP BY a.w, a.d;

query I
SELECT type FROM openivm_views WHERE view_sql_name = 'mv_active_customers';
----
0

# Exercise multiple filter transitions plus a transient inserted row in one refresh.
statement ok
UPDATE dl.cte_customers SET payment_count = 1 WHERE id IN (1, 2);

statement ok
INSERT INTO dl.cte_customers VALUES (1, 1, 4, 1);

statement ok
UPDATE dl.cte_customers SET payment_count = 2 WHERE id = 4;

statement ok
DELETE FROM dl.cte_customers WHERE id IN (3, 4);

statement ok
PRAGMA refresh('mv_active_customers');

query I
SELECT count(*) FROM (
  SELECT * FROM dl.mv_active_customers
  EXCEPT ALL
  SELECT a.w, a.d, COUNT(o.order_id)
  FROM (SELECT w, d, id FROM dl.cte_customers WHERE payment_count > 0) a
  JOIN dl.cte_orders o
    ON a.w = o.w AND a.d = o.d AND a.id = o.customer_id
  GROUP BY a.w, a.d
);
----
0

query I
SELECT count(*) FROM (
  SELECT a.w, a.d, COUNT(o.order_id)
  FROM (SELECT w, d, id FROM dl.cte_customers WHERE payment_count > 0) a
  JOIN dl.cte_orders o
    ON a.w = o.w AND a.d = o.d AND a.id = o.customer_id
  GROUP BY a.w, a.d
  EXCEPT ALL
  SELECT * FROM dl.mv_active_customers
);
----
0
