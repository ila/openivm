CREATE MATERIALIZED VIEW tt_identity_mv AS
SELECT a.k, SUM(a.v + b.v) AS total
FROM memory.tt_identity VERSION AS OF 7 a
JOIN memory.main.tt_identity VERSION AS OF 7 b ON a.k = b.k GROUP BY a.k;

