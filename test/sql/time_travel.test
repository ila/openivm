1

# Nested parentheses defer the question one level, so the innermost element is still a scan.
query I
SELECT CASE WHEN string_agg(sql, ' ' ORDER BY stmt_order) LIKE '%`memory`.`main`.`tt_orders` VERSION AS OF 366%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) LIKE '%`memory`.`main`.`tt_customers` VERSION AS OF 12%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) NOT LIKE '%AT (VERSION%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts('tt_text_paren_nested', '{"target_dialect":"spark","compile_only":true}')
WHERE stmt_kind = 'data';
