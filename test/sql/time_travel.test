1

# The derived table keeps exactly one pin - on the scan inside it, never on the subquery itself.
query I
SELECT CASE WHEN string_agg(sql, ' ' ORDER BY stmt_order) LIKE '%`memory`.`main`.`tt_orders` VERSION AS OF 366%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) NOT LIKE '%) VERSION AS OF%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) NOT LIKE '%AT (VERSION%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts('tt_text_derived', '{"target_dialect":"spark","compile_only":true}')
WHERE stmt_kind = 'data';
