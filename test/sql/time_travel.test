# A derived table is not a relation, so the pin belongs to the scan inside it and to nothing else.
statement ok
CREATE MATERIALIZED VIEW tt_text_derived AS
    SELECT d.c_id AS c_id, SUM(d.amount) AS total
    FROM (SELECT c_id, amount FROM tt_orders VERSION AS OF 366
          EXCEPT ALL
          SELECT c_id, amount FROM tt_spare) d
    GROUP BY d.c_id;

