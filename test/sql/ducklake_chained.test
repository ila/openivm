# Mark-style diamond: all sources change before one run with overlapping targets.
statement ok
SET openivm_cascade_refresh='both';

statement ok
CREATE TABLE dl.mark_edges(k INT,v INT);

statement ok
INSERT INTO dl.mark_edges VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE TABLE dl.mark_dims(k INT,v INT);

statement ok
INSERT INTO dl.mark_dims VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE TABLE dl.mark_blocked(k INT,v INT);

statement ok
INSERT INTO dl.mark_blocked VALUES (NULL,4),(1,2),(1,2),(2,3),(4,5);

statement ok
CREATE MATERIALIZED VIEW dl.mark_p AS SELECT e.k,e.v,d.v AS dv FROM dl.mark_edges e LEFT JOIN dl.mark_dims d ON e.k=d.k;

statement ok
CREATE VIEW dl.mark_expected_p AS SELECT e.k,e.v,d.v AS dv FROM dl.mark_edges e LEFT JOIN dl.mark_dims d ON e.k=d.k;

statement ok
CREATE MATERIALIZED VIEW dl.mark_q AS SELECT k,SUM(v) AS sv,COUNT(*) AS n FROM dl.mark_dims GROUP BY k HAVING SUM(v)>0;

statement ok
CREATE VIEW dl.mark_expected_q AS SELECT k,SUM(v) AS sv,COUNT(*) AS n FROM dl.mark_dims GROUP BY k HAVING SUM(v)>0;

statement ok
CREATE MATERIALIZED VIEW dl.mark_a AS SELECT mark_p.* FROM dl.mark_p mark_p ANTI JOIN dl.mark_blocked b ON mark_p.k=b.k;

statement ok
CREATE VIEW dl.mark_expected_a AS SELECT mark_p.* FROM dl.mark_expected_p mark_p ANTI JOIN dl.mark_blocked b ON mark_p.k=b.k;

statement ok
CREATE MATERIALIZED VIEW dl.mark_z AS SELECT mark_p.k,mark_p.v,mark_p.dv,mark_q.sv,mark_q.n FROM dl.mark_p mark_p LEFT JOIN dl.mark_q mark_q ON mark_p.k=mark_q.k;

statement ok
CREATE VIEW dl.mark_expected_z AS SELECT mark_p.k,mark_p.v,mark_p.dv,mark_q.sv,mark_q.n FROM dl.mark_expected_p mark_p LEFT JOIN dl.mark_expected_q mark_q ON mark_p.k=mark_q.k;

statement ok
CREATE MATERIALIZED VIEW dl.mark_cube AS SELECT k,SUM(v) AS v,COUNT(*) AS n FROM dl.mark_z GROUP BY k;

statement ok
CREATE VIEW dl.mark_expected_cube AS SELECT k,SUM(v) AS v,COUNT(*) AS n FROM dl.mark_expected_z GROUP BY k;

statement ok
CREATE MATERIALIZED VIEW dl.mark_top AS SELECT k,v,n FROM dl.mark_cube ORDER BY v DESC NULLS LAST,k NULLS LAST LIMIT 3;

statement ok
CREATE VIEW dl.mark_expected_top AS SELECT k,v,n FROM dl.mark_expected_cube ORDER BY v DESC NULLS LAST,k NULLS LAST LIMIT 3;

statement ok
CREATE MATERIALIZED VIEW dl.mark_leaf AS SELECT * FROM dl.mark_top;

statement ok
CREATE VIEW dl.mark_expected_leaf AS SELECT * FROM dl.mark_expected_top;

statement ok
