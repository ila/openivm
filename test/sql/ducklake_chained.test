statement ok
INSERT INTO dl.mark_dims VALUES (1,7),(1,7),(3,4),(NULL,9);

statement ok
UPDATE dl.mark_dims SET v=v+1 WHERE k=1;

statement ok
DELETE FROM dl.mark_dims WHERE k=1 AND v=3;

statement ok
UPDATE dl.mark_dims SET k=5 WHERE k=4;

statement ok
INSERT INTO dl.mark_blocked VALUES (1,7),(1,7),(3,4),(NULL,9);

statement ok
UPDATE dl.mark_blocked SET v=v+1 WHERE k=1;

statement ok
DELETE FROM dl.mark_blocked WHERE k=1 AND v=3;

statement ok
UPDATE dl.mark_blocked SET k=5 WHERE k=4;

