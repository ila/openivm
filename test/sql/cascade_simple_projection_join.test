# Projection-wrapped self join uses the regular N-term path
statement ok
CREATE TABLE cspj_self_event (event_id INT, account_id INT, event_ts INT, label VARCHAR);

statement ok
CREATE TABLE cspj_self_account (account_id INT, account_name VARCHAR);

statement ok
INSERT INTO cspj_self_event VALUES
    (1, 1, 10, 'a'),
    (2, 1, 20, 'b'),
    (3, 2, 10, 'c');

statement ok
INSERT INTO cspj_self_account VALUES (1, 'one'), (2, 'two');

statement ok
CREATE MATERIALIZED VIEW cspj_self_mv AS
    SELECT cur.event_id AS current_id,
           prev.event_id AS previous_id,
           a.account_name,
           cur.label
    FROM cspj_self_event cur
    JOIN cspj_self_event prev
      ON cur.account_id = prev.account_id
     AND prev.event_ts < cur.event_ts
    JOIN cspj_self_account a ON cur.account_id = a.account_id;

statement ok
SELECT COUNT(*) FROM openivm_compile_with_facts(
    'cspj_self_mv',
    '{"target_dialect":"duckdb","compile_only":true}'
);

query I
SELECT ((length(content) - length(replace(content, 'UNION ALL', ''))) / length('UNION ALL'))
FROM read_text('__TEST_DIR__/openivm_upsert_queries_cspj_self_mv.sql');
----
4

