# name: test/sql/cascade_simple_projection_join.test
# description: Compile-only SIMPLE_PROJECTION joins emit real cascade view deltas
# group: [sql]

require openivm

statement ok
SET openivm_files_path='__TEST_DIR__';

# 2-source equi join
statement ok
CREATE TABLE cspj_eq_watch (watch_id INT, security_id INT, action_ts INT);

statement ok
CREATE TABLE cspj_eq_security (security_id INT, symbol VARCHAR);

statement ok
INSERT INTO cspj_eq_watch VALUES (1, 10, 100), (2, 20, 200);

statement ok
INSERT INTO cspj_eq_security VALUES (10, 'alpha'), (20, 'beta');

statement ok
CREATE MATERIALIZED VIEW cspj_eq_mv AS
    SELECT w.watch_id, w.security_id, s.symbol, w.action_ts
    FROM cspj_eq_watch w
    JOIN cspj_eq_security s ON w.security_id = s.security_id;

statement ok
SELECT COUNT(*) FROM openivm_compile_with_facts(
    'cspj_eq_mv',
    '{"target_dialect":"duckdb","compile_only":true}'
);

query I
SELECT CASE
           WHEN contains(content, 'INSERT INTO openivm_delta_cspj_eq_mv') AND
                contains(content, 'openivm_delta_cspj_eq_watch') AND
                contains(content, 'openivm_delta_cspj_eq_security') AND
                contains(content, 'UNION ALL') AND
                NOT contains(content, 'SELECT NULL::')
           THEN 1 ELSE 0
       END
FROM read_text('__TEST_DIR__/openivm_upsert_queries_cspj_eq_mv.sql');
----
1

statement ok
INSERT INTO cspj_eq_watch VALUES (3, 30, 300), (4, 20, 250);

statement ok
INSERT INTO cspj_eq_security VALUES (30, 'gamma');

statement ok
DELETE FROM cspj_eq_watch WHERE watch_id = 1;

statement ok
UPDATE cspj_eq_security SET symbol = 'beta_x' WHERE security_id = 20;

statement ok
PRAGMA refresh('cspj_eq_mv');

query I
SELECT COUNT(*) FROM (
    SELECT * FROM cspj_eq_mv
    EXCEPT ALL
    SELECT w.watch_id, w.security_id, s.symbol, w.action_ts
    FROM cspj_eq_watch w
    JOIN cspj_eq_security s ON w.security_id = s.security_id
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT w.watch_id, w.security_id, s.symbol, w.action_ts
    FROM cspj_eq_watch w
    JOIN cspj_eq_security s ON w.security_id = s.security_id
    EXCEPT ALL
    SELECT * FROM cspj_eq_mv
);
----
0

# A source-independent VALUES leaf is unchanged and must not emit its own N-term.
statement ok
CREATE TABLE cspj_values_customer (customer_id INT, credit VARCHAR, last_name VARCHAR);

statement ok
INSERT INTO cspj_values_customer VALUES (1, 'GC', 'Able'), (2, 'XX', 'Cross');

statement ok
CREATE MATERIALIZED VIEW cspj_values_mv AS
    SELECT c.customer_id, c.last_name, v.priority
    FROM cspj_values_customer c
    JOIN (VALUES ('GC', 1), ('BC', 2)) AS v(credit, priority)
      ON c.credit = v.credit;

query I
SELECT CASE WHEN COUNT(*) = 1 AND
                 bool_and(contains(sql, 'openivm_delta_cspj_values_customer')) AND
                 bool_and(NOT contains(sql, 'UNION ALL'))
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'cspj_values_mv',
    '{"target_dialect":"duckdb","compile_only":true,"delta_shape":{"cspj_values_customer":"MIXED"}}'
)
WHERE stmt_kind = 'data'
  AND contains(sql, 'INSERT INTO openivm_delta_cspj_values_mv');
----
1

query I
SELECT CASE WHEN COUNT(*) = 1 AND
                 bool_and(contains(sql, 'openivm_delta_cspj_values_customer')) AND
                 bool_and(NOT contains(sql, 'UNION ALL'))
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'cspj_values_mv',
    '{"target_dialect":"duckdb","compile_only":true,"delta_shape":{"cspj_values_customer":"UNCHANGED"}}'
)
WHERE stmt_kind = 'data'
  AND contains(sql, 'INSERT INTO openivm_delta_cspj_values_mv');
----
1

statement ok
UPDATE cspj_values_customer SET credit = 'GC' WHERE customer_id = 2;

statement ok
PRAGMA refresh('cspj_values_mv');

query I
SELECT COUNT(*) FROM (
    SELECT * FROM cspj_values_mv
    EXCEPT ALL
    SELECT c.customer_id, c.last_name, v.priority
    FROM cspj_values_customer c
    JOIN (VALUES ('GC', 1), ('BC', 2)) AS v(credit, priority)
      ON c.credit = v.credit
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT c.customer_id, c.last_name, v.priority
    FROM cspj_values_customer c
    JOIN (VALUES ('GC', 1), ('BC', 2)) AS v(credit, priority)
      ON c.credit = v.credit
