statement ok
SET openivm_skip_empty_deltas = true;

statement ok
CREATE OR REPLACE MATERIALIZED VIEW dl.s1.counted AS SELECT grp, COUNT(*) AS n FROM dl.s1.items GROUP BY grp;

query I
