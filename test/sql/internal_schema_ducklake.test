# A failed lake CTAS rolls back physical state before cleanup and retry.
statement ok
CREATE TABLE dl.s1.bad_values (v VARCHAR);

statement ok
INSERT INTO dl.s1.bad_values VALUES ('10'),('bad');

statement error
CREATE MATERIALIZED VIEW dl.s1.retry_mv AS SELECT v::INTEGER AS v FROM dl.s1.bad_values;
----
Could not convert string

query II
SELECT (SELECT count(*) FROM internal_schema_host."Control Space".openivm_views WHERE view_sql_name = 'retry_mv'),
       (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'dl' AND schema_name = 'Lake Internal' AND contains(table_name, '_72657472795f6d76_'));
----
0	0

statement ok
UPDATE dl.s1.bad_values SET v = '20' WHERE v = 'bad';

statement ok
CREATE MATERIALIZED VIEW dl.s1.retry_mv AS SELECT v::INTEGER AS v FROM dl.s1.bad_values;

statement ok
INSERT INTO dl.s1.bad_values VALUES ('30'),('30');

statement ok
DELETE FROM dl.s1.bad_values WHERE v = '10';

statement ok
UPDATE dl.s1.bad_values SET v = '25' WHERE v = '20';

statement ok
PRAGMA refresh('dl.s1.retry_mv');

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.retry_mv EXCEPT ALL SELECT v::INTEGER FROM dl.s1.bad_values) UNION ALL (SELECT v::INTEGER FROM dl.s1.bad_values EXCEPT ALL SELECT * FROM dl.s1.retry_mv));
----
0

statement ok
DROP VIEW dl.s1.retry_mv;

statement ok
CREATE MATERIALIZED VIEW dl.s1.counted_drop AS SELECT grp, COUNT(DISTINCT amount) AS n FROM dl.s1.items GROUP BY grp;

# Snapshot publications and their chained views use stored internal locations.
statement ok
SET openivm_snapshot_publication = true;

statement ok
CREATE MATERIALIZED VIEW dl.s1.parent AS SELECT id, amount FROM dl.s1.items;

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.parent EXCEPT ALL SELECT id, amount FROM dl.s1.items) UNION ALL (SELECT id, amount FROM dl.s1.items EXCEPT ALL SELECT * FROM dl.s1.parent));
----
0

statement ok
CREATE MATERIALIZED VIEW dl."Other Schema".child AS SELECT * FROM dl.s1.parent;

query I
SELECT count(*) FROM ((SELECT * FROM dl."Other Schema".child EXCEPT ALL SELECT id, amount FROM dl.s1.items) UNION ALL (SELECT id, amount FROM dl.s1.items EXCEPT ALL SELECT * FROM dl."Other Schema".child));
----
0

query I
SELECT count(*) FROM duckdb_views() t JOIN internal_schema_host."Control Space".openivm_views v ON t.view_name = 'openivm_visible_' || v.view_name WHERE v.view_sql_name IN ('parent','child') AND t.database_name = 'dl' AND t.schema_name = 'Lake Internal';
----
2

query I
SELECT count(*) FROM duckdb_views() t JOIN internal_schema_host."Control Space".openivm_views v ON t.view_name = 'openivm_visible_' || v.view_name WHERE v.view_sql_name IN ('parent','child') AND t.database_name = 'dl' AND t.schema_name = 'Lake Internal' AND contains(t.sql, 'AT (VERSION =>');
