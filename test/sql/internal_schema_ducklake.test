# Same-named LEFT JOIN sources use qualified snapshot deltas for nullable-side
# SUM. Preserved-side SUM separately retains its existing group-recompute path.
statement ok
SET openivm_metadata_schema='Control Space';
SET openivm_internal_schema='Lake Internal';
CREATE TABLE dl.s1.preserved_items(id INTEGER, g INTEGER, x INTEGER);
CREATE TABLE dl."Other Schema".preserved_items(id INTEGER, x INTEGER);
INSERT INTO dl.s1.preserved_items VALUES (1,10,100),(1,10,100),(2,20,200),(3,30,NULL),(4,40,400);
INSERT INTO dl."Other Schema".preserved_items VALUES (2,20),(2,NULL),(3,30),(4,40);

statement ok
CREATE MATERIALIZED VIEW dl.s1.preserved_totals AS
SELECT a.g, SUM(a.x) AS "select", COUNT(a.x) AS "group", COUNT(b.id) AS matches
FROM dl.s1.preserved_items a LEFT JOIN dl."Other Schema".preserved_items b USING (id) GROUP BY a.g;

query I
SELECT type FROM internal_schema_host."Control Space".openivm_views WHERE view_sql_name='preserved_totals';
----
6

# Preserved-side SUM retains its pre-existing source-delta group recompute path.
query I
SELECT count(*) FROM internal_schema_host."Control Space".openivm_views
WHERE view_sql_name='preserved_totals' AND type=6
AND group_recompute_affected_mode='source_delta' AND leftjoin_secondary_meta_json IS NULL;
----
1

# Nullable-side SUM is supported by the incremental aggregate MERGE. Both
# sources have the same bare name; their physical identities must stay distinct.
statement ok
CREATE MATERIALIZED VIEW dl.s1.nullable_totals AS
SELECT a.id, SUM(b.x) AS "select", COUNT(b.x) AS "group", COUNT(b.id) AS matches, COUNT(*) AS row_count
FROM dl.s1.preserved_items a LEFT JOIN dl."Other Schema".preserved_items b USING (id) GROUP BY a.id;

query I
SELECT type FROM internal_schema_host."Control Space".openivm_views WHERE view_sql_name='nullable_totals';
----
0

