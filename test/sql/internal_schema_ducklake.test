----
0

statement ok
PRAGMA refresh('dl.s1.counted');

query I
SELECT count(*) FROM ((SELECT * FROM dl.s1.counted EXCEPT ALL SELECT grp, COUNT(*) FROM dl.s1.items GROUP BY grp) UNION ALL (SELECT grp, COUNT(*) FROM dl.s1.items GROUP BY grp EXCEPT ALL SELECT * FROM dl.s1.counted));
----
0

statement ok
