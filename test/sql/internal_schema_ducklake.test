# SQLLogicTest restores the saved search path before the following ATTACH runs.
# Keep it in the persistent native catalog while DuckLake is detached on restart.
statement ok
USE internal_schema_host."Control Space";

restart

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/internal_schema_lake.db' AS dl (TYPE ducklake, DATA_PATH '__TEST_DIR__/ns');

statement ok
SET openivm_cascade_refresh = 'off';

statement ok
