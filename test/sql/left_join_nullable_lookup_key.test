# A computed inner predicate must not displace a usable outer key.

statement ok
CREATE TABLE computed_a(id INTEGER,k INTEGER);

statement ok
CREATE TABLE computed_b(k INTEGER,label VARCHAR);

statement ok
CREATE TABLE computed_d(id INTEGER,label VARCHAR);

statement ok
INSERT INTO computed_a VALUES (1,NULL),(1,NULL),(2,2);

statement ok
INSERT INTO computed_b VALUES (0,'first'),(2,'second');

statement ok
INSERT INTO computed_d VALUES (1,'d1'),(2,'d2');

statement ok
CREATE MATERIALIZED VIEW computed_mv AS SELECT a.id,COALESCE(b.label,'default') AS b_label,d.label AS d_label FROM computed_a a LEFT JOIN computed_b b ON COALESCE(a.k,0)=b.k LEFT JOIN computed_d d ON a.id=d.id;

statement ok
UPDATE computed_b SET label='temporary' WHERE k=0;

statement ok
DELETE FROM computed_b WHERE k=0;

statement ok
UPDATE computed_b SET label='second_new' WHERE k=2;

statement ok
DELETE FROM computed_d WHERE id=2;

statement ok
INSERT INTO computed_d VALUES (2,'d2_new');

statement ok
PRAGMA refresh('computed_mv');

query I
SELECT COUNT(*) FROM ((SELECT * FROM computed_mv) EXCEPT ALL (SELECT a.id,COALESCE(b.label,'default') AS b_label,d.label AS d_label FROM computed_a a LEFT JOIN computed_b b ON COALESCE(a.k,0)=b.k LEFT JOIN computed_d d ON a.id=d.id));
----
0

query I
SELECT COUNT(*) FROM ((SELECT a.id,COALESCE(b.label,'default') AS b_label,d.label AS d_label FROM computed_a a LEFT JOIN computed_b b ON COALESCE(a.k,0)=b.k LEFT JOIN computed_d d ON a.id=d.id) EXCEPT ALL (SELECT * FROM computed_mv));
----
0

statement ok
INSERT INTO computed_b VALUES (0,'restored');

statement ok
