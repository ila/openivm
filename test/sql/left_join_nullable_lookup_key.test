CREATE VIEW expected_expr_multi_input AS WITH projected AS (SELECT a.id,a.id+a.offset_key AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

