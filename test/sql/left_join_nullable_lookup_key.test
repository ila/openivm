# Scalar expressions over preserved columns retain their outer refresh key.
# CASE conditions and all branches must also exclude optional dependencies.
statement ok
CREATE TABLE expr_a(id INTEGER,k INTEGER,offset_key INTEGER);

statement ok
CREATE TABLE expr_b(k INTEGER,label VARCHAR);

statement ok
CREATE TABLE expr_d(id INTEGER,label VARCHAR);

statement ok
INSERT INTO expr_a VALUES (1,NULL,1),(1,NULL,1),(2,2,2),(NULL,NULL,5),(5,0,1);

statement ok
INSERT INTO expr_b VALUES (0,'first'),(2,'second');

statement ok
