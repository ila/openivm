statement ok
DELETE FROM computed_b WHERE k=2;

statement ok
INSERT INTO computed_d VALUES (3,'d3');

statement ok
INSERT INTO computed_a VALUES (3,NULL);

statement ok
UPDATE computed_a SET k=2 WHERE id=3;

statement ok
DELETE FROM computed_a WHERE id=3;

statement ok
PRAGMA refresh('computed_mv');

