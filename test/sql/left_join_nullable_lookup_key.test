# Casts of preserved columns remain usable keys. Keep the same cast chain
# when pushing affected keys into the source, including lossy/TRY casts.

statement ok
CREATE TABLE cast_a(id INTEGER,k INTEGER);

statement ok
CREATE TABLE cast_b(k INTEGER,label VARCHAR);

statement ok
CREATE TABLE cast_d(sid VARCHAR,label VARCHAR);

statement ok
CREATE TABLE cast_flags(flag BOOLEAN,label VARCHAR);

statement ok
CREATE TABLE cast_raw(raw_id VARCHAR,k INTEGER);

statement ok
CREATE TABLE cast_numbers(tid INTEGER,label VARCHAR);

statement ok
INSERT INTO cast_a VALUES (1,NULL),(2,NULL);

statement ok
INSERT INTO cast_b VALUES (0,'first'),(2,'second');

statement ok
INSERT INTO cast_d VALUES ('1','d1'),('2','d2');

statement ok
INSERT INTO cast_flags VALUES (TRUE,'flag');

statement ok
INSERT INTO cast_raw VALUES ('1',NULL),('bad',NULL),(NULL,NULL);

statement ok
INSERT INTO cast_numbers VALUES (1,'one'),(2,'two'),(NULL,'none');

statement ok
CREATE MATERIALIZED VIEW cast_mv AS WITH p AS (SELECT a.id,CAST(CAST(a.id AS BIGINT) AS VARCHAR) AS sid,COALESCE(b.label,'default') AS b_label FROM cast_a a LEFT JOIN cast_b b ON COALESCE(a.k,0)=b.k) SELECT p.id,p.b_label,d.label FROM p LEFT JOIN cast_d d ON p.sid=d.sid;

statement ok
CREATE MATERIALIZED VIEW cast_bool_mv AS WITH p AS (SELECT a.id,CAST(a.id AS BOOLEAN) AS flag,COALESCE(b.label,'default') AS b_label FROM cast_a a LEFT JOIN cast_b b ON COALESCE(a.k,0)=b.k) SELECT p.id,p.b_label,d.label FROM p LEFT JOIN cast_flags d ON p.flag=d.flag;

statement ok
CREATE MATERIALIZED VIEW cast_try_mv AS WITH p AS (SELECT a.raw_id,TRY_CAST(CAST(a.raw_id AS VARCHAR) AS INTEGER) AS tid,COALESCE(b.label,'default') AS b_label FROM cast_raw a LEFT JOIN cast_b b ON COALESCE(a.k,0)=b.k) SELECT p.raw_id,p.b_label,d.label FROM p LEFT JOIN cast_numbers d ON p.tid IS NOT DISTINCT FROM d.tid;

statement ok
