statement ok
CREATE VIEW expected_expr_add AS WITH projected AS (SELECT a.id,a.id+1 AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE MATERIALIZED VIEW expr_add AS WITH projected AS (SELECT a.id,a.id+1 AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE VIEW expected_expr_coalesce AS WITH projected AS (SELECT a.id,COALESCE(a.id,0) AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE MATERIALIZED VIEW expr_coalesce AS WITH projected AS (SELECT a.id,COALESCE(a.id,0) AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE VIEW expected_expr_abs AS WITH projected AS (SELECT a.id,ABS(a.id) AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE MATERIALIZED VIEW expr_abs AS WITH projected AS (SELECT a.id,ABS(a.id) AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE VIEW expected_expr_multiply AS WITH projected AS (SELECT a.id,a.id*2 AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE MATERIALIZED VIEW expr_multiply AS WITH projected AS (SELECT a.id,a.id*2 AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE VIEW expected_expr_case AS WITH projected AS (SELECT a.id,CASE WHEN a.id IS NULL THEN 0 ELSE a.id END AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

statement ok
CREATE MATERIALIZED VIEW expr_case AS WITH projected AS (SELECT a.id,CASE WHEN a.id IS NULL THEN 0 ELSE a.id END AS sid,COALESCE(b.label,'default') AS b_label FROM expr_a a LEFT JOIN expr_b b ON COALESCE(a.k,0)=b.k), p AS (SELECT id,sid,b_label FROM projected) SELECT p.id,p.b_label,d.label AS d_label FROM p LEFT JOIN expr_d d ON p.sid=d.id;

