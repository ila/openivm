# Keep the selective fact ID when the inner category key is also preserved.
# One changed detail must replace one backing row, not all 1,000 category rows.

statement ok
CREATE TABLE scope_fact AS SELECT i AS id,1 AS category FROM range(1000) t(i);

statement ok
CREATE TABLE scope_category AS SELECT 1 AS category,'C' AS label;

statement ok
CREATE TABLE scope_detail AS SELECT i AS id,'D' AS label FROM range(1000) t(i);

statement ok
CREATE MATERIALIZED VIEW scope_mv AS SELECT f.id,c.label AS category_label,d.label AS detail_label FROM scope_fact f LEFT JOIN scope_category c ON f.category=c.category LEFT JOIN scope_detail d ON f.id=d.id;

statement ok
CREATE TEMP TABLE scope_previous AS SELECT id,rowid AS previous_rowid FROM openivm_data___openivm_mv_6d656d6f7279_6d61696e_73636f70655f6d76_;

