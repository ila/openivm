# name: test/sql/ducklake_left_join.test
# description: Test IVM left joins with DuckLake base tables
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake;

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_left_join.db' AS dl (TYPE ducklake);

statement ok
SET openivm_files_path = '__TEST_DIR__';

# ==========================================
# Basic LEFT JOIN
# ==========================================

statement ok
CREATE TABLE dl.customers (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE dl.orders (id INTEGER, cust_id INTEGER, amount DECIMAL(10,2));

statement ok
INSERT INTO dl.customers VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol');

statement ok
INSERT INTO dl.orders VALUES (1, 1, 100.00), (2, 1, 50.00), (3, 2, 75.00);

statement ok
CREATE MATERIALIZED VIEW dl.mv_cust_orders AS
  SELECT c.name, SUM(o.amount) as total, COUNT(o.amount) as cnt
  FROM dl.customers c LEFT JOIN dl.orders o ON c.id = o.cust_id
  GROUP BY c.name;

query III rowsort
SELECT * FROM dl.mv_cust_orders ORDER BY name;
----
Alice	150.00	2
Bob	75.00	1
Carol	NULL	0

# EXCEPT ALL
query I
SELECT count(*) FROM (
  SELECT name, total, cnt FROM dl.mv_cust_orders
  EXCEPT ALL
  SELECT c.name, SUM(o.amount), COUNT(o.amount) FROM dl.customers c LEFT JOIN dl.orders o ON c.id = o.cust_id GROUP BY c.name
);
----
0

query I
SELECT count(*) FROM (
  SELECT c.name, SUM(o.amount), COUNT(o.amount) FROM dl.customers c LEFT JOIN dl.orders o ON c.id = o.cust_id GROUP BY c.name
  EXCEPT ALL
  SELECT name, total, cnt FROM dl.mv_cust_orders
);
----
0

# ==========================================
# Runtime output-delta append guard
# ==========================================

statement ok
CREATE TABLE dl.runtime_left (id INTEGER, value VARCHAR);

statement ok
CREATE TABLE dl.runtime_right (id INTEGER, label VARCHAR);

statement ok
INSERT INTO dl.runtime_left VALUES
  (1, 'one'), (2, 'two'), (4, 'four'), (6, 'six'), (6, 'six'), (NULL, 'null-key');

statement ok
INSERT INTO dl.runtime_right VALUES (1, 'x'), (4, 'stable'), (4, 'duplicate');

statement ok
CREATE MATERIALIZED VIEW dl.mv_runtime_left_join AS
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id;

# Touch both sides so the static preserved-side fast path cannot fire. Adding
# matches to an already-matched key only produces positive output deltas. The
# duplicate right rows exercise multiplicity expansion, while the NULL-keyed
# left row remains in the materialized bag.
statement ok
INSERT INTO dl.runtime_left VALUES (NULL, 'second-null-key');

statement ok
INSERT INTO dl.runtime_right VALUES (1, 'y'), (1, 'y');

statement ok
PRAGMA refresh('mv_runtime_left_join');

query I
SELECT contains(content, 'openivm_delta_shape')
       AND contains(content, 'openivm_multiplicity < 0')
       AND contains(content, 'generate_series')
       AND NOT contains(content, 'openivm_lj_key_stats_')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_mv_runtime_left_join.sql');
----
true

query I
SELECT count(*) FROM (
  SELECT id, value, label FROM dl.mv_runtime_left_join
  EXCEPT ALL
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
);
----
0

query I
SELECT count(*) FROM (
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
  EXCEPT ALL
  SELECT id, value, label FROM dl.mv_runtime_left_join
);
----
0

# One refresh sees INSERT + DELETE + UPDATE together. Key 1 transitions from
# matched to unmatched, key 2 from unmatched to matched, and key 4 remains
# matched while both sides change. The duplicate rows exercise bag deletion;
# only the two match-transition keys should need affected-key recompute.
statement ok
INSERT INTO dl.runtime_left VALUES (3, 'three');

statement ok
UPDATE dl.runtime_left SET value = value || '-updated' WHERE id IN (2, 4);

statement ok
DELETE FROM dl.runtime_right WHERE id = 1;

statement ok
DELETE FROM dl.runtime_right WHERE id = 4 AND label = 'duplicate';

statement ok
INSERT INTO dl.runtime_right VALUES (2, 'z'), (4, 'replacement');

statement ok
PRAGMA refresh('mv_runtime_left_join');

query IIII
SELECT contains(content, 'openivm_lj_safe_net_'),
       contains(content, 'openivm_lj_key_stats_'),
       contains(content, 'WHERE NOT openivm_stats.openivm_safe'),
       contains(content, 'openivm_refresh_delta_mv_runtime_left_join')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_mv_runtime_left_join.sql');
----
true	true	true	true

query I
SELECT count(*) FROM (
  SELECT id, value, label FROM dl.mv_runtime_left_join
  EXCEPT ALL
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
);
----
0

query I
SELECT count(*) FROM (
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
  EXCEPT ALL
  SELECT id, value, label FROM dl.mv_runtime_left_join
);
----
0

# With the nullable side quiet, mixed changes on the preserved side already
# produce exact tuple deltas. The refresh skips cardinality-transition checks
# and the exhaustive tuple delete succeeds without a ranked-delete retry.
statement ok
SET openivm_profile_refresh = true;

statement ok
INSERT INTO dl.runtime_left VALUES (5, 'five');

statement ok
UPDATE dl.runtime_left SET value = 'three-updated' WHERE id = 3;

statement ok
DELETE FROM dl.runtime_left WHERE id = 2;

statement ok
PRAGMA refresh('mv_runtime_left_join');

query IIIIII
SELECT contains(content, 'openivm_lj_safe_net_'),
       contains(content, 'openivm_expected_delete_rows'),
       contains(content, 'DELETE FROM dl.main.openivm_data_mv_runtime_left_join openivm_target USING'),
       NOT contains(content, 'openivm_lj_key_stats_'),
       contains(content, 'openivm_inline_delta'),
       NOT contains(content, 'openivm_refresh_delta_mv_runtime_left_join')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_mv_runtime_left_join.sql');
----
true	true	true	true	true	true

query I
SELECT count(*)
FROM openivm_refresh_profile
WHERE view_name = 'mv_runtime_left_join' AND step_name = 'projection_delete_retry';
----
0

query I
SELECT count(*) FROM (
  SELECT id, value, label FROM dl.mv_runtime_left_join
  EXCEPT ALL
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
);
----
0

query I
SELECT count(*) FROM (
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
  EXCEPT ALL
SELECT id, value, label FROM dl.mv_runtime_left_join
);
----
0

# Identical target rows make a one-copy retraction partial. Batch conflicting
# INSERT, DELETE, and UPDATE operations before one refresh. The exhaustive
# delete over-removes, is rolled back, and the ranked bag-safe program retries.
statement ok
INSERT INTO dl.runtime_left VALUES (7, 'seven');

statement ok
UPDATE dl.runtime_left SET value = 'five-updated' WHERE id = 5;

statement ok
DELETE FROM dl.runtime_left
WHERE rowid = (SELECT min(rowid) FROM dl.runtime_left WHERE id = 6 AND value = 'six');

statement ok
PRAGMA refresh('mv_runtime_left_join');

query I
SELECT count(*)
FROM openivm_refresh_profile
WHERE view_name = 'mv_runtime_left_join' AND step_name = 'projection_delete_retry';
----
1

query I
SELECT count(*) FROM (
  SELECT id, value, label FROM dl.mv_runtime_left_join
  EXCEPT ALL
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
);
----
0

query I
SELECT count(*) FROM (
  SELECT l.id, l.value, r.label
  FROM dl.runtime_left l
  LEFT JOIN dl.runtime_right r ON l.id = r.id
  EXCEPT ALL
  SELECT id, value, label FROM dl.mv_runtime_left_join
);
----
0

statement ok
SET openivm_profile_refresh = false;

# A composite LEFT JOIN cannot use cardinality alone to prove that transition
# corrections are absent: opposite transitions can share the first key and
# cancel. It must retain affected-key recompute.
statement ok
CREATE TABLE dl.composite_left (id INTEGER, kind VARCHAR, payload VARCHAR);

statement ok
CREATE TABLE dl.composite_right (id INTEGER, kind VARCHAR, label VARCHAR);

statement ok
INSERT INTO dl.composite_left VALUES (1, 'a', 'one-a'), (1, 'b', 'one-b'), (2, 'a', 'two-a');

statement ok
INSERT INTO dl.composite_right VALUES (1, 'a', 'old-a'), (1, 'b', 'old-b');

statement ok
CREATE MATERIALIZED VIEW dl.mv_composite_left_join AS
  SELECT l.id, l.kind, l.payload, r.label
  FROM dl.composite_left l
  LEFT JOIN dl.composite_right r ON l.id = r.id AND l.kind = r.kind;

statement ok
INSERT INTO dl.composite_left VALUES (3, 'a', 'three-a');

statement ok
UPDATE dl.composite_left SET payload = 'one-a-updated' WHERE id = 1 AND kind = 'a';

statement ok
DELETE FROM dl.composite_right WHERE id = 1 AND kind = 'a';

statement ok
INSERT INTO dl.composite_right VALUES (2, 'a', 'new-two-a'), (3, 'a', 'new-three-a');

statement ok
PRAGMA refresh('mv_composite_left_join');

query I
SELECT contains(content, 'openivm_lj_src INNER JOIN openivm_affected')
       AND NOT contains(content, 'openivm_lj_key_stats_')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_mv_composite_left_join.sql');
----
true

query I
SELECT count(*) FROM (
  SELECT id, kind, payload, label FROM dl.mv_composite_left_join
  EXCEPT ALL
  SELECT l.id, l.kind, l.payload, r.label
  FROM dl.composite_left l
  LEFT JOIN dl.composite_right r ON l.id = r.id AND l.kind = r.kind
);
----
0

query I
SELECT count(*) FROM (
  SELECT l.id, l.kind, l.payload, r.label
  FROM dl.composite_left l
  LEFT JOIN dl.composite_right r ON l.id = r.id AND l.kind = r.kind
  EXCEPT ALL
  SELECT id, kind, payload, label FROM dl.mv_composite_left_join
);
----
0

# ==========================================
# Star projection: affected fact-key pushdown
# ==========================================

statement ok
CREATE TABLE dl.star_events (
  event_id INTEGER,
  account_id INTEGER,
  infrastructure_code VARCHAR,
  os_name VARCHAR,
  edition_code VARCHAR,
  meter_id INTEGER,
  amount INTEGER
);

statement ok
CREATE TABLE dl.star_accounts (account_id INTEGER, customer_key INTEGER);

statement ok
CREATE TABLE dl.star_infrastructure (provider VARCHAR, infrastructure_key INTEGER);

statement ok
CREATE TABLE dl.star_os (os_type VARCHAR, operating_system_key INTEGER);

statement ok
CREATE TABLE dl.star_edition (edition_name VARCHAR, edition_key INTEGER);

statement ok
CREATE TABLE dl.star_meter (meter_id INTEGER, meter_key INTEGER);

statement ok
CREATE TABLE dl.star_dim6 (event_id INTEGER, dim6_key INTEGER);

statement ok
CREATE TABLE dl.star_dim7 (event_id INTEGER, dim7_key INTEGER);

statement ok
CREATE TABLE dl.star_dim8 (event_id INTEGER, dim8_key INTEGER);

statement ok
CREATE TABLE dl.star_dim9 (event_id INTEGER, dim9_key INTEGER);

statement ok
CREATE TABLE dl.star_dim10 (event_id INTEGER, dim10_key INTEGER);

statement ok
INSERT INTO dl.star_events VALUES
  (1, 10, 'azure', 'linux', 'std', 1, 100),
  (2, 10, NULL, NULL, NULL, 2, 200),
  (3, 20, 'aws', 'windows', 'ent', 3, 300),
  (4, 30, 'gcp', 'linux', 'std', 4, 400);

statement ok
INSERT INTO dl.star_accounts VALUES (10, 1000), (20, 2000);

statement ok
INSERT INTO dl.star_infrastructure VALUES ('AZURE', 11), ('AWS', 12);

statement ok
INSERT INTO dl.star_os VALUES ('linux', 21), ('windows', 22);

statement ok
INSERT INTO dl.star_edition VALUES ('STD', 31), ('ENT', 32);

statement ok
INSERT INTO dl.star_meter VALUES (1, 41), (2, 42), (3, 43);

statement ok
INSERT INTO dl.star_dim6 VALUES (1, 61), (2, 62), (3, 63);

statement ok
INSERT INTO dl.star_dim7 VALUES (1, 71), (2, 72), (3, 73);

statement ok
INSERT INTO dl.star_dim8 VALUES (1, 81), (2, 82), (3, 83);

statement ok
INSERT INTO dl.star_dim9 VALUES (1, 91), (2, 92), (3, 93);

statement ok
INSERT INTO dl.star_dim10 VALUES (1, 101), (2, 102), (3, 103);

statement ok
CREATE MATERIALIZED VIEW dl.mv_star_projection AS
  WITH base_events AS (
    SELECT
      event_id,
      account_id,
      LOWER(COALESCE(infrastructure_code, 'n/a')) AS infrastructure_provider,
      LOWER(COALESCE(os_name, 'unknown')) AS os_type,
      UPPER(COALESCE(edition_code, 'UNKNOWN')) AS edition_name,
      meter_id,
      amount
    FROM dl.star_events
  )
  SELECT
    b.event_id,
    COALESCE(a.customer_key, 1) AS customer_key,
    COALESCE(i.infrastructure_key, 1) AS infrastructure_key,
    COALESCE(o.operating_system_key, 1) AS operating_system_key,
    COALESCE(e.edition_key, 1) AS edition_key,
    COALESCE(m.meter_key, 1) AS meter_key,
    COALESCE(d6.dim6_key, 1) AS dim6_key,
    COALESCE(d7.dim7_key, 1) AS dim7_key,
    COALESCE(d8.dim8_key, 1) AS dim8_key,
    COALESCE(d9.dim9_key, 1) AS dim9_key,
    COALESCE(d10.dim10_key, 1) AS dim10_key,
    b.amount
  FROM base_events b
  LEFT JOIN dl.star_accounts a ON b.account_id = a.account_id
  LEFT JOIN dl.star_infrastructure i
    ON b.infrastructure_provider = LOWER(COALESCE(i.provider, 'n/a'))
  LEFT JOIN dl.star_os o ON b.os_type = LOWER(COALESCE(o.os_type, 'unknown'))
  LEFT JOIN dl.star_edition e ON b.edition_name = UPPER(COALESCE(e.edition_name, 'UNKNOWN'))
  LEFT JOIN dl.star_meter m ON b.meter_id = m.meter_id
  LEFT JOIN dl.star_dim6 d6 ON b.event_id = d6.event_id
  LEFT JOIN dl.star_dim7 d7 ON b.event_id = d7.event_id
  LEFT JOIN dl.star_dim8 d8 ON b.event_id = d8.event_id
  LEFT JOIN dl.star_dim9 d9 ON b.event_id = d9.event_id
  LEFT JOIN dl.star_dim10 d10 ON b.event_id = d10.event_id;

query I
SELECT lineage_json LIKE '%"k":"left_join_key_source"%' FROM openivm_views
WHERE view_name = 'mv_star_projection';
----
true

# One refresh must consolidate conflicting fact and dimension changes, including
# matched-to-unmatched and unmatched-to-matched LEFT JOIN transitions.
