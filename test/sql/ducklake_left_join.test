statement ok
UPDATE dl.star_dim8 SET dim8_key = 181 WHERE event_id = 1;

statement ok
DELETE FROM dl.star_dim9 WHERE event_id = 2;

statement ok
INSERT INTO dl.star_dim10 VALUES (5, 105);

statement ok
PRAGMA refresh('mv_star_projection');

