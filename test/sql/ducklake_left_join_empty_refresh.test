# name: test/sql/ducklake_left_join_empty_refresh.test
# description: No-change refresh of a DuckLake nullable-side LEFT JOIN aggregate with empty-delta skipping disabled
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake FROM '{BUILD_DIRECTORY}/repository';

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_left_join_empty_refresh.db' AS dl (TYPE ducklake);

statement ok
SET openivm_disable_daemon=true;

statement ok
SET openivm_cascade_refresh='off';

statement ok
SET openivm_files_path = '__TEST_DIR__';

statement ok
CREATE TABLE dl.main.a(id INTEGER);

statement ok
CREATE TABLE dl.main.b(id INTEGER, x INTEGER);

statement ok
INSERT INTO dl.main.a VALUES (1),(2);

statement ok
INSERT INTO dl.main.b VALUES (1,10);

statement ok
CREATE MATERIALIZED VIEW dl.main.mv AS
SELECT a.id, SUM(b.x) AS total, COUNT(*) AS n
FROM dl.main.a a LEFT JOIN dl.main.b b USING(id) GROUP BY a.id;

statement ok
CREATE MACRO ducklake_lj_mismatches() AS (
    SELECT count(*) FROM (
        (SELECT * FROM dl.main.mv EXCEPT ALL
         SELECT a.id, SUM(b.x), COUNT(*) FROM dl.main.a a LEFT JOIN dl.main.b b USING(id) GROUP BY a.id)
        UNION ALL
        (SELECT a.id, SUM(b.x), COUNT(*) FROM dl.main.a a LEFT JOIN dl.main.b b USING(id) GROUP BY a.id
         EXCEPT ALL SELECT * FROM dl.main.mv)
    )
);

statement ok
SET openivm_skip_empty_deltas=false;

# No change since creation
statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

query III rowsort
SELECT * FROM dl.main.mv;
----
1	10	1
2	NULL	1

# Repeated no-change refresh
statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

query III rowsort
SELECT * FROM dl.main.mv;
----
1	10	1
2	NULL	1

# Changed, then no-change
statement ok
INSERT INTO dl.main.b VALUES (2, 5), (1, 1);

statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

query III rowsort
SELECT * FROM dl.main.mv;
----
1	11	2
2	5	1

# Mixed source changes on both sides, followed by no-change refreshes
statement ok
INSERT INTO dl.main.a VALUES (3);

statement ok
DELETE FROM dl.main.b WHERE id = 2;

statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

statement ok
PRAGMA refresh('dl.main.mv');

query I
SELECT ducklake_lj_mismatches();
----
0

query III rowsort
SELECT * FROM dl.main.mv;
----
1	11	2
2	NULL	1
3	NULL	1

query I
SELECT count(*) FROM (
  SELECT id, total, n FROM dl.main.mv
  EXCEPT ALL
  SELECT a.id, SUM(b.x), COUNT(*) FROM dl.main.a a LEFT JOIN dl.main.b b USING(id) GROUP BY a.id
);
----
0

query I
SELECT count(*) FROM (
  SELECT a.id, SUM(b.x), COUNT(*) FROM dl.main.a a LEFT JOIN dl.main.b b USING(id) GROUP BY a.id
  EXCEPT ALL
  SELECT id, total, n FROM dl.main.mv
);
----
0

# The empty snapshot relation must retain non-default source and MV schemas.
statement ok
CREATE SCHEMA dl.observation;

statement ok
CREATE TABLE dl.observation.a AS SELECT * FROM dl.main.a;

statement ok
CREATE TABLE dl.observation.b AS SELECT * FROM dl.main.b;

statement ok
CREATE MATERIALIZED VIEW dl.observation.mv AS
SELECT a.id, SUM(b.x) AS total, COUNT(*) AS n
FROM dl.observation.a a LEFT JOIN dl.observation.b b USING(id) GROUP BY a.id;

loop iteration 0 2

statement ok
PRAGMA refresh('dl.observation.mv');

query I
SELECT count(*) FROM (
    (SELECT * FROM dl.observation.mv EXCEPT ALL
     SELECT a.id, SUM(b.x), COUNT(*) FROM dl.observation.a a LEFT JOIN dl.observation.b b USING(id) GROUP BY a.id)
    UNION ALL
    (SELECT a.id, SUM(b.x), COUNT(*) FROM dl.observation.a a LEFT JOIN dl.observation.b b USING(id) GROUP BY a.id
     EXCEPT ALL SELECT * FROM dl.observation.mv)
);
----
0

endloop
