# name: test/sql/ducklake_projection.test
# description: Test IVM projections with DuckLake base tables
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake;

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_projection.db' AS dl (TYPE ducklake);

# Different catalogs may contain same-named sources with independent snapshots.
statement ok
ATTACH '__TEST_DIR__/ducklake_projection_second.db' AS dl_second (TYPE ducklake);

statement ok
CREATE TABLE dl.same_name (id INTEGER);

statement ok
CREATE TABLE dl_second.same_name (id INTEGER);

# Start the catalogs at different snapshot numbers.
statement ok
INSERT INTO dl.same_name VALUES (9),(9);

statement ok
UPDATE dl.same_name SET id=8;

statement ok
DELETE FROM dl.same_name;

statement ok
CREATE MATERIALIZED VIEW colliding_ducklake_sources AS
SELECT l.id AS left_id, r.id AS right_id
FROM dl.same_name l
JOIN dl_second.same_name r ON l.id = r.id;

statement ok
INSERT INTO dl.same_name VALUES (1),(2);

statement ok
INSERT INTO dl_second.same_name VALUES (1),(1),(3);

statement ok
PRAGMA refresh('colliding_ducklake_sources');

query I
SELECT count(*) FROM ((SELECT * FROM colliding_ducklake_sources EXCEPT ALL SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id) UNION ALL (SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id EXCEPT ALL SELECT * FROM colliding_ducklake_sources));
----
0

# Independent later changes must use each catalog's own watermark.
statement ok
UPDATE dl_second.same_name SET id=2 WHERE id=1;

statement ok
DELETE FROM dl_second.same_name WHERE id=3;

statement ok
INSERT INTO dl_second.same_name VALUES(1),(2),(NULL);

statement ok
PRAGMA refresh('colliding_ducklake_sources');

query I
SELECT count(*) FROM ((SELECT * FROM colliding_ducklake_sources EXCEPT ALL SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id) UNION ALL (SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id EXCEPT ALL SELECT * FROM colliding_ducklake_sources));
----
0

statement ok
UPDATE dl.same_name SET id=3 WHERE id=1;

statement ok
DELETE FROM dl.same_name WHERE id=2;

statement ok
INSERT INTO dl.same_name VALUES(2),(2),(NULL);

statement ok
PRAGMA refresh('colliding_ducklake_sources');

query I
SELECT count(*) FROM ((SELECT * FROM colliding_ducklake_sources EXCEPT ALL SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id) UNION ALL (SELECT l.id AS left_id, r.id AS right_id FROM dl.same_name l JOIN dl_second.same_name r ON l.id=r.id EXCEPT ALL SELECT * FROM colliding_ducklake_sources));
----
0

statement ok
DROP VIEW colliding_ducklake_sources;

# ==========================================
# 1. Simple SELECT projection
# ==========================================

statement ok
CREATE TABLE dl.employees (id INT, name VARCHAR, dept VARCHAR);

statement ok
INSERT INTO dl.employees VALUES (1, 'Alice', 'eng'), (2, 'Bob', 'sales'), (3, 'Charlie', 'eng');

statement ok
CREATE MATERIALIZED VIEW dl.mv_emp AS SELECT id, name FROM dl.employees;

statement ok
SET openivm_profile_refresh = true;

# --- INSERT propagation ---
statement ok
INSERT INTO dl.employees VALUES (4, 'Diana', 'ops');

statement ok
PRAGMA refresh('mv_emp');

query I
SELECT count(*) FROM openivm_refresh_profile WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f656d70_' AND step_name IN ('metadata_pre_sql', 'metadata_post_sql');
----
2

query I
SELECT count(*) FROM openivm_refresh_profile WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f656d70_' AND step_name IN ('generate_refresh_sql', 'execute_refresh_sql', 'total_refresh') AND duration_ms >= 0;
----
3

query I
SELECT COUNT(*) FROM (
    SELECT id, name FROM dl.employees
    EXCEPT ALL
    SELECT id, name FROM dl.mv_emp
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, name FROM dl.mv_emp
    EXCEPT ALL
    SELECT id, name FROM dl.employees
);
----
0

# --- DELETE propagation ---
statement ok
DELETE FROM dl.employees WHERE id = 2;

statement ok
PRAGMA refresh('mv_emp');

query I
SELECT count(DISTINCT refresh_id) FROM openivm_refresh_profile WHERE view_name = '__openivm_mv_646c_6d61696e_6d765f656d70_';
----
2

statement ok
SET openivm_profile_refresh = false;

query I
SELECT COUNT(*) FROM (
    SELECT id, name FROM dl.employees
    EXCEPT ALL
    SELECT id, name FROM dl.mv_emp
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, name FROM dl.mv_emp
    EXCEPT ALL
    SELECT id, name FROM dl.employees
);
----
0

# ==========================================
# 2. Multi-column projection with expressions
# ==========================================

statement ok
CREATE TABLE dl.products (id INT, name VARCHAR, price DOUBLE, qty INT);

statement ok
INSERT INTO dl.products VALUES (1, 'Widget', 9.99, 100), (2, 'Gadget', 24.50, 50);

statement ok
CREATE MATERIALIZED VIEW dl.mv_prod AS
    SELECT name, price * qty AS total_value, qty > 75 AS high_stock FROM dl.products;

statement ok
INSERT INTO dl.products VALUES (3, 'Gizmo', 5.00, 200);

statement ok
DELETE FROM dl.products WHERE id = 1;

statement ok
PRAGMA refresh('mv_prod');

query I
SELECT COUNT(*) FROM (
    SELECT name, price * qty AS total_value, qty > 75 AS high_stock FROM dl.products
    EXCEPT ALL
    SELECT name, total_value, high_stock FROM dl.mv_prod
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT name, total_value, high_stock FROM dl.mv_prod
    EXCEPT ALL
    SELECT name, price * qty AS total_value, qty > 75 AS high_stock FROM dl.products
);
----
0

# UPDATE a product and refresh
statement ok
UPDATE dl.products SET price = 30.00 WHERE id = 2;

statement ok
PRAGMA refresh('mv_prod');

query I
SELECT COUNT(*) FROM (
    SELECT name, price * qty AS total_value, qty > 75 AS high_stock FROM dl.products
    EXCEPT ALL
    SELECT name, total_value, high_stock FROM dl.mv_prod
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT name, total_value, high_stock FROM dl.mv_prod
    EXCEPT ALL
    SELECT name, price * qty AS total_value, qty > 75 AS high_stock FROM dl.products
);
----
0

# ==========================================
# 3. Stress test: batch INSERT + DELETE + UPDATE before single refresh
# ==========================================

statement ok
CREATE TABLE dl.stress (id INT, val VARCHAR);

statement ok
INSERT INTO dl.stress VALUES (1, 'a'), (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CREATE MATERIALIZED VIEW dl.mv_stress AS SELECT id, val FROM dl.stress;

# --- Round 1: Mixed INSERT + DELETE + UPDATE, single refresh ---
statement ok
INSERT INTO dl.stress VALUES (4, 'd'), (4, 'd'), (5, 'e');

statement ok
DELETE FROM dl.stress WHERE id = 2;

statement ok
UPDATE dl.stress SET val = 'A' WHERE id = 1;

statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.mv_stress
    EXCEPT ALL
    SELECT id, val FROM dl.stress
);
----
0

# --- Round 2: Insert + delete same rows (net zero) alongside real changes ---
statement ok
INSERT INTO dl.stress VALUES (99, 'ghost'), (99, 'ghost');

statement ok
DELETE FROM dl.stress WHERE id = 99;

statement ok
INSERT INTO dl.stress VALUES (6, 'f');

statement ok
DELETE FROM dl.stress WHERE id = 3;

statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.mv_stress
    EXCEPT ALL
    SELECT id, val FROM dl.stress
);
----
0

# --- Round 3: Conflicting ops on same row ---
statement ok
INSERT INTO dl.stress VALUES (30, 'x'), (30, 'x'), (30, 'x');

statement ok
DELETE FROM dl.stress WHERE id = 30;

statement ok
INSERT INTO dl.stress VALUES (30, 'y');

statement ok
UPDATE dl.stress SET val = 'z' WHERE id = 30;

statement ok
INSERT INTO dl.stress VALUES (30, 'z');

statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.mv_stress
    EXCEPT ALL
    SELECT id, val FROM dl.stress
);
----
0

# --- Round 4: Delete everything, refresh, re-insert ---
statement ok
DELETE FROM dl.stress;

statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM dl.mv_stress;
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

statement ok
INSERT INTO dl.stress VALUES (10, 'new'), (10, 'new'), (11, 'also');

statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.mv_stress
    EXCEPT ALL
    SELECT id, val FROM dl.stress
);
----
0

# --- Round 5: No-op refresh (no changes) ---
statement ok
PRAGMA refresh('mv_stress');

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.stress
    EXCEPT ALL
    SELECT id, val FROM dl.mv_stress
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, val FROM dl.mv_stress
    EXCEPT ALL
    SELECT id, val FROM dl.stress
);
----
0

# ==========================================
# Projection top-k: ORDER BY + LIMIT without GROUP BY
# ==========================================

statement ok
CREATE TABLE dl.topkp (id INT, name VARCHAR, score INT);

statement ok
INSERT INTO dl.topkp VALUES
    (1,'alice',80),(2,'bob',95),(3,'carol',70),(4,'dave',88),(5,'eve',92);

statement ok
CREATE MATERIALIZED VIEW dl.topkp_mv AS
    SELECT id, name, score FROM dl.topkp ORDER BY score DESC LIMIT 3;

statement ok
PRAGMA refresh('topkp_mv');

query I
SELECT COUNT(*) FROM (
    SELECT id, name, score FROM dl.topkp_mv
    EXCEPT ALL
    SELECT * FROM (SELECT id, name, score FROM dl.topkp ORDER BY score DESC LIMIT 3) _q
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM (SELECT id, name, score FROM dl.topkp ORDER BY score DESC LIMIT 3) _q
    EXCEPT ALL
    SELECT id, name, score FROM dl.topkp_mv
);
----
0

