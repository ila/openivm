# Signed publication must retract only the changed copies of duplicate tuples.
statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE TABLE dl.signed_source(k INTEGER, v INTEGER);

statement ok
INSERT INTO dl.signed_source VALUES (1,10),(1,10),(1,10),(NULL,20),(2,NULL),(3,30);

statement ok
CREATE MATERIALIZED VIEW dl.signed_parent AS SELECT k,v FROM dl.signed_source;

statement ok
CREATE MATERIALIZED VIEW dl.signed_child AS SELECT * FROM dl.signed_parent;

statement ok
INSERT INTO dl.signed_source VALUES (1,10),(NULL,20),(4,40);

statement ok
DELETE FROM dl.signed_source WHERE rowid=(SELECT min(rowid) FROM dl.signed_source WHERE k=1);

statement ok
UPDATE dl.signed_source SET v=NULL WHERE k=3;

statement ok
PRAGMA refresh('signed_parent');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.signed_parent EXCEPT ALL SELECT * FROM dl.signed_source)),
       (SELECT count(*) FROM (SELECT * FROM dl.signed_source EXCEPT ALL SELECT * FROM dl.signed_parent));
----
0	0

statement ok
DELETE FROM dl.signed_source WHERE k IS NULL;

statement ok
UPDATE dl.signed_source SET k=NULL WHERE k=4;

statement ok
INSERT INTO dl.signed_source VALUES (2,NULL);

statement ok
PRAGMA refresh('signed_parent');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.signed_parent EXCEPT ALL SELECT * FROM dl.signed_source)),
       (SELECT count(*) FROM (SELECT * FROM dl.signed_source EXCEPT ALL SELECT * FROM dl.signed_parent));
----
0	0

statement ok
PRAGMA refresh('signed_child');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.signed_child EXCEPT ALL SELECT * FROM dl.signed_source)),
       (SELECT count(*) FROM (SELECT * FROM dl.signed_source EXCEPT ALL SELECT * FROM dl.signed_child));
----
0	0

query I
SELECT NOT contains(content, 'openivm_publish_next_') AND contains(content, 'openivm_visible___openivm_mv_646c_6d61696e_7369676e65645f706172656e74_')
FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_646c_6d61696e_7369676e65645f706172656e74_.sql');
----
1

# Snapshot publication keeps one maintenance copy and a stable read boundary.
statement ok
SET openivm_snapshot_publication=true;

statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE TABLE dl.snap_source(k INTEGER, v INTEGER);

statement ok
INSERT INTO dl.snap_source VALUES (1,10),(1,10),(2,NULL),(NULL,4),(3,30);

statement ok
CREATE MATERIALIZED VIEW dl.snap_parent AS SELECT * FROM dl.snap_source;

statement ok
CREATE MATERIALIZED VIEW dl.snap_child AS SELECT * FROM dl.snap_parent;

statement ok
CREATE MATERIALIZED VIEW dl.snap_aggregate AS SELECT k, SUM(v) AS total, COUNT(*) AS n FROM dl.snap_parent GROUP BY k;

statement ok
CREATE TABLE dl.snap_dimension(k INTEGER, label VARCHAR);

statement ok
INSERT INTO dl.snap_dimension VALUES (1,'one'),(2,'two');

statement ok
CREATE MATERIALIZED VIEW dl.snap_join AS SELECT p.k,p.v,d.label FROM dl.snap_parent p JOIN dl.snap_dimension d ON p.k=d.k;

# Global publication wrappers use the existing physical path.
statement ok
CREATE MATERIALIZED VIEW dl.snap_ordered AS SELECT * FROM dl.snap_source ORDER BY k NULLS LAST, v NULLS LAST LIMIT 2;

statement ok
CREATE MATERIALIZED VIEW dl.snap_having AS SELECT k, SUM(v) AS total, COUNT(*) AS n FROM dl.snap_source GROUP BY k HAVING COUNT(*)>1;

query I
SELECT count(*) FROM duckdb_views() WHERE database_name='dl' AND view_name LIKE 'openivm_visible_%';
----
4

statement ok
SET openivm_snapshot_publication=false;

# Existing snapshot views retain their mode when the creation setting changes.
statement ok
DELETE FROM dl.snap_source WHERE k=1;

statement ok
UPDATE dl.snap_source SET k=2, v=NULL WHERE k=3;

statement ok
INSERT INTO dl.snap_source VALUES (1,10),(2,NULL),(NULL,4),(4,40);

statement ok
PRAGMA refresh('snap_parent');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_parent EXCEPT ALL SELECT * FROM dl.snap_source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_source EXCEPT ALL SELECT * FROM dl.snap_parent));
----
0	0

# Two parent publications before a delayed child refresh must preserve net bags.
statement ok
UPDATE dl.snap_source SET v=20 WHERE k=2;

statement ok
DELETE FROM dl.snap_source WHERE k IS NULL;

statement ok
INSERT INTO dl.snap_source VALUES (2,20),(2,NULL),(NULL,NULL);

statement ok
PRAGMA refresh('snap_parent');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_parent EXCEPT ALL SELECT * FROM dl.snap_source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_source EXCEPT ALL SELECT * FROM dl.snap_parent));
----
0	0

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_child EXCEPT ALL SELECT * FROM (VALUES (1,10),(1,10),(2,NULL),(NULL,4),(3,30)) t(k,v))),
       (SELECT count(*) FROM (SELECT * FROM (VALUES (1,10),(1,10),(2,NULL),(NULL,4),(3,30)) t(k,v) EXCEPT ALL SELECT * FROM dl.snap_child));
----
0	0

