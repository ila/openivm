statement ok
BEGIN;
DROP VIEW IF EXISTS s1.ownership_mv1;
DROP VIEW s1.ownership_mv2;
COMMIT;

# After the final owner is removed, no source or MV maintenance tables may leak.
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'Ownership Internal';
----
