SET openivm_internal_schema = 'Quoted Internal';

# Qualified CASCADE deletions must participate in later helper replay. Metadata
# and maintenance use different quoted schemas; the source and MV names include
# quotes and a statement separator to exercise SQL-aware registration.
statement ok
SET openivm_disable_daemon=true;
SET openivm_cascade_refresh='off';
SET openivm_metadata_schema='Control Space';
SET openivm_internal_schema='Cascade Internal';
CREATE SCHEMA "Cascade Sources";
CREATE TABLE "Cascade Sources"."a;quoted"(i INTEGER);
CREATE TABLE "Cascade Sources"."b.with""quote"(i INTEGER);
CREATE TABLE "Cascade Sources".c(i INTEGER);
INSERT INTO "Cascade Sources"."a;quoted" VALUES (1),(1),(2);
INSERT INTO "Cascade Sources"."b.with""quote" VALUES (1),(1),(2);
INSERT INTO "Cascade Sources".c VALUES (3),(3),(4);

# Direct DROP after CASCADE must roll back ownership and physical cleanup.
statement ok
CREATE MATERIALIZED VIEW s1."cascade;mv1" AS SELECT a.i FROM "Cascade Sources"."a;quoted" a JOIN "Cascade Sources"."b.with""quote" b USING(i);
CREATE MATERIALIZED VIEW s1."cascade""mv2" AS SELECT * FROM "Cascade Sources"."b.with""quote";

