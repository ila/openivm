# Control and internal schemas are independent, including auxiliary-state lifecycle.
statement ok
SET openivm_metadata_schema = 'Control Space';

statement ok
SET openivm_internal_schema = 'OpenIVM Internal';

statement ok
SET openivm_cascade_refresh = 'off';

statement ok
SET openivm_stateful_auxstate = true;

statement ok
SET openivm_distinct_aux_state = true;

statement ok
CREATE TABLE s1.aux_source (g INTEGER, x INTEGER);

statement ok
INSERT INTO s1.aux_source VALUES (1,10),(1,10),(1,20),(2,30),(3,NULL);

statement ok
CREATE MATERIALIZED VIEW s1.counted AS SELECT g, COUNT(DISTINCT x) AS n FROM s1.aux_source GROUP BY g;

statement ok
CREATE MATERIALIZED VIEW s1.deduplicated AS SELECT g, SUM(x) AS n FROM (SELECT DISTINCT g, x FROM s1.aux_source) d GROUP BY g;

query TIT
SELECT v.view_sql_name, v.type, t.schema_name FROM "Control Space".openivm_views v JOIN duckdb_tables() t ON t.table_name = CASE v.view_sql_name WHEN 'counted' THEN 'openivm_aux_' ELSE 'openivm_distinct_count_' END || v.view_name WHERE v.view_sql_name IN ('counted','deduplicated') ORDER BY v.view_sql_name;
----
counted	11	OpenIVM Internal
deduplicated	8	OpenIVM Internal

statement ok
INSERT INTO s1.aux_source VALUES (1,40),(2,30),(4,5);

statement ok
DELETE FROM s1.aux_source WHERE x = 20;

statement ok
UPDATE s1.aux_source SET x = 40 WHERE x = 10;

statement ok
PRAGMA refresh('s1.counted');

query I
SELECT count(*) FROM ((SELECT * FROM s1.counted EXCEPT ALL SELECT g, COUNT(DISTINCT x) AS n FROM s1.aux_source GROUP BY g) UNION ALL (SELECT g, COUNT(DISTINCT x) AS n FROM s1.aux_source GROUP BY g EXCEPT ALL SELECT * FROM s1.counted));
----
0

statement ok
PRAGMA refresh('s1.deduplicated');

query I
SELECT count(*) FROM ((SELECT * FROM s1.deduplicated EXCEPT ALL SELECT g, SUM(x) AS n FROM (SELECT DISTINCT g, x FROM s1.aux_source) d GROUP BY g) UNION ALL (SELECT g, SUM(x) AS n FROM (SELECT DISTINCT g, x FROM s1.aux_source) d GROUP BY g EXCEPT ALL SELECT * FROM s1.deduplicated));
----
0

# Missing auxiliary state is rebuilt in the stored internal schema.
statement ok
DROP TABLE "OpenIVM Internal".openivm_aux___openivm_mv_6f70656e69766d5f696e7465726e616c5f736368656d61_7331_636f756e746564_;

statement ok
