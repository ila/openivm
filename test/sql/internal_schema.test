    (1,'R1',100),(1,'R1',100),(1,'R1',NULL),(2,'R2',200),(4,'R4',400),(6,'R6',600),(7,'R7',700),(NULL,'RN',900);

statement ok
CREATE MATERIALIZED VIEW openivm_internal_schema.main."Outer.Groups" AS SELECT a.g AS left_group, b.g AS right_group, COUNT(DISTINCT b.x) AS distinct_values, COUNT(*) AS row_count
FROM openivm_internal_schema.s1."Outer.Items" a FULL OUTER JOIN openivm_internal_schema."Other Schema"."Outer.Items" b USING (id) GROUP BY a.g, b.g;

# This is incremental affected-group maintenance, not full/current-diff refresh.
query IT
SELECT type, group_recompute_affected_mode FROM openivm_internal_schema."Case Control".openivm_views
WHERE view_sql_name='Outer.Groups' AND view_catalog='openivm_internal_schema' AND view_schema='main';
