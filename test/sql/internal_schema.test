# One source delta and four per-view tables, including the publication delta.
# Check identities as well as cardinality so an unrelated table cannot mask a
# missing maintenance object. ROLLBACK below must restore this same inventory.
query T rowsort
SELECT replace(t.table_name, v.view_name, '<key>')
FROM duckdb_tables() t CROSS JOIN "Control Space".openivm_views v
WHERE t.database_name = current_database() AND t.schema_name = 'Transaction Internal'
AND v.view_schema = 's1' AND v.view_sql_name = 'transaction_totals';
----
openivm_data_<key>
openivm_delta_7331_transaction_source
openivm_delta_<key>
openivm_delta_openivm_visible_<key>
openivm_visible_<key>

statement ok
SET openivm_internal_schema = '';

statement ok
