statement ok
SET openivm_internal_schema = 'OpenIVM Internal';

# A rolled-back CREATE removes its internal tables and metadata.
statement ok
BEGIN TRANSACTION;

statement ok
CREATE MATERIALIZED VIEW s1.rolled_back AS SELECT id, amount FROM s1.items;

query I
SELECT count(*) FROM duckdb_tables() t JOIN main.openivm_views v ON t.table_name = 'openivm_data_' || v.view_name
WHERE v.view_sql_name = 'rolled_back' AND t.schema_name = 'OpenIVM Internal';
