    (SELECT * FROM openivm_internal_schema.main."Outer.Groups" EXCEPT ALL SELECT a.g AS left_group, b.g AS right_group, COUNT(DISTINCT b.x) AS distinct_values, COUNT(*) AS row_count
FROM openivm_internal_schema.s1."Outer.Items" a FULL OUTER JOIN openivm_internal_schema."Other Schema"."Outer.Items" b USING (id) GROUP BY a.g, b.g)
    UNION ALL
    (SELECT a.g AS left_group, b.g AS right_group, COUNT(DISTINCT b.x) AS distinct_values, COUNT(*) AS row_count
FROM openivm_internal_schema.s1."Outer.Items" a FULL OUTER JOIN openivm_internal_schema."Other Schema"."Outer.Items" b USING (id) GROUP BY a.g, b.g EXCEPT ALL SELECT * FROM openivm_internal_schema.main."Outer.Groups")
);
