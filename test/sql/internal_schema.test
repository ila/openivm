# name: test/sql/internal_schema.test
# description: openivm_internal_schema places internal maintenance tables in a dedicated schema of each data catalog; user-facing MVs stay where requested
# group: [sql]

require openivm

load __TEST_DIR__/openivm_internal_schema.db

# Replacement must retire removed-source deltas, preserve shared ownership even
# in another metadata catalog, and roll back both ownership and physical cleanup.
statement ok
SET openivm_internal_schema = 'Replacement Internal';

statement ok
CREATE SCHEMA "Replacement Sources";
CREATE TABLE "Replacement Sources".a(i INTEGER);
CREATE TABLE "Replacement Sources".b(i INTEGER);
INSERT INTO "Replacement Sources".a VALUES (1),(1),(2);
INSERT INTO "Replacement Sources".b VALUES (3),(3),(4);

statement ok
CREATE MATERIALIZED VIEW replaced_source AS SELECT * FROM "Replacement Sources".a;

statement ok
BEGIN;
CREATE OR REPLACE MATERIALIZED VIEW replaced_source AS SELECT * FROM "Replacement Sources".b;

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name='Replacement Internal' AND table_name LIKE '%_a';
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name='Replacement Internal' AND table_name LIKE '%_a';
----
1

query I
SELECT count(*) FROM ((SELECT * FROM replaced_source EXCEPT ALL SELECT * FROM "Replacement Sources".a)
UNION ALL (SELECT * FROM "Replacement Sources".a EXCEPT ALL SELECT * FROM replaced_source));
----
0

# Repeated replacement and DROP -> CREATE must distinguish the caller's own
# physical cleanup from invisible committed deltas. Exercise both colocated and
# dedicated placement, retaining and changing physical identities, and both
# transaction outcomes. Each case starts with a committed sole consumer.
statement ok
CREATE SCHEMA namespace_lifecycle;
CREATE TABLE namespace_lifecycle.a(i INTEGER);
CREATE TABLE namespace_lifecycle.b(i INTEGER);
INSERT INTO namespace_lifecycle.a VALUES (1),(1),(2);
INSERT INTO namespace_lifecycle.b VALUES (3),(3),(4);

foreach placement namespace_lifecycle NamespaceInternal

foreach recreated namespace_lifecycle NamespaceInternal

foreach outcome COMMIT ROLLBACK

statement ok
SET openivm_internal_schema = '${placement}';
CREATE MATERIALIZED VIEW "Lifecycle View" AS SELECT * FROM namespace_lifecycle.a;

statement ok
BEGIN;
CREATE OR REPLACE MATERIALIZED VIEW "Lifecycle View" AS SELECT * FROM namespace_lifecycle.b;
SET openivm_internal_schema = '${recreated}';
CREATE OR REPLACE MATERIALIZED VIEW "Lifecycle View" AS SELECT * FROM namespace_lifecycle.a;
CREATE MATERIALIZED VIEW lifecycle_sibling AS SELECT * FROM namespace_lifecycle.a;
DROP VIEW lifecycle_sibling;
${outcome};

query I
SELECT count(*) FROM ((SELECT * FROM "Lifecycle View" EXCEPT ALL SELECT * FROM namespace_lifecycle.a)
UNION ALL (SELECT * FROM namespace_lifecycle.a EXCEPT ALL SELECT * FROM "Lifecycle View"));
----
0

query I
SELECT count(DISTINCT coalesce(delta_schema, source_schema) || '.' || delta_table_name)
FROM main.openivm_delta_tables WHERE source_schema = 'namespace_lifecycle' AND table_name = 'openivm_delta_a';
----
1

# Batched conflicting writes must be captured by the surviving/recreated delta.
statement ok
INSERT INTO namespace_lifecycle.a VALUES (1),(1),(2),(8);
DELETE FROM namespace_lifecycle.a WHERE i=1;
UPDATE namespace_lifecycle.a SET i=9 WHERE i=2;
INSERT INTO namespace_lifecycle.a VALUES (9),(9);
DELETE FROM namespace_lifecycle.a WHERE i=8;

statement ok
PRAGMA refresh('"Lifecycle View"');

query I
SELECT count(*) FROM ((SELECT * FROM "Lifecycle View" EXCEPT ALL SELECT * FROM namespace_lifecycle.a)
UNION ALL (SELECT * FROM namespace_lifecycle.a EXCEPT ALL SELECT * FROM "Lifecycle View"));
----
0

statement ok
DROP VIEW "Lifecycle View";

# No delta from a removed source or an earlier placement may leak.
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name IN ('namespace_lifecycle', 'NamespaceInternal')
AND starts_with(table_name, 'openivm_');
----
0

statement ok
DELETE FROM namespace_lifecycle.a;
INSERT INTO namespace_lifecycle.a VALUES (1),(1),(2);

statement ok
SET openivm_internal_schema = '${placement}';
CREATE MATERIALIZED VIEW "Lifecycle View" AS SELECT * FROM namespace_lifecycle.a;

statement ok
BEGIN;
DROP VIEW "Lifecycle View";
SET openivm_internal_schema = '${recreated}';
CREATE MATERIALIZED VIEW "Lifecycle View" AS SELECT * FROM namespace_lifecycle.a;
CREATE MATERIALIZED VIEW lifecycle_sibling AS SELECT * FROM namespace_lifecycle.a;
DROP VIEW lifecycle_sibling;
${outcome};

query I
SELECT count(*) FROM ((SELECT * FROM "Lifecycle View" EXCEPT ALL SELECT * FROM namespace_lifecycle.a)
UNION ALL (SELECT * FROM namespace_lifecycle.a EXCEPT ALL SELECT * FROM "Lifecycle View"));
----
0

query I
SELECT count(DISTINCT coalesce(delta_schema, source_schema) || '.' || delta_table_name)
FROM main.openivm_delta_tables WHERE source_schema = 'namespace_lifecycle' AND table_name = 'openivm_delta_a';
----
1

# Batched conflicting writes must be captured by the surviving/recreated delta.
statement ok
INSERT INTO namespace_lifecycle.a VALUES (1),(1),(2),(8);
DELETE FROM namespace_lifecycle.a WHERE i=1;
UPDATE namespace_lifecycle.a SET i=9 WHERE i=2;
INSERT INTO namespace_lifecycle.a VALUES (9),(9);
DELETE FROM namespace_lifecycle.a WHERE i=8;

statement ok
PRAGMA refresh('"Lifecycle View"');

query I
SELECT count(*) FROM ((SELECT * FROM "Lifecycle View" EXCEPT ALL SELECT * FROM namespace_lifecycle.a)
UNION ALL (SELECT * FROM namespace_lifecycle.a EXCEPT ALL SELECT * FROM "Lifecycle View"));
----
0

statement ok
DROP VIEW "Lifecycle View";

# No delta from a removed source or an earlier placement may leak.
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name IN ('namespace_lifecycle', 'NamespaceInternal')
AND starts_with(table_name, 'openivm_');
----
0

statement ok
DELETE FROM namespace_lifecycle.a;
INSERT INTO namespace_lifecycle.a VALUES (1),(1),(2);

endloop

endloop

endloop

statement ok
DROP TABLE namespace_lifecycle.a;
DROP TABLE namespace_lifecycle.b;
DROP SCHEMA namespace_lifecycle;
DROP SCHEMA NamespaceInternal;
SET openivm_internal_schema = 'Replacement Internal';

# Ownership added earlier in this transaction must be visible to cleanup checks.
statement ok
BEGIN;
CREATE MATERIALIZED VIEW replacement_sibling AS SELECT * FROM "Replacement Sources".a;
CREATE OR REPLACE MATERIALIZED VIEW replaced_source AS SELECT * FROM "Replacement Sources".b;
COMMIT;

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name='Replacement Internal' AND table_name LIKE '%_a';
----
1

statement ok
DROP VIEW replacement_sibling;
CREATE OR REPLACE MATERIALIZED VIEW replaced_source AS SELECT * FROM "Replacement Sources".a;

statement ok
ATTACH ':memory:' AS replacement_consumer;
CREATE MATERIALIZED VIEW replacement_consumer.main.shared_source AS SELECT * FROM "Replacement Sources".a;

statement ok
CREATE OR REPLACE MATERIALIZED VIEW replaced_source AS SELECT * FROM "Replacement Sources".b;

# Another catalog still consumes a's existing physical delta.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='openivm_internal_schema'
AND schema_name='Replacement Internal' AND table_name LIKE '%_a';
----
1

statement ok
INSERT INTO "Replacement Sources".a VALUES (5),(5);
DELETE FROM "Replacement Sources".a WHERE i=1;
UPDATE "Replacement Sources".a SET i=6 WHERE i=2;
INSERT INTO "Replacement Sources".b VALUES (5),(5);
DELETE FROM "Replacement Sources".b WHERE i=3;
UPDATE "Replacement Sources".b SET i=6 WHERE i=4;

statement ok
PRAGMA refresh('replacement_consumer.main.shared_source');

query I
SELECT count(*) FROM ((SELECT * FROM replacement_consumer.main.shared_source EXCEPT ALL SELECT * FROM "Replacement Sources".a)
UNION ALL (SELECT * FROM "Replacement Sources".a EXCEPT ALL SELECT * FROM replacement_consumer.main.shared_source));
----
0

statement ok
PRAGMA refresh('replaced_source');

query I
SELECT count(*) FROM ((SELECT * FROM replaced_source EXCEPT ALL SELECT * FROM "Replacement Sources".b)
UNION ALL (SELECT * FROM "Replacement Sources".b EXCEPT ALL SELECT * FROM replaced_source));
----
0

statement ok
CREATE OR REPLACE MATERIALIZED VIEW replacement_consumer.main.shared_source AS SELECT * FROM "Replacement Sources".b;

# Last consumer of a was replaced. Its external delta is cleaned after commit.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='openivm_internal_schema'
AND schema_name='Replacement Internal' AND table_name LIKE '%_a';
----
0

statement ok
CREATE MATERIALIZED VIEW replacement_sentinel AS SELECT * FROM "Replacement Sources".a;
DROP VIEW replaced_source;

statement ok
BEGIN;
CREATE OR REPLACE MATERIALIZED VIEW replacement_consumer.main.shared_source AS SELECT * FROM "Replacement Sources".a;
ROLLBACK;

query I
SELECT count(*) FROM ((SELECT * FROM replacement_consumer.main.shared_source EXCEPT ALL SELECT * FROM "Replacement Sources".b)
UNION ALL (SELECT * FROM "Replacement Sources".b EXCEPT ALL SELECT * FROM replacement_consumer.main.shared_source));
----
0

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='openivm_internal_schema'
AND schema_name='Replacement Internal' AND table_name LIKE '%_b';
----
1

# A later CREATE can reuse a delta scheduled for external cleanup in the same
# transaction. Commit must re-check actual ownership before deleting that delta.
statement ok
BEGIN;
CREATE OR REPLACE MATERIALIZED VIEW replacement_consumer.main.shared_source AS SELECT * FROM "Replacement Sources".a;
CREATE MATERIALIZED VIEW replacement_consumer.main.reused_delta AS SELECT * FROM "Replacement Sources".b;
COMMIT;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='openivm_internal_schema'
AND schema_name='Replacement Internal' AND table_name LIKE '%_b';
----
1

statement ok
INSERT INTO "Replacement Sources".b VALUES (8),(8),(9);
DELETE FROM "Replacement Sources".b WHERE i=5;
UPDATE "Replacement Sources".b SET i=10 WHERE i=6;

statement ok
PRAGMA refresh('replacement_consumer.main.reused_delta');

query I
SELECT count(*) FROM ((SELECT * FROM replacement_consumer.main.reused_delta EXCEPT ALL SELECT * FROM "Replacement Sources".b)
UNION ALL (SELECT * FROM "Replacement Sources".b EXCEPT ALL SELECT * FROM replacement_consumer.main.reused_delta));
----
0

statement ok
DROP VIEW replacement_consumer.main.reused_delta;
DROP VIEW replacement_consumer.main.shared_source;
DETACH replacement_consumer;
DROP VIEW replacement_sentinel;

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name='Replacement Internal';
----
0

statement ok
DROP TABLE "Replacement Sources".a;
DROP TABLE "Replacement Sources".b;
DROP SCHEMA "Replacement Sources";
DROP SCHEMA "Replacement Internal";
SET openivm_internal_schema = '';

# A view created before the setting keeps its tables beside it and its source.
statement ok
CREATE TABLE legacy_items (id INTEGER, grp VARCHAR, amount INTEGER);

statement ok
INSERT INTO legacy_items VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 5);

statement ok
CREATE MATERIALIZED VIEW legacy_totals AS SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM legacy_items GROUP BY grp;

statement ok
SET openivm_internal_schema = 'OpenIVM Internal';

# Same-named sources and views in two schemas, a quoted schema, and a non-default search path.
statement ok
CREATE SCHEMA s1;

statement ok
CREATE SCHEMA "Other Schema";

statement ok
CREATE TABLE s1.items (id INTEGER, grp VARCHAR, amount INTEGER);

statement ok
CREATE TABLE "Other Schema".items (id INTEGER, grp VARCHAR, amount INTEGER);

statement ok
INSERT INTO s1.items VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 5);

statement ok
INSERT INTO "Other Schema".items VALUES (1, 'x', 100), (2, 'y', 200);

statement ok
SET search_path = 's1,main';

statement ok
CREATE MATERIALIZED VIEW totals AS SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM items GROUP BY grp;

statement ok
USE openivm_internal_schema."Other Schema";

statement ok
CREATE MATERIALIZED VIEW totals AS SELECT grp, SUM(amount) AS total, COUNT(*) AS cnt FROM items GROUP BY grp;

statement ok
USE openivm_internal_schema.main;

# A view over a source that already has a delta reuses it; its own tables move.
statement ok
CREATE MATERIALIZED VIEW main_totals AS SELECT grp, SUM(amount) AS total FROM legacy_items GROUP BY grp;

# User-facing views stay in their requested schemas.
query II
SELECT schema_name, view_name FROM duckdb_views() WHERE view_name IN ('totals', 'main_totals', 'legacy_totals') ORDER BY ALL;
----
Other Schema	totals
main	legacy_totals
main	main_totals
s1	totals

# Backing, MV-delta and publication tables of the new views live in the internal schema only.
query II
SELECT
    (SELECT count(*) FROM duckdb_tables() t JOIN main.openivm_views v
        ON t.table_name IN ('openivm_data_' || v.view_name, 'openivm_delta_' || v.view_name, 'openivm_visible_' || v.view_name)
     WHERE v.view_sql_name IN ('totals', 'main_totals') AND t.schema_name = 'OpenIVM Internal'),
    (SELECT count(*) FROM duckdb_tables() WHERE schema_name IN ('s1', 'Other Schema') AND starts_with(table_name, 'openivm_'));
----
9	0

query II
SELECT coalesce(view_schema, ''), coalesce(internal_schema, '') FROM main.openivm_views
WHERE view_sql_name IN ('totals', 'main_totals', 'legacy_totals') ORDER BY ALL;
----
Other Schema	OpenIVM Internal
main	(empty)
main	OpenIVM Internal
s1	OpenIVM Internal

# Same-named sources get schema-qualified deltas in the internal schema and never collide.
query I
SELECT string_agg(table_name, ',' ORDER BY table_name) FROM duckdb_tables()
WHERE schema_name = 'OpenIVM Internal' AND table_name LIKE 'openivm\_delta\_%\_items' ESCAPE '\';
----
openivm_delta_6f7468657220736368656d61_items,openivm_delta_7331_items

query III
SELECT v.view_schema, d.source_schema, d.delta_schema FROM main.openivm_delta_tables d JOIN main.openivm_views v USING (view_name)
WHERE v.view_sql_name = 'totals' ORDER BY ALL;
----
Other Schema	Other Schema	OpenIVM Internal
s1	s1	OpenIVM Internal

# The existing delta beside legacy_items is shared, not duplicated.
query III
SELECT
    (SELECT count(*) FROM main.openivm_delta_tables d JOIN main.openivm_views v USING (view_name)
     WHERE v.view_sql_name = 'main_totals' AND d.delta_schema IS NULL),
    (SELECT count(*) FROM duckdb_tables() WHERE table_name = 'openivm_delta_legacy_items' AND schema_name = 'main'),
    (SELECT count(*) FROM duckdb_tables() WHERE table_name LIKE 'openivm\_delta\_%\_legacy\_items' ESCAPE '\');
----
1	1	0

# The grouped view in main keeps its unique index on the moved backing table.
query I
SELECT count(*) FROM duckdb_indexes() i JOIN main.openivm_views v ON i.table_name = 'openivm_data_' || v.view_name
WHERE v.view_sql_name = 'main_totals' AND i.schema_name = 'OpenIVM Internal';
----
1

# Changes are captured into the moved deltas and refreshed incrementally.
statement ok
INSERT INTO s1.items VALUES (4, 'b', 7), (5, 'c', 1);

statement ok
DELETE FROM s1.items WHERE id = 1;

statement ok
UPDATE s1.items SET amount = amount * 2 WHERE grp = 'b';

statement ok
INSERT INTO "Other Schema".items VALUES (3, 'x', 1);

statement ok
DELETE FROM "Other Schema".items WHERE id = 2;

statement ok
UPDATE "Other Schema".items SET grp = 'z' WHERE id = 1;

statement ok
INSERT INTO legacy_items VALUES (4, 'c', 3), (5, 'a', 1);

statement ok
DELETE FROM legacy_items WHERE id = 2;

statement ok
UPDATE legacy_items SET amount = 50 WHERE id = 3;

query I
SELECT count(*) > 0 FROM "OpenIVM Internal".openivm_delta_7331_items;
----
true

statement ok
PRAGMA refresh('s1.totals');

statement ok
PRAGMA refresh('"Other Schema".totals');

statement ok
PRAGMA refresh('main_totals');

statement ok
PRAGMA refresh('legacy_totals');

query I
SELECT count(*) FROM ((SELECT * FROM s1.totals EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM s1.items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM s1.items GROUP BY grp EXCEPT ALL SELECT * FROM s1.totals));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM "Other Schema".totals EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM "Other Schema".items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM "Other Schema".items GROUP BY grp EXCEPT ALL SELECT * FROM "Other Schema".totals));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM main_totals EXCEPT ALL SELECT grp, SUM(amount) FROM legacy_items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount) FROM legacy_items GROUP BY grp EXCEPT ALL SELECT * FROM main_totals));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM legacy_totals EXCEPT ALL SELECT grp, SUM(amount), COUNT(*) FROM legacy_items GROUP BY grp) UNION ALL (SELECT grp, SUM(amount), COUNT(*) FROM legacy_items GROUP BY grp EXCEPT ALL SELECT * FROM legacy_totals));
----
0

# Refresh consumed the moved delta rows.
query I
SELECT count(*) FROM "OpenIVM Internal".openivm_delta_7331_items;
----
0

