# Keep preserved-side SUM coverage with its existing group-recompute path,
# alongside a supported nullable-side SUM over the same qualified sources.
# Conflicting DML changes both sources, including duplicate rows and NULLs.
statement ok
CREATE TABLE s1.preserved_items (id INTEGER, g INTEGER, x INTEGER);
CREATE TABLE "Other Schema".preserved_items (id INTEGER, x INTEGER);
INSERT INTO s1.preserved_items VALUES
    (1,10,100),(1,10,100),(2,20,200),(2,20,200),
    (3,30,NULL),(4,40,400),(5,NULL,500),(8,80,NULL);
INSERT INTO "Other Schema".preserved_items VALUES (2,20),(2,NULL),(3,30),(4,40),(8,NULL);

statement ok
CREATE MATERIALIZED VIEW s1.preserved_totals AS
SELECT a.g, SUM(a.x) AS "select", COUNT(a.x) AS "group", COUNT(b.id) AS matches
FROM s1.preserved_items a LEFT JOIN "Other Schema".preserved_items b USING (id) GROUP BY a.g;

query I
SELECT type FROM "Control Space".openivm_views WHERE view_sql_name = 'preserved_totals';
----
6

# Preserved-side SUM retains its pre-existing source-delta group recompute path.
query I
SELECT count(*) FROM "Control Space".openivm_views
WHERE view_sql_name='preserved_totals' AND type=6
AND group_recompute_affected_mode='source_delta' AND leftjoin_secondary_meta_json IS NULL;
----
1

# Nullable-side SUM is supported by the incremental aggregate MERGE. Both
# sources have the same bare name; their physical identities must stay distinct.
statement ok
CREATE MATERIALIZED VIEW s1.nullable_totals AS
SELECT a.id, SUM(b.x) AS "select", COUNT(b.x) AS "group", COUNT(b.id) AS matches, COUNT(*) AS row_count
FROM s1.preserved_items a LEFT JOIN "Other Schema".preserved_items b USING (id) GROUP BY a.id;

query I
SELECT type FROM "Control Space".openivm_views WHERE view_sql_name='nullable_totals';
----
0

# Check the complete serialized arrays without requiring the JSON extension.
query I
SELECT count(*) FROM "Control Space".openivm_views WHERE view_sql_name='nullable_totals'
AND contains(leftjoin_secondary_meta_json,
             '"inner_tables":["' || current_database() || '.\"Other Schema\".preserved_items"]')
AND contains(leftjoin_secondary_meta_json,
             '"pres_tables":["' || current_database() || '.s1.preserved_items"]');
----
1

