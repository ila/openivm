1

statement ok
ROLLBACK;

query II
SELECT
    (SELECT count(*) FROM main.openivm_views WHERE view_sql_name = 'rolled_back'),
    (SELECT count(*) FROM duckdb_views() WHERE view_name = 'rolled_back');
----
0	0

# In a catalog without the internal schema, an explicit transaction creates it and
# ROLLBACK removes it with the view's tables and the source delta.
statement ok
ATTACH '__TEST_DIR__/openivm_internal_schema_fresh.db' AS fresh_cat;

statement ok
CREATE TABLE fresh_cat.main.fresh_src (id INTEGER);

statement ok
INSERT INTO fresh_cat.main.fresh_src VALUES (1), (1), (2);

statement ok
BEGIN TRANSACTION;

statement ok
CREATE MATERIALIZED VIEW fresh_cat.main.fresh_mv AS SELECT id FROM fresh_cat.main.fresh_src;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'fresh_cat' AND schema_name = 'OpenIVM Internal'
  AND table_name = 'openivm_delta_6d61696e_fresh_src';
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'fresh_cat' AND schema_name = 'OpenIVM Internal';
----
0

statement ok
DETACH fresh_cat;

# DROP removes the view's internal tables and the source delta it alone used.
statement ok
DROP VIEW "Other Schema".totals;

query II
