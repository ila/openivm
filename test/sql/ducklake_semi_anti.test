# name: test/sql/ducklake_semi_anti.test
# description: Test DuckLake SEMI/ANTI aux-state refresh
# group: [sql]

require openivm

require parquet

statement ok
INSTALL ducklake;

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/ducklake_semi_anti.db' AS dl (TYPE ducklake);

statement ok
CREATE TABLE dl.dl_saj_customer (c_id INT, c_w_id INT, c_last VARCHAR);

statement ok
CREATE TABLE dl.dl_saj_order (o_id INT, o_c_id INT, o_ol_cnt INT);

statement ok
INSERT INTO dl.dl_saj_customer VALUES
    (1, 1, 'alpha'),
    (2, 1, 'beta'),
    (3, 1, 'gamma');

statement ok
INSERT INTO dl.dl_saj_order VALUES
    (10, 1, 5),
    (11, 2, 2);

statement ok
CREATE MATERIALIZED VIEW mv_dl_saj_in AS
    SELECT c.c_w_id, c.c_id, c.c_last
    FROM dl.dl_saj_customer c
    WHERE c.c_id IN (
        SELECT o.o_c_id FROM dl.dl_saj_order o WHERE o.o_ol_cnt > 3
    );

query I
SELECT type FROM openivm_views WHERE view_name = 'mv_dl_saj_in';
----
9

statement ok
INSERT INTO dl.dl_saj_customer VALUES (4, 1, 'delta');

statement ok
INSERT INTO dl.dl_saj_order VALUES (12, 4, 6), (13, 3, 8);

statement ok
UPDATE dl.dl_saj_order SET o_ol_cnt = 7 WHERE o_id = 11;

statement ok
UPDATE dl.dl_saj_customer SET c_last = 'gamma-x' WHERE c_id = 3;

statement ok
DELETE FROM dl.dl_saj_order WHERE o_id = 10;

statement ok
DELETE FROM dl.dl_saj_customer WHERE c_id = 1;

statement ok
PRAGMA refresh('mv_dl_saj_in');

query I
SELECT COUNT(*) FROM (
    SELECT c.c_w_id, c.c_id, c.c_last
    FROM dl.dl_saj_customer c
    WHERE c.c_id IN (
        SELECT o.o_c_id FROM dl.dl_saj_order o WHERE o.o_ol_cnt > 3
    )
    EXCEPT ALL
    SELECT * FROM mv_dl_saj_in
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM mv_dl_saj_in
    EXCEPT ALL
    SELECT c.c_w_id, c.c_id, c.c_last
    FROM dl.dl_saj_customer c
    WHERE c.c_id IN (
        SELECT o.o_c_id FROM dl.dl_saj_order o WHERE o.o_ol_cnt > 3
    )
);
----
0

# Chained DuckLake MVs must resolve snapshot metadata through their backing tables.
# Cover logical MV names on either side, repeated batches, and duplicate tuples.
# Expected results read original base tables so stale parents cannot hide a failure.
statement ok
USE dl;

statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE TABLE chain_nodes(id INT, v INT);

statement ok
CREATE TABLE chain_edges(id INT, target INT);

statement ok
CREATE TABLE chain_blocked(id INT);

statement ok
INSERT INTO chain_nodes VALUES (1,10),(2,20),(3,30);

statement ok
INSERT INTO chain_edges VALUES (1,10),(2,20);

statement ok
INSERT INTO chain_blocked VALUES (10);

statement ok
CREATE MATERIALIZED VIEW chain_left AS SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id;

statement ok
CREATE MATERIALIZED VIEW chain_right AS SELECT id FROM chain_blocked;

statement ok
CREATE MATERIALIZED VIEW chain_anti AS SELECT a.id,a.v,a.target FROM chain_left a ANTI JOIN chain_right b ON a.target=b.id;

statement ok
CREATE MATERIALIZED VIEW chain_semi AS SELECT a.id,a.v,a.target FROM chain_left a SEMI JOIN chain_right b ON a.target=b.id;

statement ok
CREATE MATERIALIZED VIEW chain_anti_base AS SELECT a.id,a.v,a.target FROM chain_left a ANTI JOIN chain_blocked b ON a.target=b.id;

query I
SELECT COUNT(*) FROM memory.main.openivm_views WHERE view_name IN ('chain_anti','chain_semi','chain_anti_base') AND type=9;
----
3

statement ok
INSERT INTO chain_nodes VALUES (1,5),(4,40);

statement ok
UPDATE chain_nodes SET v=v+1 WHERE id=1;

statement ok
DELETE FROM chain_nodes WHERE id=3;

statement ok
INSERT INTO chain_edges VALUES (4,40),(1,11);

statement ok
UPDATE chain_edges SET target=21 WHERE id=2;

statement ok
DELETE FROM chain_edges WHERE target=10;

statement ok
INSERT INTO chain_blocked VALUES (21),(40);

statement ok
DELETE FROM chain_blocked WHERE id=10;

statement ok
PRAGMA refresh('chain_left');

query II
SELECT (SELECT COUNT(*) FROM (SELECT * FROM chain_left EXCEPT ALL SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id)),
       (SELECT COUNT(*) FROM (SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id EXCEPT ALL SELECT * FROM chain_left));
----
0	0

statement ok
PRAGMA refresh('chain_right');

query II
SELECT (SELECT COUNT(*) FROM (SELECT * FROM chain_right EXCEPT ALL SELECT id FROM chain_blocked)),
       (SELECT COUNT(*) FROM (SELECT id FROM chain_blocked EXCEPT ALL SELECT * FROM chain_right));
----
0	0

statement ok
PRAGMA refresh('chain_anti');

query II
SELECT (SELECT COUNT(*) FROM (SELECT * FROM chain_anti EXCEPT ALL SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id ANTI JOIN chain_blocked b ON e.target=b.id)),
       (SELECT COUNT(*) FROM (SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id ANTI JOIN chain_blocked b ON e.target=b.id EXCEPT ALL SELECT * FROM chain_anti));
----
0	0

statement ok
PRAGMA refresh('chain_anti_base');

query II
SELECT (SELECT COUNT(*) FROM (SELECT * FROM chain_anti_base EXCEPT ALL SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id ANTI JOIN chain_blocked b ON e.target=b.id)),
       (SELECT COUNT(*) FROM (SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id ANTI JOIN chain_blocked b ON e.target=b.id EXCEPT ALL SELECT * FROM chain_anti_base));
----
0	0

statement ok
PRAGMA refresh('chain_semi');

query II
SELECT (SELECT COUNT(*) FROM (SELECT * FROM chain_semi EXCEPT ALL SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id SEMI JOIN chain_blocked b ON e.target=b.id)),
       (SELECT COUNT(*) FROM (SELECT a.id,a.v,e.target FROM chain_nodes a LEFT JOIN chain_edges e ON a.id=e.id SEMI JOIN chain_blocked b ON e.target=b.id EXCEPT ALL SELECT * FROM chain_semi));
----
0	0

