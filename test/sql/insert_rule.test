# ==========================================
# Test 12: Short table name (prefix check safety)
# ==========================================

statement ok
CREATE TABLE ab (id INT, val INT);

statement ok
CREATE TABLE openivm_delta_ab AS SELECT *, 1::INTEGER AS openivm_multiplicity, now()::timestamp AS openivm_timestamp FROM ab LIMIT 0;

statement ok
INSERT INTO ab VALUES (1, 42);

query I
SELECT count(*) FROM openivm_delta_ab;
----
1

