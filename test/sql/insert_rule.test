# ==========================================
# COMPLEX QUERY TESTS — test various SQL patterns
# ==========================================

# ==========================================
# Complex 1: DELETE with OR condition
# ==========================================

statement ok
INSERT INTO staff VALUES (90, 'OrTest1', 'eng', 10), (91, 'OrTest2', 'sales', 20), (92, 'OrTest3', 'hr', 30);

statement ok
PRAGMA refresh_options('memory', 'main', 'mv_staff');

statement ok
DELETE FROM staff WHERE id = 90 OR id = 92;

statement ok
PRAGMA refresh_options('memory', 'main', 'mv_staff');

query I
SELECT count(*) FROM (SELECT * FROM mv_staff EXCEPT ALL SELECT id, name, dept, salary FROM staff);
----
0

query I
SELECT count(*) FROM (SELECT id, name, dept, salary FROM staff EXCEPT ALL SELECT * FROM mv_staff);
----
0

# Only id=91 should remain from the 3 inserted
query I
SELECT count(*) FROM mv_staff WHERE id IN (90, 91, 92);
----
1

