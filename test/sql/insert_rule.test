# ==========================================
# Complex 8: INSERT...SELECT with aggregation
# ==========================================

statement ok
CREATE TABLE agg_target (id INT, name VARCHAR, dept VARCHAR, salary INT);

statement ok
CREATE TABLE openivm_delta_agg_target AS SELECT *, 1::INTEGER AS openivm_multiplicity, now()::timestamp AS openivm_timestamp FROM agg_target LIMIT 0;

statement ok
INSERT INTO agg_target SELECT 999, dept, dept, SUM(salary) FROM staff WHERE dept = 'eng' GROUP BY dept;

query I
SELECT count(*) FROM openivm_delta_agg_target;
----
1

# ==========================================
# Complex 9: DELETE with subquery (WHERE id IN (SELECT ...))
# ==========================================

statement ok
INSERT INTO staff VALUES (140, 'Sub1', 'temp', 1), (141, 'Sub2', 'temp', 2), (142, 'Sub3', 'keep', 3);

statement ok
PRAGMA refresh_options('memory', 'main', 'mv_staff');

# DELETE with subquery should track deleted base rows in the delta table.
statement ok
DELETE FROM staff WHERE dept IN (SELECT 'temp');

query I
SELECT count(*) FROM openivm_delta_staff WHERE dept = 'temp' AND openivm_multiplicity = -1;
----
2

statement ok
PRAGMA refresh_options('memory', 'main', 'mv_staff');

query I
SELECT count(*) FROM (SELECT * FROM mv_staff EXCEPT ALL SELECT id, name, dept, salary FROM staff);
----
0

query I
SELECT count(*) FROM (SELECT id, name, dept, salary FROM staff EXCEPT ALL SELECT * FROM mv_staff);
----
0

