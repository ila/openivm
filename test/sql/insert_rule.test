# ==========================================
# Complex 7: INSERT...SELECT with JOIN
# ==========================================

statement ok
CREATE TABLE dept_bonus (dept VARCHAR, bonus INT);

statement ok
INSERT INTO dept_bonus VALUES ('eng', 50), ('sales', 100);

statement ok
INSERT INTO staff SELECT s.id + 1000, s.name, s.dept, s.salary + d.bonus FROM staff s JOIN dept_bonus d ON s.dept = d.dept WHERE s.id = 130;

statement ok
PRAGMA refresh_options('memory', 'main', 'mv_staff');

query I
SELECT count(*) FROM (SELECT * FROM mv_staff EXCEPT ALL SELECT id, name, dept, salary FROM staff);
