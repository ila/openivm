# ==========================================
# Test 6: Cost model for DuckLake joins
# ==========================================

# After refresh, deltas are empty — IVM cost should be 0, decision = incremental
statement ok
PRAGMA refresh_cost('product_summary');

# Insert data into one table, verify cost model doesn't error with DuckLake delta cardinality
statement ok
INSERT INTO dl.sales VALUES (3, 1, 999);

statement ok
PRAGMA refresh_cost('product_summary');

# Refresh to apply the delta
statement ok
PRAGMA refresh('product_summary');

query I
SELECT COUNT(*) FROM (
    SELECT p.pname, SUM(s.revenue), COUNT(*)
    FROM dl.products p INNER JOIN dl.sales s ON p.pid = s.pid GROUP BY p.pname
    EXCEPT ALL
    SELECT pname, total_rev, sale_count FROM dl.product_summary
);
----
0

# The existing conflicting updates above must publish only the retained key scope.
query I
SELECT contains(content, 'SELECT v.* FROM (SELECT *, CAST(0 AS BIGINT) AS openivm_ordinal')
   AND contains(content, 'FROM openivm_old_affected_projection_key_holdings d WHERE')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_projection_key_holdings.sql');
----
1

# DuckLake uses the helper-connection DDL executor with measured statement profiles.
statement ok
SET openivm_profile_refresh=true;

statement ok
CREATE MATERIALIZED VIEW dl.profile_ddl_probe AS SELECT id,name FROM dl.customers;

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.profile_ddl_probe EXCEPT ALL SELECT id,name FROM dl.customers)),
       (SELECT count(*) FROM (SELECT id,name FROM dl.customers EXCEPT ALL SELECT * FROM dl.profile_ddl_probe));
----
0	0

query I
SELECT count(*) >= 3 AND bool_and(duration_ms >= 0)
FROM openivm_refresh_profile
WHERE view_name = 'profile_ddl_probe' AND step_name = 'create_mv_sql_stmt'
  AND starts_with(detail, 'phase=create_mv_user_view; statement=');
----
1

# An up-to-date metadata schema must not run ALTER migrations again.
query I
SELECT count(*) FROM openivm_refresh_profile
WHERE view_name = 'profile_ddl_probe' AND step_name = 'create_mv_sql_stmt'
  AND contains(detail, 'sql=alter table openivm_');
----
0

# Simulate an older database. Missing columns must still be migrated, independently
# for each metadata table, before creation and incremental refresh proceed.
statement ok
ALTER TABLE openivm_views DROP COLUMN pending_after_hook;

statement ok
ALTER TABLE openivm_delta_tables DROP COLUMN pending_estimate_ts;

statement ok
ALTER TABLE openivm_refresh_history DROP COLUMN strategy;

statement ok
CREATE MATERIALIZED VIEW dl.profile_migration_probe AS SELECT id,name FROM dl.customers;

query I
SELECT count(*) FROM openivm_refresh_profile
WHERE view_name = 'profile_migration_probe' AND step_name = 'create_mv_sql_stmt'
  AND contains(detail, 'sql=alter table openivm_');
----
3

