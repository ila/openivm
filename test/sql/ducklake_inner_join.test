CREATE SCHEMA dl.source_a;

statement ok
CREATE SCHEMA dl.source_b;

statement ok
CREATE TABLE dl.source_a.items(id INTEGER, v INTEGER);

statement ok
CREATE TABLE dl.source_b.items(id INTEGER, v INTEGER);

statement ok
INSERT INTO dl.source_a.items VALUES (1,10),(2,20),(3,30),(3,30), (NULL,40),(5,NULL);

statement ok
INSERT INTO dl.source_b.items VALUES (1,100),(2,200),(3,300),(3,300), (NULL,40),(5,NULL);

statement ok
CREATE MATERIALIZED VIEW dl.source_join AS SELECT a.id, a.v av, b.v bv FROM dl.source_a.items a JOIN dl.source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW dl.source_copy AS SELECT * FROM dl.source_a.items;

statement ok
CREATE MATERIALIZED VIEW dl.source_self AS SELECT a.id, a.v av, x.v xv, b.v bv FROM dl.source_a.items a JOIN dl.source_a.items x USING(id) JOIN dl.source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW dl.source_left AS SELECT a.id, a.v av, b.v bv FROM dl.source_a.items a LEFT JOIN dl.source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW dl.source_full AS SELECT a.id aid, a.v av, b.id bid, b.v bv FROM dl.source_a.items a FULL OUTER JOIN dl.source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW dl.source_aggregate AS SELECT a.id, SUM(a.v+b.v) total, COUNT(*) n FROM dl.source_a.items a JOIN dl.source_b.items b USING(id) GROUP BY a.id;

statement ok
CREATE MATERIALIZED VIEW dl.source_min AS SELECT a.id, MIN(b.v) lo FROM dl.source_a.items a JOIN dl.source_b.items b USING(id) GROUP BY a.id;

statement ok
CREATE MATERIALIZED VIEW dl.source_anti AS SELECT a.* FROM dl.source_a.items a ANTI JOIN dl.source_b.items b USING(id);

statement ok
CREATE MATERIALIZED VIEW dl.source_semi AS SELECT * FROM dl.source_a.items a SEMI JOIN dl.source_b.items b USING(id,v);

