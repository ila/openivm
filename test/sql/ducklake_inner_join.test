    SELECT p.pname, SUM(s.revenue), COUNT(*)
    FROM dl.products p INNER JOIN dl.sales s ON p.pid = s.pid GROUP BY p.pname
    EXCEPT ALL
    SELECT pname, total_rev, sale_count FROM dl.product_summary
);
----
0

# The existing conflicting updates above must publish only the retained key scope.
query I
SELECT contains(content, 'SELECT v.* FROM (SELECT *, CAST(0 AS BIGINT) AS openivm_ordinal')
   AND contains(content, 'SEMI JOIN openivm_old_affected___openivm_mv_646c_6d61696e_70726f6a656374696f6e5f6b65795f686f6c64696e6773_ d ON')
   AND contains(content, 'USING openivm_publish_changes___openivm_mv_646c_6d61696e_70726f6a656374696f6e5f6b65795f686f6c64696e6773_ d WHERE')
   AND contains(content, 'SEMI JOIN openivm_publish_changes___openivm_mv_646c_6d61696e_70726f6a656374696f6e5f6b65795f686f6c64696e6773_ d ON')
FROM read_text('__TEST_DIR__/openivm_upsert_queries___openivm_mv_646c_6d61696e_70726f6a656374696f6e5f6b65795f686f6c64696e6773_.sql');
----
1

# DuckLake uses the helper-connection DDL executor with measured statement profiles.
statement ok
SET openivm_profile_refresh=true;

statement ok
