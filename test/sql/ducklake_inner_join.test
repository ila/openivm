1

query II
SELECT (SELECT count(*) FROM dl.openivm_delta_openivm_visible_profile_ddl_probe),
       (SELECT count(*) FROM duckdb_columns() WHERE database_name = 'dl'
        AND table_name = 'openivm_delta_openivm_visible_profile_ddl_probe'
        AND column_name IN ('id', 'name', 'openivm_ordinal', 'openivm_multiplicity', 'openivm_timestamp'));
