query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.profile_ddl_probe EXCEPT ALL SELECT id,name FROM dl.customers)),
       (SELECT count(*) FROM (SELECT id,name FROM dl.customers EXCEPT ALL SELECT * FROM dl.profile_ddl_probe));
----
0	0

query I
