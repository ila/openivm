# Initial physical tables are committed together; metadata remains outside the
# DuckLake transaction. An execution failure must roll back before cleanup/retry.
query I
SELECT count(*) FROM openivm_refresh_profile
WHERE view_name='__openivm_mv_646c_6d61696e_70726f66696c655f64646c5f70726f6265_' AND step_name='create_mv_physical_commit';
----
1

# The empty maintenance companion belongs to the same physical commit.
query I
SELECT max(step_order) FILTER (WHERE step_name='create_mv_mv_delta_table')
     < min(step_order) FILTER (WHERE step_name='create_mv_physical_commit')
FROM openivm_refresh_profile
WHERE view_name='__openivm_mv_646c_6d61696e_70726f66696c655f64646c5f70726f6265_';
----
1

