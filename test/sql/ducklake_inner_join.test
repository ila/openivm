# The empty published-delta companion uses the same schema-only creation path as
# maintenance deltas. Keep the companion available for legacy delta consumers.
query I
SELECT count(*) FROM openivm_refresh_profile
WHERE view_name = '__openivm_mv_646c_6d61696e_70726f66696c655f64646c5f70726f6265_' AND step_name = 'create_mv_user_view'
  AND contains(detail, 'derived_from_data_schema=true');
----
1

query II
