statement ok
CREATE VIEW cgr_computed_query AS WITH rows AS (SELECT id+1 AS id,ts,payload FROM cgr_history) SELECT r.* FROM rows r JOIN (SELECT id,MAX(ts) ts FROM rows GROUP BY id) m ON r.id=m.id AND r.ts=m.ts;

statement ok
CREATE MATERIALIZED VIEW cgr_computed AS SELECT * FROM cgr_computed_query;

query I
SELECT COUNT(*) FROM openivm_views WHERE view_name='cgr_computed' AND group_recompute_affected_mode='direct_source_keys';
