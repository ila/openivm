# Reject cross-key/global dependencies and computed or renamed keys.
statement ok
CREATE TABLE cgr_other AS SELECT * FROM cgr_history;

statement ok
CREATE VIEW cgr_cross_key_query AS SELECT r.id,r.ts,r.payload FROM cgr_history r JOIN (SELECT id,MAX(ts) ts FROM cgr_history GROUP BY id) m ON r.payload=m.id AND r.ts=m.ts;

statement ok
CREATE MATERIALIZED VIEW cgr_cross_key AS SELECT * FROM cgr_cross_key_query;

query I
