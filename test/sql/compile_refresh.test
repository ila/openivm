# name: test/sql/compile_refresh.test
# description: openivm_compile_with_facts — compile-only refresh path (openivm-spark integration).
# group: [sql]

require openivm

statement ok
SET openivm_files_path='__TEST_DIR__';

# ==========================================
# Setup: a simple SUM/GROUP BY materialized view
# ==========================================

statement ok
CREATE TABLE sales (region VARCHAR, amount INT);

statement ok
INSERT INTO sales VALUES ('east', 100), ('west', 200);

statement ok
CREATE MATERIALIZED VIEW mv_region AS
    SELECT region, SUM(amount) AS total, COUNT(*) AS cnt FROM sales GROUP BY region;

# Snapshot the MV state before the compile call so we can prove it is
# untouched by `openivm_compile_with_facts` afterwards.
statement ok
CREATE TABLE mv_region_before AS SELECT * FROM mv_region;

# Mutate the base table — the deltas are now non-empty.
statement ok
INSERT INTO sales VALUES ('east', 50), ('north', 75);

statement ok
DELETE FROM sales WHERE region = 'west';

# ==========================================
# Test 1: openivm_compile_with_facts succeeds and emits at least one
# data-bucket row carrying the upsert SQL for the AGGREGATE_GROUP view.
# ==========================================

query ITT
SELECT refresh_type, refresh_type_name, sql
FROM openivm_compile_with_facts(
    'mv_region',
    '{"target_dialect":"duckdb","compile_only":true}'
)
WHERE stmt_kind = 'data' AND sql LIKE '%openivm_delta_mv_region%'
ORDER BY stmt_order
LIMIT 1;
----
0	AGGREGATE_GROUP	<REGEX>:.*INSERT INTO.*openivm_delta_mv_region.*

# ==========================================
# Test 2: openivm_compile_with_facts did NOT mutate the materialized view
# ==========================================

query I
SELECT (SELECT count(*) FROM ((SELECT * FROM mv_region) EXCEPT ALL (SELECT * FROM mv_region_before))) = 0 AND
       (SELECT count(*) FROM ((SELECT * FROM mv_region_before) EXCEPT ALL (SELECT * FROM mv_region))) = 0 AS unchanged;
----
true

# Sanity: the deltas are still pending — a real refresh would commit them.
query I
SELECT total FROM mv_region WHERE region = 'east';
----
100

# ==========================================
# Test 3: PRAGMA refresh still works after the table-function compile call
# (i.e. the per-call CompileFacts slot did not leak state into PRAGMA refresh)
# ==========================================

statement ok
PRAGMA refresh('mv_region');

query III
SELECT region, total, cnt FROM mv_region ORDER BY region;
----
east	150	2
north	75	1

# ==========================================
# Test 4: target_dialect='spark' — the facts.target_dialect override
# is accepted and the compile path runs cleanly. Specific identifier-quoting /
# function remap correctness is verified end-to-end in spark-ext integration tests
# (the AGGREGATE_GROUP refresh assembly happens outside lpts for this view shape;
# lpts is exercised on SIMPLE_PROJECTION / SEMI_ANTI / WINDOW shapes).
# ==========================================

statement ok
INSERT INTO sales VALUES ('mid', 11);

statement ok
SELECT count(*) FROM openivm_compile_with_facts(
    'mv_region',
    '{"target_dialect":"spark","compile_only":true}'
);

statement ok
SELECT count(*) FROM openivm_compile_with_facts(
    'mv_region',
    '{"target_dialect":"duckdb","compile_only":true}'
);

# ==========================================
# Test 5: compile-only does not specialize to local insert-only deltas
# ==========================================

statement ok
CREATE TABLE compile_only_proj_src(id INT, val VARCHAR);

statement ok
INSERT INTO compile_only_proj_src VALUES (1, 'one'), (2, 'two');

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_proj AS
    SELECT id, val FROM compile_only_proj_src;

statement ok
INSERT INTO compile_only_proj_src VALUES (3, 'three');

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%delete from %openivm_data_mv_compile_only_proj%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_proj',
    '{"target_dialect":"duckdb","compile_only":true}'
)
WHERE stmt_kind = 'data';
----
1

statement ok
CREATE TABLE compile_only_agg_src(k INT, amount INT);

statement ok
INSERT INTO compile_only_agg_src VALUES (1, 10), (2, 20);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_agg AS
    SELECT k, SUM(amount) AS total, COUNT(*) AS cnt
    FROM compile_only_agg_src
    GROUP BY k;

statement ok
INSERT INTO compile_only_agg_src VALUES (1, 5);

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%delete from %openivm_data_mv_compile_only_agg%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_agg',
    '{"target_dialect":"duckdb","compile_only":true}'
)
WHERE stmt_kind = 'data';
----
1

# ==========================================
# Test 6: forced full refresh still dispatches through the full-recompute
# compiler when compile-for-cascade asks for view deltas.
# ==========================================

statement ok
SET openivm_refresh_mode = 'full';

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%delete from openivm_data_mv_compile_only_proj;%insert into openivm_data_mv_compile_only_proj select%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%from %compile_only_proj_src%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%insert into openivm_delta_mv_compile_only_proj%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%openivm_net%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_proj',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":true}'
)
WHERE stmt_kind = 'data';
----
1

statement ok
SET openivm_refresh_mode = 'incremental';

statement ok
CREATE TABLE compile_only_left(id INT, k INT);

statement ok
CREATE TABLE compile_only_right(k INT, item INT);

statement ok
INSERT INTO compile_only_left VALUES (1, 10);

statement ok
INSERT INTO compile_only_right VALUES (10, 100), (10, 200);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_join_gr AS
    SELECT l.k, COUNT(DISTINCT r.item) AS item_count
    FROM compile_only_left l
    JOIN compile_only_right r ON l.k = r.k
    GROUP BY l.k;

statement ok
INSERT INTO compile_only_left VALUES (2, 20);

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%openivm_delta_compile_only_left%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%openivm_delta_compile_only_right%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_join_gr',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":true}'
)
WHERE stmt_kind = 'data';
----
1

# CURRENT_DIFF_RECOMPUTE coverage for ASOF views lives in compile_refresh_asof.test.

# ==========================================
# Test 6: a caller-proven insert-only batch enables the MIN/MAX MERGE
# template, including a scalar output derived from the final aggregate state.
# Without assume_insert_only, compile-only remains conservative (Test 5).
# ==========================================

statement ok
CREATE TABLE compile_only_watch_events(
    customer_id INT,
    symbol VARCHAR,
    action VARCHAR,
    event_ts TIMESTAMP
);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_watches AS
    WITH grouped AS (
        SELECT customer_id,
               symbol,
               MIN(CASE WHEN action = 'Activate' THEN event_ts END) AS placed_at,
               MAX(CASE WHEN action = 'Cancelled' THEN event_ts END) AS removed_at
        FROM compile_only_watch_events
        GROUP BY customer_id, symbol
    )
    SELECT *,
           CASE WHEN removed_at IS NULL THEN 'Active' ELSE 'Inactive' END AS status
    FROM grouped;

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%merge into %openivm_data_mv_compile_only_watches%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%delete from %openivm_data_mv_compile_only_watches%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%status = case when%removed_at%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_watches',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":false,"assume_insert_only":true}'
)
WHERE stmt_kind = 'data';
----
1

query I
SELECT CASE WHEN derived_aggregate_outputs_json LIKE '%"complete":true%' THEN 1 ELSE 0 END
FROM openivm_views WHERE view_name = 'mv_compile_only_watches';
----
1

# Unsupported scalar functions are recorded as incomplete, so even a caller-
# proven insert-only MIN/MAX batch must use exact affected-group recompute.
statement ok
CREATE TABLE compile_only_round_events(grp INTEGER, value DOUBLE);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_round AS
WITH grouped AS (
    SELECT grp, MIN(value) AS min_value
    FROM compile_only_round_events GROUP BY grp
)
SELECT grp, min_value, ROUND(min_value / 3.0, 2) AS rounded_value FROM grouped;

query I
SELECT CASE WHEN derived_aggregate_outputs_json LIKE '%"complete":false%' THEN 1 ELSE 0 END
FROM openivm_views WHERE view_name = 'mv_compile_only_round';
----
1

# An escaped `"complete":true` inside an earlier derived expression must not
# override the top-level incomplete marker and enable the MIN/MAX MERGE path.
statement ok
CREATE TABLE compile_only_escaped_metadata_events(grp INTEGER, value DOUBLE);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_escaped_metadata AS
WITH grouped AS (
    SELECT grp, MIN(value) AS min_value
    FROM compile_only_escaped_metadata_events GROUP BY grp
)
SELECT grp,
       min_value,
       '"complete":true' AS marker,
       ROUND(min_value / 3.0, 2) AS rounded_value
FROM grouped;

query I
SELECT CASE WHEN derived_aggregate_outputs_json LIKE '%"complete":false%'
                 AND derived_aggregate_outputs_json LIKE '%"column":"marker"%'
            THEN 1 ELSE 0 END
FROM openivm_views WHERE view_name = 'mv_compile_only_escaped_metadata';
----
1

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%delete from %openivm_data_mv_compile_only_escaped_metadata%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_escaped_metadata',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":false,"assume_insert_only":true}'
)
WHERE stmt_kind = 'data';
----
1

# Projection lineage must reach through pass-through wrappers so numeric
# scalar outputs are reconstructed from post-MERGE aggregate state.
statement ok
CREATE TABLE compile_only_nested_events(grp INTEGER, value INTEGER);

statement ok
CREATE MATERIALIZED VIEW mv_compile_only_nested AS
WITH grouped AS MATERIALIZED (
    SELECT grp, MAX(value) AS max_value
    FROM compile_only_nested_events GROUP BY grp
), flagged AS MATERIALIZED (
    SELECT grp, max_value,
           CASE WHEN max_value > 10 THEN 1 ELSE 0 END AS high_flag
    FROM grouped
)
SELECT * FROM flagged;

query I
SELECT CASE WHEN derived_aggregate_outputs_json LIKE '%"column":"high_flag"%'
                 AND derived_aggregate_outputs_json LIKE '%max_value%'
            THEN 1 ELSE 0 END
FROM openivm_views WHERE view_name = 'mv_compile_only_nested';
----
1

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%merge into %openivm_data_mv_compile_only_nested%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%delete from %openivm_data_mv_compile_only_nested%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%high_flag = case when%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_nested',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":false,"assume_insert_only":true}'
)
WHERE stmt_kind = 'data';
----
1

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%merge into %openivm_data_mv_compile_only_round%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%delete from %openivm_data_mv_compile_only_round%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%insert into %openivm_data_mv_compile_only_round%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_only_round',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":false,"assume_insert_only":true}'
)
WHERE stmt_kind = 'data';
----
1

# ==========================================
# Test 9: Spark projection refresh uses occurrence-aware affected keys for a
# fact-like inner join with a repeated dimension. The program snapshots old
# and new affected rows and emits a signed cascade delta instead of an N-term
# join delta.
# ==========================================

statement ok
CREATE TABLE compile_projection_holdings(
    trade_id VARCHAR,
    previous_trade_id VARCHAR,
    account_id VARCHAR,
    symbol VARCHAR,
    event_ts TIMESTAMP
);

statement ok
CREATE TABLE compile_projection_trade(sk_trade_id VARCHAR, trade_id VARCHAR);

statement ok
CREATE TABLE compile_projection_account(account_id VARCHAR, valid_from TIMESTAMP, valid_to TIMESTAMP);

statement ok
CREATE TABLE compile_projection_security(symbol VARCHAR);

statement ok
CREATE MATERIALIZED VIEW mv_compile_projection_affected AS
SELECT h.trade_id, current_trade.sk_trade_id, previous_trade.sk_trade_id AS previous_sk_trade_id
FROM compile_projection_holdings h
JOIN compile_projection_trade current_trade ON h.trade_id = current_trade.trade_id
JOIN compile_projection_trade previous_trade ON h.previous_trade_id = previous_trade.trade_id
JOIN compile_projection_account account
  ON h.account_id = account.account_id
 AND h.event_ts BETWEEN account.valid_from AND account.valid_to
JOIN compile_projection_security security ON h.symbol = security.symbol;

query I
SELECT CASE WHEN lineage_json LIKE '%"projection_key"%'
                 AND lineage_json LIKE '%"source":"compile_projection_trade","occ":"1"%'
            THEN 1 ELSE 0 END
FROM openivm_views WHERE view_name = 'mv_compile_projection_affected';
----
1

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%create or replace temp table %openivm_affected_mv_compile_projection_affected%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%create or replace temp table %openivm_old_mv_compile_projection_affected%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%create or replace temp table %openivm_new_mv_compile_projection_affected%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%openivm_delta_compile_projection_trade%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 LIKE '%insert into %openivm_delta_mv_compile_projection_affected%select *, cast(-1 as integer)%from %openivm_old_mv_compile_projection_affected%union all%select *, cast(1 as integer)%from %openivm_new_mv_compile_projection_affected%'
            AND string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%computedelta%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_projection_affected',
    '{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}'
)
WHERE stmt_kind = 'data';
----
1

# ==========================================
# Test 10: an ordinary star join without a repeated source stays on the
# regular N-term path.
# ==========================================

statement ok
CREATE MATERIALIZED VIEW mv_compile_projection_star AS
SELECT h.trade_id, current_trade.sk_trade_id
FROM compile_projection_holdings h
JOIN compile_projection_trade current_trade ON h.trade_id = current_trade.trade_id
JOIN compile_projection_account account
  ON h.account_id = account.account_id
 AND h.event_ts BETWEEN account.valid_from AND account.valid_to
JOIN compile_projection_security security ON h.symbol = security.symbol;

query I
SELECT CASE WHEN string_agg(lower(sql), ' ' ORDER BY stmt_order)
                 NOT LIKE '%openivm_affected_mv_compile_projection_star%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'mv_compile_projection_star',
    '{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}'
)
WHERE stmt_kind = 'data';
----
1

# ==========================================
# Test 11: openivm_compile_with_facts on a non-existent view fails cleanly
# ==========================================

statement error
SELECT * FROM openivm_compile_with_facts(
    'does_not_exist',
    '{"target_dialect":"duckdb","compile_only":true}'
);
----
materialized view 'does_not_exist' not found
