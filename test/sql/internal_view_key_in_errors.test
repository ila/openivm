# name: test/sql/internal_view_key_in_errors.test
# description: Errors name the user-facing materialized view, not the internal __openivm_mv_ key
# group: [sql]

require openivm

statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
CREATE TABLE t (id INT, v INT);

statement ok
INSERT INTO t VALUES (1, 10);

statement ok
CREATE MATERIALIZED VIEW mv_t AS SELECT id, SUM(v) AS s FROM t GROUP BY id;

# DROP COLUMN guard reports the qualified view_sql_name
statement error
ALTER TABLE t DROP COLUMN v;
----
referenced by materialized view 'main.mv_t'. Drop the view first.

# The blocked DROP leaves the view usable
statement ok
INSERT INTO t VALUES (1, 5);

statement ok
PRAGMA refresh('mv_t');

query I
SELECT count(*) FROM (
    SELECT id, s FROM mv_t
    EXCEPT ALL
    SELECT id, SUM(v) FROM t GROUP BY id
);
----
0

query I
SELECT count(*) FROM (
    SELECT id, SUM(v) AS s FROM t GROUP BY id
    EXCEPT ALL
    SELECT id, s FROM mv_t
);
----
0

# A refresh that fails while executing names 'main.mv_c', not the internal key.
# The cast overflows only when the delta row is processed by the refresh.
statement ok
CREATE TABLE tc (id INT, v INT);

statement ok
INSERT INTO tc VALUES (1, 1);

statement ok
CREATE MATERIALIZED VIEW mv_c AS SELECT id, CAST(v AS TINYINT) AS c FROM tc;

statement ok
INSERT INTO tc VALUES (2, 1000);

statement error
PRAGMA refresh('mv_c');
----
IVM refresh of 'main.mv_c' failed

statement error
PRAGMA refresh('main.mv_c');
----
<!REGEX>:(?s).*__openivm_mv_.*

# The guard still never leaks the internal key with several views present
statement ok
CREATE MATERIALIZED VIEW mv_h AS SELECT id, SUM(v) AS s FROM t GROUP BY id;

statement error
ALTER TABLE t DROP COLUMN v;
----
<!REGEX>:(?s).*__openivm_mv_.*

# Missing views produce the current lookup message
statement error
PRAGMA refresh('main.mv_missing');
----
check view_sql_name, view_catalog and view_schema
