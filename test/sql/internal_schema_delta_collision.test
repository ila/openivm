# Two colliding sources in one CREATE must reserve different names before DDL runs.

statement ok
SET openivm_internal_schema = 'main';

statement ok
CREATE TABLE main."7331_items" (id INTEGER, amount INTEGER);

statement ok
CREATE TABLE s1.items (id INTEGER, amount INTEGER);

statement ok
BEGIN TRANSACTION;

statement ok
CREATE MATERIALIZED VIEW s1.joined_items AS SELECT a.id, a.amount AS moved_amount, b.amount AS colocated_amount FROM s1.items a JOIN main."7331_items" b USING (id);

query I
SELECT count(DISTINCT delta_table_name) FROM main.openivm_delta_tables;
----
2

statement ok
INSERT INTO main."7331_items" VALUES (1,10),(1,10),(2,20),(3,30);

statement ok
DELETE FROM main."7331_items" WHERE id = 2;

statement ok
UPDATE main."7331_items" SET amount = amount + 1 WHERE id = 1;

statement ok
INSERT INTO s1.items VALUES (1,10),(1,10),(2,20),(3,30);

statement ok
DELETE FROM s1.items WHERE id = 2;

statement ok
UPDATE s1.items SET amount = amount + 1 WHERE id = 1;

statement ok
PRAGMA refresh('s1.joined_items');

query I
SELECT count(*) FROM ((SELECT * FROM s1.joined_items EXCEPT ALL SELECT a.id, a.amount AS moved_amount, b.amount AS colocated_amount FROM s1.items a JOIN main."7331_items" b USING (id)) UNION ALL (SELECT a.id, a.amount AS moved_amount, b.amount AS colocated_amount FROM s1.items a JOIN main."7331_items" b USING (id) EXCEPT ALL SELECT * FROM s1.joined_items));
