# name: test/sql/ducklake_chained_physical.test
# description: Chained DuckLake MV refresh with physical OpenIVM metadata database
# group: [sql]

require openivm

require parquet

load __TEST_DIR__/ducklake_chained_physical_main.db

statement ok
INSTALL ducklake;

statement ok
LOAD ducklake;

statement ok
SET openivm_cascade_refresh='off';

statement ok
ATTACH '__TEST_DIR__/ducklake_chained_physical_lake.db' AS dl (TYPE ducklake);

statement ok
CREATE SCHEMA dl.bronze;

statement ok
CREATE SCHEMA dl.silver;

statement ok
CREATE TABLE dl.bronze.src (
    dm_date DATE,
    sym VARCHAR,
    low_price INT,
    high_price INT
);

statement ok
INSERT INTO dl.bronze.src VALUES
    (DATE '2026-01-01', 'A', 10, 20),
    (DATE '2026-01-02', 'A', 8, 22);

statement ok
CREATE MATERIALIZED VIEW dl.bronze.l1 AS
SELECT dm_date, sym, low_price, high_price
FROM dl.bronze.src;

statement ok
CREATE MATERIALIZED VIEW dl.silver.l2 AS
SELECT
    dm_date,
    sym,
    low_price,
    high_price,
    MIN(low_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_low,
    MAX(high_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_high
FROM dl.bronze.l1;

statement ok
CREATE MATERIALIZED VIEW dl.silver.l3 AS
SELECT dm_date, sym, running_low, running_high
FROM dl.silver.l2;

statement ok
INSERT INTO dl.bronze.src VALUES
    (DATE '2026-01-03', 'A', 7, 25);

statement ok
PRAGMA refresh_options('dl', 'bronze', 'l1');

# The upstream DuckLake MV writes its user-facing objects and OpenIVM data/delta
# state to DuckLake. Downstream MVs track changes on the upstream DuckLake
# openivm_data_* table directly, so no companion rows are needed in openivm_delta_l1.
query I
SELECT count(*) FROM dl.bronze.openivm_delta___openivm_mv_646c_62726f6e7a65_6c31_;
----
0

statement ok
PRAGMA refresh_options('dl', 'silver', 'l2');

# Window-partition recompute updates l2 directly. Since l3 reads l2's DuckLake
# openivm_data_* table, downstream refresh can use DuckLake change tracking instead
# of companion rows in openivm_delta_l2.
query I
SELECT count(*) FROM dl.silver.openivm_delta___openivm_mv_646c_73696c766572_6c32_;
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM dl.silver.l2
    EXCEPT ALL
    SELECT
        dm_date,
        sym,
        low_price,
        high_price,
        MIN(low_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_low,
        MAX(high_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_high
    FROM dl.bronze.l1
);
----
0

statement ok
PRAGMA refresh_options('dl', 'silver', 'l3');

query I
SELECT count(*) FROM (
    SELECT * FROM dl.silver.l3
    EXCEPT ALL
    SELECT dm_date, sym, running_low, running_high
    FROM dl.silver.l2
);
----
0

query I
SELECT count(*) FROM (
    SELECT dm_date, sym, running_low, running_high
    FROM dl.silver.l2
    EXCEPT ALL
    SELECT * FROM dl.silver.l3
);
----
0

query I
SELECT count(*) FROM (
    SELECT
        dm_date,
        sym,
        low_price,
        high_price,
        MIN(low_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_low,
        MAX(high_price) OVER (PARTITION BY sym ORDER BY dm_date) AS running_high
    FROM dl.bronze.l1
    EXCEPT ALL
    SELECT * FROM dl.silver.l2
);
----
0

# Snapshot publication must survive reopening the native metadata database.
load __TEST_DIR__/snapshot_publication_host.db

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/snapshot_publication_lake.db' AS dl (TYPE ducklake);

statement ok
SET openivm_snapshot_publication=true;

statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE SCHEMA dl.snap_bronze;

statement ok
CREATE SCHEMA dl.snap_silver;

statement ok
CREATE TABLE dl.snap_bronze.source(k INTEGER, v INTEGER);

statement ok
INSERT INTO dl.snap_bronze.source VALUES (1,10),(1,10),(2,NULL);

statement ok
CREATE MATERIALIZED VIEW dl.snap_bronze.parent AS SELECT * FROM dl.snap_bronze.source;

statement ok
CREATE MATERIALIZED VIEW dl.snap_silver.child AS SELECT * FROM dl.snap_bronze.parent;

restart

statement ok
LOAD ducklake;

statement ok
ATTACH '__TEST_DIR__/snapshot_publication_lake.db' AS dl (TYPE ducklake);

statement ok
SET openivm_cascade_refresh='off';

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.parent EXCEPT ALL SELECT * FROM dl.snap_bronze.source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.source EXCEPT ALL SELECT * FROM dl.snap_bronze.parent));
----
0	0

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_silver.child EXCEPT ALL SELECT * FROM dl.snap_bronze.source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.source EXCEPT ALL SELECT * FROM dl.snap_silver.child));
----
0	0

statement ok
DELETE FROM dl.snap_bronze.source WHERE k=1;

statement ok
UPDATE dl.snap_bronze.source SET v=20 WHERE k=2;

statement ok
INSERT INTO dl.snap_bronze.source VALUES (1,11),(1,11),(NULL,NULL);

statement ok
PRAGMA refresh_options('dl','snap_bronze','parent');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.parent EXCEPT ALL SELECT * FROM dl.snap_bronze.source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.source EXCEPT ALL SELECT * FROM dl.snap_bronze.parent));
----
0	0

statement ok
PRAGMA refresh_options('dl','snap_silver','child');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM dl.snap_silver.child EXCEPT ALL SELECT * FROM dl.snap_bronze.source)),
       (SELECT count(*) FROM (SELECT * FROM dl.snap_bronze.source EXCEPT ALL SELECT * FROM dl.snap_silver.child));
----
0	0
