# name: test/sql/stateful_auxstate_count_distinct_same_name.test
# description: COUNT(DISTINCT) aux-state refresh when a group output shares its name with the distinct argument
# group: [sql]

require openivm

load __TEST_DIR__/cd_same_name.db

statement ok
SET openivm_disable_daemon=true;

statement ok
SET openivm_cascade_refresh='off';

statement ok
SET openivm_stateful_auxstate=true;

statement ok
CREATE TABLE s(i INTEGER);

statement ok
INSERT INTO s VALUES (1),(1),(2);

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT i, COUNT(DISTINCT i) AS n FROM s GROUP BY i;

statement ok
CREATE MATERIALIZED VIEW mv_alias AS SELECT i AS g, COUNT(DISTINCT i) AS n FROM s GROUP BY i;

statement ok
CREATE MATERIALIZED VIEW mv_case AS SELECT i AS "I", COUNT(DISTINCT i) AS n FROM s GROUP BY i;

query T
SELECT refresh_type_name FROM openivm_compile_with_facts('mv', '{"target_dialect":"duckdb","compile_only":true}')
WHERE stmt_kind = 'data' ORDER BY stmt_order LIMIT 1;
----
COUNT_DISTINCT_INCREMENTAL

# Aux table columns are unique and ordered (group, distinct, _count).
# The internal name encodes the attached catalog (cd_same_name = 63645f73616d655f6e616d65), not "memory".
query I
SELECT count(*) FROM duckdb_columns()
WHERE table_name = 'openivm_aux___openivm_mv_63645f73616d655f6e616d65_6d61696e_6d76_';
----
3

query I
SELECT count(DISTINCT lower(column_name)) FROM duckdb_columns()
WHERE table_name = 'openivm_aux___openivm_mv_63645f73616d655f6e616d65_6d61696e_6d76_';
----
3

# Conflicting batch: inserts, deletes and updates on the same keys.
statement ok
INSERT INTO s VALUES (1),(3),(3);

statement ok
DELETE FROM s WHERE i = 2;

statement ok
UPDATE s SET i = 4 WHERE i = 3;

statement ok
INSERT INTO s VALUES (2),(2);

statement ok
PRAGMA refresh('mv');

statement ok
PRAGMA refresh('mv_alias');

statement ok
PRAGMA refresh('mv_case');

query I
SELECT COUNT(*) FROM (SELECT i, n FROM mv EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT i, n FROM mv);
----
0

query I
SELECT COUNT(*) FROM (SELECT g, n FROM mv_alias EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT g, n FROM mv_alias);
----
0

query I
SELECT COUNT(*) FROM (SELECT "I", n FROM mv_case EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT "I", n FROM mv_case);
----
0

# Repeated refresh with no pending deltas is stable.
statement ok
PRAGMA refresh('mv');

query I
SELECT COUNT(*) FROM (SELECT i, n FROM mv EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

# Delete every row of a group, then reinsert another.
statement ok
DELETE FROM s WHERE i = 1;

statement ok
INSERT INTO s VALUES (5),(5);

statement ok
PRAGMA refresh('mv');

query I
SELECT COUNT(*) FROM (SELECT i, n FROM mv EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT i, n FROM mv);
----
0

# Pending delta survives reopen and refreshes correctly afterwards.
statement ok
INSERT INTO s VALUES (1),(6),(5);

statement ok
DELETE FROM s WHERE i = 4;

restart

statement ok
SET openivm_disable_daemon=true;

statement ok
SET openivm_cascade_refresh='off';

statement ok
SET openivm_stateful_auxstate=true;

statement ok
PRAGMA refresh('mv');

statement ok
PRAGMA refresh('mv_alias');

query I
SELECT COUNT(*) FROM (SELECT i, n FROM mv EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT i, n FROM mv);
----
0

query I
SELECT COUNT(*) FROM (SELECT g, n FROM mv_alias EXCEPT ALL SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i);
----
0

query I
SELECT COUNT(*) FROM (SELECT i, COUNT(DISTINCT i) FROM s GROUP BY i EXCEPT ALL SELECT g, n FROM mv_alias);
----
0
