           r.score,
           ROW_NUMBER() OVER (
               PARTITION BY l.grp
               ORDER BY r.score DESC NULLS LAST, l.pts, l.key_txt
           ) AS rn
    FROM cwj_nested_cast_left l
    LEFT JOIN cwj_nested_cast_right r
      ON CAST(CAST(l.key_txt AS INTEGER) AS VARCHAR) = r.key_txt
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT l.grp,
           l.key_txt,
           r.score,
