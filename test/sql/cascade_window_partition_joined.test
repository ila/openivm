# Simulate metadata written before lookup_cast was persisted. Because the raw
# key types differ, refresh must fail closed to a full recompute rather than
# inventing a VARCHAR comparison ('0300' must continue to match integer 300).
statement ok
UPDATE openivm_views
SET lineage_json = regexp_replace(lineage_json, ',"lookup_cast":"INTEGER"', '', 'g')
WHERE view_name = 'cwj_cast_int_mv';

query I
SELECT CASE WHEN
       string_agg(lower(sql), ' ' ORDER BY stmt_order) LIKE
       '%delete from %openivm_data_cwj_cast_int_mv%;%'
   AND string_agg(lower(sql), ' ' ORDER BY stmt_order) LIKE
       '%insert into %openivm_data_cwj_cast_int_mv%'
   AND string_agg(lower(sql), ' ' ORDER BY stmt_order) NOT LIKE
       '%cast%key_int%as varchar%'
   THEN 1 ELSE 0 END
FROM openivm_compile_with_facts(
    'cwj_cast_int_mv',
    '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":false}'
)
WHERE stmt_kind = 'data';
----
1

