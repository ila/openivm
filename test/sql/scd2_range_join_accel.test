# A leading equality join makes DuckDB retain the SCD2 comparisons in a FILTER.
# They must be collected during the existing join-facts traversal too.
statement ok
CREATE TABLE chained_fact(id INT, lookup_id INT, dim_id INT, dm_date DATE, amount INT);

statement ok
CREATE TABLE chained_lookup(lookup_id INT, lookup_label VARCHAR);

statement ok
CREATE TABLE chained_dim(dim_id INT, dim_label VARCHAR, effective_timestamp DATE, end_timestamp DATE);

statement ok
INSERT INTO chained_fact VALUES
    (1, 100, 10, DATE '2024-01-15', 100),
    (2, 200, 10, DATE '2024-02-15', 200);

statement ok
INSERT INTO chained_lookup VALUES (100, 'one'), (200, 'two');

statement ok
INSERT INTO chained_dim VALUES
    (10, 'old', DATE '2024-01-01', DATE '2024-01-31'),
    (10, 'current', DATE '2024-02-01', DATE '9999-12-31');

statement ok
CREATE MATERIALIZED VIEW chained_scd2 AS
    SELECT f.id, l.lookup_label, d.dim_label, f.dm_date, f.amount
    FROM chained_fact f
    JOIN chained_lookup l ON f.lookup_id = l.lookup_id
    JOIN chained_dim d
      ON f.dim_id = d.dim_id
     AND f.dm_date BETWEEN d.effective_timestamp AND d.end_timestamp;

# Batch conflicting fact and dimension mutations before one refresh.
statement ok
INSERT INTO chained_fact VALUES
    (3, 100, 10, DATE '2024-03-15', 300),
    (4, 200, 10, DATE '2024-03-20', 400);

statement ok
UPDATE chained_fact SET amount = 350 WHERE id = 3;

statement ok
DELETE FROM chained_fact WHERE id = 4;

statement ok
UPDATE chained_dim
SET end_timestamp = DATE '2024-02-29'
WHERE dim_id = 10 AND dim_label = 'current';

statement ok
INSERT INTO chained_dim VALUES (10, 'latest', DATE '2024-03-01', DATE '9999-12-31');

query I
SELECT COALESCE(bool_or(contains(sql, 'openivm_scd2_probe_min')), false)
FROM openivm_compile_with_facts('chained_scd2', '{"target_dialect":"duckdb","compile_only":true}');
----
true

statement ok
PRAGMA refresh('chained_scd2');

query I
SELECT COUNT(*) FROM (
    SELECT f.id, l.lookup_label, d.dim_label, f.dm_date, f.amount
    FROM chained_fact f
    JOIN chained_lookup l ON f.lookup_id = l.lookup_id
    JOIN chained_dim d
      ON f.dim_id = d.dim_id
     AND f.dm_date BETWEEN d.effective_timestamp AND d.end_timestamp
    EXCEPT ALL
    SELECT id, lookup_label, dim_label, dm_date, amount FROM chained_scd2
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT id, lookup_label, dim_label, dm_date, amount FROM chained_scd2
    EXCEPT ALL
    SELECT f.id, l.lookup_label, d.dim_label, f.dm_date, f.amount
    FROM chained_fact f
    JOIN chained_lookup l ON f.lookup_id = l.lookup_id
    JOIN chained_dim d
      ON f.dim_id = d.dim_id
     AND f.dm_date BETWEEN d.effective_timestamp AND d.end_timestamp
);
----
0

