statement ok
SET openivm_scd2_range_join_accel = true;

statement ok
CREATE MATERIALIZED VIEW on_mv_scd2 AS
    SELECT f.id, f.dim_id, f.dm_date, f.amount, d.attr
    FROM on_fact f
    JOIN on_dim d
      ON f.dim_id = d.dim_id
     AND f.dm_date BETWEEN d.effective_timestamp AND d.end_timestamp;

query I
