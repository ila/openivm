2	20

statement ok
ROLLBACK;

query II
SELECT id, v FROM lifecycle_refresh_mv ORDER BY id;
----
1	10

query I
SELECT count(*) FROM openivm_delta_lifecycle_refresh_src;
----
1

statement ok
PRAGMA refresh('lifecycle_refresh_mv');

query I
SELECT count(*) FROM (
    SELECT * FROM lifecycle_refresh_mv
    EXCEPT ALL
    SELECT * FROM lifecycle_refresh_src
);
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM lifecycle_refresh_src
    EXCEPT ALL
    SELECT * FROM lifecycle_refresh_mv
);
----
0

