statement ok
CREATE TABLE lifecycle_dl.lifecycle_mixed_dimension (id INTEGER, label VARCHAR);

statement ok
INSERT INTO lifecycle_dl.lifecycle_mixed_dimension VALUES (1, 'one'), (3, 'three');

statement ok
CREATE MATERIALIZED VIEW lifecycle_mixed_mv AS
SELECT n.id, d.label
FROM lifecycle_mixed_native n
LEFT JOIN lifecycle_dl.lifecycle_mixed_dimension d ON n.id = d.id;

query I
SELECT count(*) FROM (
    SELECT * FROM lifecycle_mixed_mv
    EXCEPT ALL
    SELECT n.id, d.label
    FROM lifecycle_mixed_native n
    LEFT JOIN lifecycle_dl.lifecycle_mixed_dimension d ON n.id = d.id
);
----
0

query I
