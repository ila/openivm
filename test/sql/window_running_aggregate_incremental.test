statement ok
CREATE TABLE wrnull_last(k INT,d INT,x INT);

statement ok
INSERT INTO wrnull_last VALUES (1,NULL,4),(1,NULL,4),(1,1,-2),(1,1,-2),(2,1,NULL);

statement ok
CREATE VIEW wrnull_last_rows_expected AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, AVG(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) a, COUNT(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) n FROM wrnull_last;

statement ok
CREATE MATERIALIZED VIEW wrnull_last_rows AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, AVG(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) a, COUNT(x) OVER (PARTITION BY k ORDER BY d NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) n FROM wrnull_last;

statement ok
