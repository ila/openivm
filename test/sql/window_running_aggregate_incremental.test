# NULL endpoints, mixed frames, and nested ROWS seeds. Identical peers make the
# full-query bag deterministic even though SQL leaves their relative order unspecified.
statement ok
CREATE TABLE wrnull_first(k INT,d INT,x INT);

statement ok
INSERT INTO wrnull_first VALUES (1,NULL,4),(1,NULL,4),(1,1,-2),(1,1,-2),(2,1,NULL);

statement ok
CREATE VIEW wrnull_first_rows_expected AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, AVG(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) a, COUNT(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) n FROM wrnull_first;

statement ok
CREATE MATERIALIZED VIEW wrnull_first_rows AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, AVG(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) a, COUNT(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) n FROM wrnull_first;

statement ok
CREATE VIEW wrnull_first_mixed_expected AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST) r FROM wrnull_first;

statement ok
CREATE MATERIALIZED VIEW wrnull_first_mixed AS SELECT *, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s, SUM(x) OVER (PARTITION BY k ORDER BY d NULLS FIRST) r FROM wrnull_first;

statement ok
INSERT INTO wrnull_first VALUES (1,2,2),(1,2,2),(2,2,4),(2,2,4);

statement ok
PRAGMA refresh('wrnull_first_rows');

query I
SELECT COUNT(*) FROM ((SELECT * FROM wrnull_first_rows EXCEPT ALL SELECT * FROM wrnull_first_rows_expected) UNION ALL (SELECT * FROM wrnull_first_rows_expected EXCEPT ALL SELECT * FROM wrnull_first_rows));
----
0

statement ok
PRAGMA refresh('wrnull_first_mixed');

query I
SELECT COUNT(*) FROM ((SELECT * FROM wrnull_first_mixed EXCEPT ALL SELECT * FROM wrnull_first_mixed_expected) UNION ALL (SELECT * FROM wrnull_first_mixed_expected EXCEPT ALL SELECT * FROM wrnull_first_mixed));
----
0

