statement ok
CREATE MATERIALIZED VIEW wf_desc AS SELECT *,SUM(x) OVER (PARTITION BY k ORDER BY d DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s FROM wf_source;

query I
