statement ok
CREATE MATERIALIZED VIEW wrnames_mv AS SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s FROM wrnames;

statement ok
INSERT INTO wrnames VALUES (1,3,2,99),(1,3,2,99);

statement ok
PRAGMA refresh('wrnames_mv');

query I
WITH expected AS (SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) s FROM wrnames)
SELECT COUNT(*) FROM ((SELECT * FROM wrnames_mv EXCEPT ALL SELECT * FROM expected) UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM wrnames_mv));
----
0

# Maintenance state must not depend on the public projection.
statement ok
