# Appending a NULL-only suffix retains an existing SUM, but an all-NULL partition stays NULL.
statement ok
CREATE TABLE wrai_nulls (id INT, k INT, d INT, x INT);

statement ok
INSERT INTO wrai_nulls VALUES (1,1,1,10),(2,2,1,NULL),(3,NULL,1,5);

statement ok
CREATE MATERIALIZED VIEW wrai_nulls_mv AS
SELECT id,k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d) AS s FROM wrai_nulls;

statement ok
INSERT INTO wrai_nulls VALUES (4,1,2,NULL),(5,1,3,NULL),(6,2,2,NULL),(7,NULL,2,NULL),(8,3,1,NULL);

statement ok
PRAGMA refresh('wrai_nulls_mv');

query I
SELECT COUNT(*) FROM (
 (SELECT * FROM wrai_nulls_mv EXCEPT ALL SELECT id,k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d) AS s FROM wrai_nulls)
 UNION ALL
 (SELECT id,k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d) AS s FROM wrai_nulls EXCEPT ALL SELECT * FROM wrai_nulls_mv)
);
----
0

# Conflicting changes force delta consolidation before the same window is refreshed again.
statement ok
INSERT INTO wrai_nulls VALUES (9,1,4,NULL),(10,2,3,7),(11,2,4,NULL);

statement ok
UPDATE wrai_nulls SET x=3 WHERE id=4;

statement ok
DELETE FROM wrai_nulls WHERE id IN (1,10);

statement ok
INSERT INTO wrai_nulls VALUES (1,1,1,2),(10,2,3,NULL);

statement ok
PRAGMA refresh('wrai_nulls_mv');

query I
SELECT COUNT(*) FROM (
 (SELECT * FROM wrai_nulls_mv EXCEPT ALL SELECT id,k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d) AS s FROM wrai_nulls)
 UNION ALL
 (SELECT id,k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d) AS s FROM wrai_nulls EXCEPT ALL SELECT * FROM wrai_nulls_mv)
);
----
0

# Persist ROWS peer positions: negative sums make MAX(value) an invalid final-row seed.
load __TEST_DIR__/wrai_rows.db

statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
SET openivm_running_window_incremental=true;

statement ok
SET openivm_cascade_refresh='both';

statement ok
CREATE TABLE wrai_rows(k INT,d INT,x INT);

statement ok
INSERT INTO wrai_rows VALUES (1,1,6),(1,2,-3),(1,2,-3),(2,1,NULL),(NULL,1,4);

statement ok
CREATE MATERIALIZED VIEW wrai_rows_mv AS SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s,COUNT(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS n,COUNT(*) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS rows_n,MIN(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS lo,MAX(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hi FROM wrai_rows;

statement ok
CREATE MATERIALIZED VIEW wrai_rows_child AS SELECT * FROM wrai_rows_mv;

statement ok
INSERT INTO wrai_rows VALUES (1,3,2),(1,3,2),(1,3,2),(2,2,NULL),(NULL,2,NULL);

query I
SELECT CASE WHEN string_agg(sql,' ' ORDER BY stmt_order) LIKE '%openivm_run_suffix_wrai_rows_mv%'
 AND string_agg(sql,' ' ORDER BY stmt_order) LIKE '%ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW%'
 AND string_agg(sql,' ' ORDER BY stmt_order) LIKE '%MAX_BY(%openivm_rows_position_%'
 AND string_agg(sql,' ' ORDER BY stmt_order) LIKE '%INSERT INTO openivm_delta_wrai_rows_mv%'
 THEN 1 ELSE 0 END
FROM openivm_compile_with_facts('wrai_rows_mv','{"target_dialect":"duckdb","compile_only":true,"assume_insert_only":true,"running_window_incremental":true,"force_view_delta_cascade":true}')
WHERE stmt_kind='data';
----
1

statement ok
PRAGMA refresh_pipeline('wrai_rows_child');

query I
SELECT COUNT(*) FROM ((SELECT * FROM wrai_rows_mv EXCEPT ALL SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s,COUNT(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS n,COUNT(*) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS rows_n,MIN(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS lo,MAX(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hi FROM wrai_rows) UNION ALL (SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s,COUNT(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS n,COUNT(*) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS rows_n,MIN(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS lo,MAX(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hi FROM wrai_rows EXCEPT ALL SELECT * FROM wrai_rows_mv));
----
0

query I
SELECT COUNT(*) FROM ((SELECT * FROM wrai_rows_child EXCEPT ALL SELECT k,d,x,s,n,rows_n,lo,hi FROM (SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s,COUNT(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS n,COUNT(*) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS rows_n,MIN(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS lo,MAX(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hi FROM wrai_rows) q) UNION ALL (SELECT k,d,x,s,n,rows_n,lo,hi FROM (SELECT k,d,x,SUM(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s,COUNT(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS n,COUNT(*) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS rows_n,MIN(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS lo,MAX(x) OVER (PARTITION BY k ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hi FROM wrai_rows) q EXCEPT ALL SELECT * FROM wrai_rows_child));
----
0

