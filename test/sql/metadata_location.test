0

# New views follow the marker too, so one database never splits its metadata.
statement ok
CREATE MATERIALIZED VIEW order_count AS SELECT COUNT(*) AS n, SUM(amount) AS s FROM orders;

query I
SELECT count(*) FROM control.openivm.openivm_views WHERE view_sql_name = 'order_count';
----
1

query I
SELECT count(*) FROM duckdb_tables()
WHERE database_name = 'openivm_metadata_host' AND table_name = 'openivm_views';
----
0

# Selecting a different location contradicts the durable marker.
statement ok
ATTACH ':memory:' AS other_control;

statement ok
SET openivm_metadata_catalog = 'other_control';

statement error
PRAGMA refresh('product_sales');
----
is recorded in control.openivm

statement ok
SET openivm_metadata_catalog = '';

# ==========================================
# Existing databases: configured placement refuses to coexist with views registered
# elsewhere instead of silently splitting the metadata
# ==========================================

statement ok
ATTACH ':memory:' AS legacy_db;

statement ok
CREATE TABLE legacy_db.main.legacy_src (i INTEGER);

statement ok
INSERT INTO legacy_db.main.legacy_src VALUES (1), (2);

statement ok
CREATE MATERIALIZED VIEW legacy_db.main.legacy_mv AS SELECT i FROM legacy_db.main.legacy_src;

query I
SELECT count(*) FROM legacy_db.main.openivm_views;
----
1

statement ok
SET openivm_metadata_catalog = 'control';

statement ok
SET openivm_metadata_schema = 'openivm';

statement error
CREATE MATERIALIZED VIEW blocked_mv AS SELECT product FROM orders;
----
already registered in legacy_db.main

statement ok
DETACH legacy_db;

# ==========================================
# Replacement keeps one metadata row in the configured location
# ==========================================

statement ok
CREATE OR REPLACE MATERIALIZED VIEW product_sales AS
SELECT product, SUM(amount) AS total, COUNT(*) AS cnt, SUM(id) AS ids FROM orders GROUP BY product;

query I
SELECT count(*) FROM control.openivm.openivm_views WHERE view_sql_name = 'product_sales';
----
1

statement ok
INSERT INTO orders VALUES (26, 'a', 26), (27, 'w', 27);

statement ok
UPDATE orders SET amount = amount + 5 WHERE id = 26;

statement ok
DELETE FROM orders WHERE id = 24;

statement ok
PRAGMA refresh('product_sales');

query I
SELECT (SELECT count(*) FROM (SELECT * FROM product_sales
                              EXCEPT ALL SELECT product, SUM(amount), COUNT(*), SUM(id) FROM orders GROUP BY product))
     + (SELECT count(*) FROM (SELECT product, SUM(amount), COUNT(*), SUM(id) FROM orders GROUP BY product
                              EXCEPT ALL SELECT * FROM product_sales));
----
0

# ==========================================
# Same catalog, separate schema: one database, so explicit transactions stay atomic
# ==========================================

statement ok
CREATE TABLE control.main.items (k INTEGER, v INTEGER);

statement ok
INSERT INTO control.main.items VALUES (1, 10), (1, 20), (2, 5);

statement ok
CREATE MATERIALIZED VIEW control.main.item_totals AS
SELECT k, SUM(v) AS s, COUNT(*) AS c FROM control.main.items GROUP BY k;

query I
SELECT count(*) FROM control.openivm.openivm_views WHERE view_sql_name = 'item_totals' AND view_catalog = 'control';
----
1

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'control' AND schema_name = 'main'
  AND starts_with(table_name, 'openivm_data_');
----
1

statement ok
BEGIN;

statement ok
INSERT INTO control.main.items VALUES (3, 30), (1, 1);

statement ok
PRAGMA refresh('control.main.item_totals');

statement ok
ROLLBACK;

query I
SELECT (SELECT count(*) FROM (SELECT * FROM control.main.item_totals
                              EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM control.main.items GROUP BY k))
     + (SELECT count(*) FROM (SELECT k, SUM(v), COUNT(*) FROM control.main.items GROUP BY k
                              EXCEPT ALL SELECT * FROM control.main.item_totals));
----
0

statement ok
BEGIN;

statement ok
INSERT INTO control.main.items VALUES (3, 30), (1, 1);

statement ok
DELETE FROM control.main.items WHERE k = 2;

statement ok
PRAGMA refresh('control.main.item_totals');

statement ok
COMMIT;

# The archive joined the caller transaction in the selected schema: the rolled-back
# refresh left no program, the committed one exactly one.
query I
SELECT count(*) FROM control.openivm.openivm_compiled_programs p JOIN control.openivm.openivm_views v USING (view_name)
WHERE v.view_sql_name = 'item_totals' AND p.operation = 'refresh' AND p.last_outcome = 'committed';
----
1

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'control' AND schema_name = 'main'
  AND starts_with(table_name, 'openivm_compiled_');
----
0

query I
SELECT (SELECT count(*) FROM (SELECT * FROM control.main.item_totals
                              EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM control.main.items GROUP BY k))
     + (SELECT count(*) FROM (SELECT k, SUM(v), COUNT(*) FROM control.main.items GROUP BY k
                              EXCEPT ALL SELECT * FROM control.main.item_totals));
----
0

# ==========================================
# DROP removes data objects first, then metadata; DROP VIEW IF EXISTS finishes an
# interrupted drop whose view is already gone
# ==========================================

statement ok
DROP VIEW control.main.item_totals;

statement ok
DROP VIEW order_count;

statement ok
DROP VIEW product_sales;

query I
SELECT count(*) FROM control.openivm.openivm_views;
----
0

query I
SELECT count(*) FROM control.openivm.openivm_delta_tables;
----
0

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name <> 'openivm_delta_tables'
  AND (starts_with(table_name, 'openivm_data_') OR starts_with(table_name, 'openivm_delta_')
       OR starts_with(table_name, 'openivm_visible_'));
----
0

statement ok
INSERT INTO control.openivm.openivm_views (view_name, view_sql_name, view_catalog, view_schema, sql_string, type)
VALUES ('__openivm_orphan', 'orphan_mv', 'openivm_metadata_host', 'main', 'SELECT 1 AS one', 2);

statement ok
DROP VIEW IF EXISTS orphan_mv;

query I
SELECT count(*) FROM control.openivm.openivm_views;
----
0

# The base table no longer has dependents and drops normally.
statement ok
DROP TABLE orders;

statement ok
SET openivm_metadata_catalog = '';

statement ok
SET openivm_metadata_schema = 'main';
