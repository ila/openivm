# ==========================================

statement ok
INSERT INTO orders VALUES (24, 'a', 24), (25, 'x', 25);

statement ok
DELETE FROM orders WHERE id = 22;

restart

statement ok
ATTACH '__TEST_DIR__/openivm_metadata_control.db' AS control;

query II
SELECT current_setting('openivm_metadata_catalog'), current_setting('openivm_metadata_schema');
----
(empty)	main

statement ok
UPDATE orders SET amount = amount - 1 WHERE product = 'x';

statement ok
PRAGMA refresh('product_sales');

query I
SELECT (SELECT count(*) FROM (SELECT * FROM product_sales
                              EXCEPT ALL SELECT product, SUM(amount), COUNT(*) FROM orders GROUP BY product))
     + (SELECT count(*) FROM (SELECT product, SUM(amount), COUNT(*) FROM orders GROUP BY product
                              EXCEPT ALL SELECT * FROM product_sales));
