    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f ON f.ckey = s.ckey
    EXCEPT ALL
    SELECT * FROM ljpa_mh
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM ljpa_mh
    EXCEPT ALL
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f ON f.ckey = s.ckey
);
----
