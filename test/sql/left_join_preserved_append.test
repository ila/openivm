# name: test/sql/left_join_preserved_append.test
# description: LEFT JOIN SIMPLE_PROJECTION preserved-side insert-only append fast path
# group: [sql]

require openivm

statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
CREATE TABLE ljpa_sec(sym VARCHAR, ckey INT);

statement ok
CREATE TABLE ljpa_daily(sym VARCHAR, px INT);

statement ok
CREATE TABLE ljpa_fin(ckey INT, val INT);

statement ok
INSERT INTO ljpa_sec VALUES ('A', 10), ('B', 20), ('C', 30);

statement ok
INSERT INTO ljpa_fin VALUES (10, 1), (10, 2), (20, 5);

statement ok
INSERT INTO ljpa_daily VALUES ('A', 100), ('B', 200), ('C', 300);

statement ok
CREATE MATERIALIZED VIEW ljpa_mh AS
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey);

query I
SELECT contains(lineage_json, '"k":"left_join_key_source"')
       AND contains(lineage_json, '"table":"ljpa_sec"')
       AND contains(lineage_json, '"column":"ckey"')
FROM openivm_views WHERE view_name = 'ljpa_mh';
----
1

statement ok
INSERT INTO ljpa_daily VALUES ('A', 101), ('B', 201), ('C', 301);

statement ok
PRAGMA refresh('ljpa_mh');

query I
SELECT contains(content, 'generate_series') AND NOT contains(content, 'openivm_affected')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_ljpa_mh.sql');
----
1

query I
SELECT COUNT(*) FROM (
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
    EXCEPT ALL
    SELECT * FROM ljpa_mh
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM ljpa_mh
    EXCEPT ALL
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
);
----
0

statement ok
INSERT INTO ljpa_fin VALUES (20, 6);

# The same lineage-guided shape must survive Spark portability rewriting.
query I
SELECT contains(lower(string_agg(sql, ' ' ORDER BY stmt_order)),
                'openivm_lj_src inner join openivm_affected')
       AND contains(lower(string_agg(sql, ' ' ORDER BY stmt_order)),
                    'select distinct openivm_left_key')
       AND contains(string_agg(sql, ' ' ORDER BY stmt_order), '<=>')
FROM openivm_compile_with_facts(
    'ljpa_mh',
    '{"target_dialect":"spark","compile_only":true}'
)
WHERE stmt_kind = 'data';
----
1

statement ok
PRAGMA refresh('ljpa_mh');

query I
SELECT contains(content, 'DELETE FROM openivm_data_ljpa_mh')
       AND contains(content, 'SELECT DISTINCT openivm_left_key')
       AND contains(content, 'openivm_lj_src INNER JOIN openivm_affected')
       AND NOT contains(content, 'generate_series')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_ljpa_mh.sql');
----
1

query I
SELECT COUNT(*) FROM (
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
    EXCEPT ALL
    SELECT * FROM ljpa_mh
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM ljpa_mh
    EXCEPT ALL
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
);
----
0

# Consolidate conflicting nullable-side DML in one refresh. The affected-key
# source pushdown must preserve the complete bag, not merely row existence.
statement ok
INSERT INTO ljpa_fin VALUES (30, 7), (10, 3);

statement ok
UPDATE ljpa_fin SET val = 8 WHERE ckey = 20 AND val = 5;

statement ok
DELETE FROM ljpa_fin WHERE ckey = 10 AND val = 1;

statement ok
PRAGMA refresh('ljpa_mh');

query I
SELECT COUNT(*) FROM (
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
    EXCEPT ALL
    SELECT * FROM ljpa_mh
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM ljpa_mh
    EXCEPT ALL
    SELECT s.ckey, d.sym, d.px
    FROM ljpa_daily d
    JOIN ljpa_sec s ON d.sym = s.sym
    LEFT JOIN ljpa_fin f USING (ckey)
);
----
