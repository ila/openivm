statement ok
CREATE TABLE ljpa2_sec(sym VARCHAR, ckey INT);

statement ok
CREATE TABLE ljpa2_daily(sym VARCHAR, px INT);

statement ok
CREATE TABLE ljpa2_fin(ckey INT, val INT);

statement ok
INSERT INTO ljpa2_sec VALUES ('A', 10), ('B', 20);

statement ok
INSERT INTO ljpa2_fin VALUES (10, 1), (10, 2), (20, 5);

statement ok
INSERT INTO ljpa2_daily VALUES ('A', 100), ('B', 200);

statement ok
CREATE MATERIALIZED VIEW ljpa2_mh AS
    SELECT s.ckey, d.sym, d.px
    FROM ljpa2_daily d
    JOIN ljpa2_sec s ON d.sym = s.sym
    LEFT JOIN (SELECT ckey FROM ljpa2_fin) f ON f.ckey = s.ckey;

statement ok
INSERT INTO ljpa2_daily VALUES ('A', 101);

statement ok
PRAGMA refresh('ljpa2_mh');

query I
SELECT contains(content, 'generate_series') AND NOT contains(content, 'openivm_affected')
FROM read_text('__TEST_DIR__/openivm_upsert_queries_ljpa2_mh.sql');
