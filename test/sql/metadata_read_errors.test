# name: test/sql/metadata_read_errors.test
# description: A failing openivm_views metadata read must surface as an error, not change the refresh strategy
# group: [openivm]

require openivm

statement ok
CREATE TABLE s(k INT, v INT);

statement ok
INSERT INTO s VALUES (1,10),(1,20);

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT k, MIN(v) AS lo FROM s GROUP BY k;

# NULL columns keep their defaults (refresh_interval -> none, group_recompute_affected_mode -> current diff)
statement ok
CREATE TABLE s2(k INT, v INT);

statement ok
INSERT INTO s2 VALUES (1,1);

statement ok
CREATE MATERIALIZED VIEW mv2 AS SELECT k, SUM(v) AS sv FROM s2 GROUP BY k;

statement ok
INSERT INTO s2 VALUES (1,2);

statement ok
PRAGMA refresh('mv2');

query II
SELECT * FROM mv2;
----
1	3

statement ok
DELETE FROM s WHERE v = 10;

# Catalog error: a missing metadata table must not be treated as "no such view"
statement ok
ALTER TABLE openivm_views RENAME TO openivm_views_gone;

statement error
PRAGMA refresh('mv');
----
openivm_views

statement ok
ALTER TABLE openivm_views_gone RENAME TO openivm_views;

# Error reading catalog_type from the delta metadata must surface
statement ok
ALTER TABLE openivm_delta_tables DROP COLUMN catalog_type;

statement error
PRAGMA refresh('mv');
----
catalog_type

statement ok
ALTER TABLE openivm_delta_tables ADD COLUMN catalog_type VARCHAR;

# Error reading last_snapshot_id must surface
statement ok
ALTER TABLE openivm_delta_tables DROP COLUMN last_snapshot_id;

statement error
PRAGMA refresh('mv');
----
last_snapshot_id

statement ok
ALTER TABLE openivm_delta_tables ADD COLUMN last_snapshot_id BIGINT;

# Error reading the delta watermark must surface instead of looking like "no watermark"
statement ok
ALTER TABLE openivm_delta_tables DROP COLUMN last_update;

statement error
PRAGMA refresh('mv');
----
last_update

statement ok
ALTER TABLE openivm_delta_tables ADD COLUMN last_update TIMESTAMP;

# Error reading the source location must surface instead of falling back to defaults
statement ok
ALTER TABLE openivm_delta_tables DROP COLUMN source_catalog;

statement error
PRAGMA refresh('mv');
----
source_catalog

statement ok
ALTER TABLE openivm_delta_tables ADD COLUMN source_catalog VARCHAR;

# A missing has_minmax column must fail the refresh instead of disabling MIN/MAX handling
statement ok
ALTER TABLE openivm_views DROP COLUMN has_minmax;

statement error
PRAGMA refresh('mv');
----
has_minmax
